import sifuture.GameControls
import sifuture.GameView
import sifuture.game.*
import kof.ui.*

prepareEncounter(Game game) {
    game.start(922)
    game.stageSteps = 840
    game.subchief.phase = SubchiefPhase.Normal
    game.subchief.x = 120
    game.subchief.y = 100
    game.subchief.endX = 147
    game.subchief.endY = 100
    game.ship.phase = ShipPhase.Normal
    game.ship.y = 200
    for (var meteor in game.meteors) { meteor.x = 10000; meteor.y = -100 }
    for (var item in game.items) { item.x = 10000 }
}

prepareBoundary(Game game, Int lifetime, Int weapon) {
    prepareEncounter(game)
    game.subchief.lives = 1
    game.subchief.lifeTime = lifetime
    game.subchief.normalSteps = 35
    game.ship.y = 100
    if (weapon == 0) { game.ship.x = 100 }
    if (weapon == 1) {
        game.weapons.lasers.shots[0].fire(0, 100)
        game.weapons.lasers.shots[0].x = 86
    }
    if (weapon == 2) { game.weapons.blaster.fire(game.ship); game.weapons.blaster.x = 60 }
    if (weapon == 3) {
        game.ship.y = 200
        for (var beam in game.weapons.beams) { beam.active = true; beam.x = 0; beam.y = 100 }
    }
}

main() {
    var game = Game()
    game.start(920)
    game.ship.lives = 100
    for (var i = 0; i < 829; i++) { game.step() }
    var canvas = Canvas(176, 220)
    var drawing = GameView(canvas)
    var controls = GameControls(game, drawing, canvas)
    var status = Label("")
    status.setId("subchief-status")
    var repaint = Button("Repaint", () -> { drawing.render(game) })
    var encounter = Button("Encounter", () -> {
        prepareEncounter(game)
        refresh(game, drawing, controls, status)
    })
    var shoot = Button("Shots", () -> {
        prepareEncounter(game)
        game.subchief.x = 165
        game.subchief.endX = 165
        game.subchief.normalSteps = 11
        refresh(game, drawing, controls, status)
    })
    var special = Button("Prepare special", () -> {
        prepareEncounter(game)
        game.ship.y = 106
        game.weapons.level = 3
        game.weapons.charges = 2
        refresh(game, drawing, controls, status)
    })
    var fatal = Button("Fatal laser", () -> {
        prepareEncounter(game)
        game.subchief.lives = 1
        game.weapons.lasers.shots[0].fire(0, 100)
        game.weapons.lasers.shots[0].x = 86
        refresh(game, drawing, controls, status)
    })
    var body = Button("Body contact", () -> {
        prepareEncounter(game)
        game.ship.x = 100
        game.ship.y = 100
        refresh(game, drawing, controls, status)
    })
    var restart = Button("Invulnerable contact", () -> {
        prepareEncounter(game)
        game.ship.x = 100
        game.ship.y = 100
        game.ship.phase = ShipPhase.Restart
        refresh(game, drawing, controls, status)
    })
    var defeat = Button("Defeat encounter", () -> {
        prepareEncounter(game)
        game.subchief.lives = 1
        game.ship.lives = 1
        game.ship.explode()
        game.ship.explosionSteps = 29
        game.score = 17
        refresh(game, drawing, controls, status)
    })
    var complete = Button("Complete journey", () -> {
        game.start(902)
        game.ship.lives = 1000
        for (var i = 0; i < 30000 && game.screen == Screen.Play; i++) { game.step() }
        refresh(game, drawing, controls, status)
    })
    var boundary30body = Button("Boundary 30 body", () -> {
        prepareBoundary(game, 30, 0)
        refresh(game, drawing, controls, status)
    })
    var boundary30laser = Button("Boundary 30 laser", () -> {
        prepareBoundary(game, 30, 1)
        refresh(game, drawing, controls, status)
    })
    var boundary30blaster = Button("Boundary 30 blaster", () -> {
        prepareBoundary(game, 30, 2)
        refresh(game, drawing, controls, status)
    })
    var boundary30special = Button("Boundary 30 special", () -> {
        prepareBoundary(game, 30, 3)
        refresh(game, drawing, controls, status)
    })
    var boundary60body = Button("Boundary 60 body", () -> {
        prepareBoundary(game, 60, 0)
        refresh(game, drawing, controls, status)
    })
    var boundary60laser = Button("Boundary 60 laser", () -> {
        prepareBoundary(game, 60, 1)
        refresh(game, drawing, controls, status)
    })
    var boundary60blaster = Button("Boundary 60 blaster", () -> {
        prepareBoundary(game, 60, 2)
        refresh(game, drawing, controls, status)
    })
    var boundary60special = Button("Boundary 60 special", () -> {
        prepareBoundary(game, 60, 3)
        refresh(game, drawing, controls, status)
    })
    var newShot = Button("New shot boundary", () -> {
        prepareEncounter(game)
        game.ship.x = 40
        game.ship.y = 100
        game.subchief.x = 101
        game.subchief.endX = 101
        game.subchief.normalSteps = 11
        refresh(game, drawing, controls, status)
    })
    var existingShot = Button("Existing shot boundary", () -> {
        prepareEncounter(game)
        game.ship.y = 100
        game.subchief.shots[0].active = true
        game.subchief.shots[0].x = 51
        game.subchief.shots[0].y = 113
        refresh(game, drawing, controls, status)
    })
    var reuseShot = Button("Reuse shot slot", () -> {
        prepareEncounter(game)
        game.ship.x = 40
        game.ship.y = 100
        game.subchief.x = 101
        game.subchief.endX = 101
        game.subchief.normalSteps = 11
        for (var shot in game.subchief.shots) { shot.active = true; shot.y = 113 }
        game.subchief.shots[0].x = 40
        game.subchief.shots[1].x = 150
        game.subchief.shots[2].x = 160
        refresh(game, drawing, controls, status)
    })
    var exhausted = Button("Exhausted special", () -> {
        prepareEncounter(game)
        game.subchief.endX = 120
        for (var beam in game.weapons.beams) { beam.active = true; beam.x = 0; beam.y = 100 + beam.color * 10 }
        game.weapons.beams[0].lives = 1
        refresh(game, drawing, controls, status)
    })
    var stopContacts = Button("Stop special contacts", () -> {
        game.subchief.x = 1000
        game.subchief.endX = 1000
        game.weapons.beams[1].active = false
        game.weapons.beams[2].active = false
        refresh(game, drawing, controls, status)
    })
    var window = Window("SiFuture subchefe")
    window.size(296, 900)
    window.bind(Column(listOf(controls.root, status, repaint, encounter, shoot, special, fatal, body, restart, defeat, complete, boundary30body, boundary30laser, boundary30blaster, boundary30special, boundary60body, boundary60laser, boundary60blaster, boundary60special, newShot, existingShot, reuseShot, exhausted, stopContacts)))
    window.show()
    refresh(game, drawing, controls, status)
    time.interval(Rules.STEP_MS, () -> { game.step(); refresh(game, drawing, controls, status) })
}

refresh(Game game, GameView drawing, GameControls controls, Label status) {
    drawing.render(game)
    controls.update()
    var normal = 0
    var explosion = 0
    var shipNormal = 0
    var shipExplosion = 0
    var result = 0
    if (game.subchief.phase == SubchiefPhase.Normal) { normal = 1 }
    if (game.subchief.phase == SubchiefPhase.Explosion) { explosion = 1 }
    if (game.ship.phase == ShipPhase.Normal) { shipNormal = 1 }
    if (game.ship.phase == ShipPhase.Explosion) { shipExplosion = 1 }
    if (game.screen == Screen.Result) { result = 1 }
    var orangeActive = 0
    if (game.weapons.beams[0].active) { orangeActive = 1 }
    var shots = 0
    for (var shot in game.subchief.shots) { if (shot.active) { shots = shots + 1 } }
    status.text = "steps:" + game.steps + ":position:" + game.stagePosition() + ":normal:" + normal + ":explosion:" + explosion + ":x:" + game.subchief.x + ":y:" + game.subchief.y + ":hp:" + game.subchief.lives + ":lifetime:" + game.subchief.lifeTime + ":clock:" + game.subchief.normalSteps + ":frame:" + game.subchief.explosionSteps / 3 + ":explosionX:" + game.subchief.explosionX + ":shots:" + shots + ":shotX:" + game.subchief.shots[0].x + ":shotY:" + game.subchief.shots[0].y + ":score:" + game.score + ":displayed:" + game.displayedScore + ":lives:" + game.ship.lives + ":shipNormal:" + shipNormal + ":shipExplosion:" + shipExplosion + ":result:" + result + ":charges:" + game.weapons.charges + ":blueLives:" + game.weapons.beams[1].lives + ":blueX:" + game.weapons.beams[1].x + ":orangeActive:" + orangeActive + ":orangeLives:" + game.weapons.beams[0].lives + ":orangeDeath:" + game.weapons.beams[0].deathSteps + ":orangeMarker:" + game.weapons.beams[0].contactSteps + ":orangeX:" + game.weapons.beams[0].x + ":darkX:" + game.weapons.beams[2].x + ":shot1X:" + game.subchief.shots[1].x + ":shot2X:" + game.subchief.shots[2].x
}
