import sifuture.GameControls
import sifuture.GameView
import sifuture.game.*
import kof.ui.*

prepareEncounter(Game game) {
    game.start(922)
    game.stageSteps = 840
    game.subchief.phase = SubchiefPhase.Normal
    game.subchief.x = 120
    game.subchief.y = 100
    game.subchief.endX = 147
    game.subchief.endY = 100
    game.ship.phase = ShipPhase.Normal
    game.ship.y = 200
    for (var meteor in game.meteors) { meteor.x = 10000; meteor.y = -100 }
    for (var item in game.items) { item.x = 10000 }
}

prepareBoundary(Game game, Int lifetime) {
    prepareEncounter(game)
    game.subchief.lives = 1
    game.subchief.lifeTime = lifetime
    game.subchief.normalSteps = 35
    game.ship.y = 100
}

prepareBoundaryBody(Game game, Int lifetime) {
    prepareBoundary(game, lifetime)
    game.ship.x = 100
}

prepareBoundaryLaser(Game game, Int lifetime) {
    prepareBoundary(game, lifetime)
    game.weapons.lasers.shots[0].fire(0, 100)
    game.weapons.lasers.shots[0].x = 86
}

prepareBoundaryBlaster(Game game, Int lifetime) {
    prepareBoundary(game, lifetime)
    game.weapons.blaster.fire(game.ship)
    game.weapons.blaster.x = 60
}

prepareBoundarySpecial(Game game, Int lifetime) {
    prepareBoundary(game, lifetime)
    game.ship.y = 200
    for (var beam in game.weapons.beams) { beam.active = true; beam.x = 0; beam.y = 100 }
}

main() {
    var game = Game()
    prepareApproach(game)
    var canvas = Canvas(176, 220)
    var drawing = GameView(canvas)
    var controls = GameControls(game, drawing, canvas)
    var status = Label("")
    status.setId("subchief-status")
    var window = Window("SiFuture subchefe")
    window.size(296, 900)
    window.bind(Column(widgets(game, drawing, controls, status)))
    window.show()
    refresh(game, drawing, controls, status)
    time.interval(Rules.STEP_MS, () -> { game.step(); refresh(game, drawing, controls, status) })
}

prepareApproach(Game game) {
    game.start(920)
    game.ship.lives = 100
    for (var i = 0; i < 829; i++) { game.step() }
}

widgets(Game game, GameView drawing, GameControls controls, Label status): List<Component> {
    var items = listOf<Component>(controls.root, status)
    for (var button in encounterButtons(game, drawing, controls, status)) { items.add(button) }
    for (var button in boundaryButtons(game, drawing, controls, status)) { items.add(button) }
    for (var button in shotButtons(game, drawing, controls, status)) { items.add(button) }
    return items
}

encounterButtons(Game game, GameView drawing, GameControls controls, Label status): List<Button> {
    return listOf(
        Button("Repaint", () -> { drawing.render(game) }),
        Button("Encounter", () -> { prepareEncounter(game); refresh(game, drawing, controls, status) }),
        Button("Shots", () -> { prepareShots(game); refresh(game, drawing, controls, status) }),
        Button("Prepare special", () -> { prepareSpecial(game); refresh(game, drawing, controls, status) }),
        Button("Fatal laser", () -> { prepareFatalLaser(game); refresh(game, drawing, controls, status) }),
        Button("Body contact", () -> { prepareBodyContact(game); refresh(game, drawing, controls, status) }),
        Button("Invulnerable contact", () -> { prepareInvulnerableContact(game); refresh(game, drawing, controls, status) }),
        Button("Defeat encounter", () -> { prepareDefeatEncounter(game); refresh(game, drawing, controls, status) }),
        Button("Complete journey", () -> { prepareCompleteJourney(game); refresh(game, drawing, controls, status) }))
}

boundaryButtons(Game game, GameView drawing, GameControls controls, Label status): List<Button> {
    return listOf(
        Button("Boundary 30 body", () -> { prepareBoundaryBody(game, 30); refresh(game, drawing, controls, status) }),
        Button("Boundary 30 laser", () -> { prepareBoundaryLaser(game, 30); refresh(game, drawing, controls, status) }),
        Button("Boundary 30 blaster", () -> { prepareBoundaryBlaster(game, 30); refresh(game, drawing, controls, status) }),
        Button("Boundary 30 special", () -> { prepareBoundarySpecial(game, 30); refresh(game, drawing, controls, status) }),
        Button("Boundary 60 body", () -> { prepareBoundaryBody(game, 60); refresh(game, drawing, controls, status) }),
        Button("Boundary 60 laser", () -> { prepareBoundaryLaser(game, 60); refresh(game, drawing, controls, status) }),
        Button("Boundary 60 blaster", () -> { prepareBoundaryBlaster(game, 60); refresh(game, drawing, controls, status) }),
        Button("Boundary 60 special", () -> { prepareBoundarySpecial(game, 60); refresh(game, drawing, controls, status) }))
}

shotButtons(Game game, GameView drawing, GameControls controls, Label status): List<Button> {
    return listOf(
        Button("New shot boundary", () -> { prepareNewShotBoundary(game); refresh(game, drawing, controls, status) }),
        Button("Existing shot boundary", () -> { prepareExistingShotBoundary(game); refresh(game, drawing, controls, status) }),
        Button("Reuse shot slot", () -> { prepareReusedShotSlot(game); refresh(game, drawing, controls, status) }),
        Button("Exhausted special", () -> { prepareExhaustedSpecial(game); refresh(game, drawing, controls, status) }),
        Button("Stop special contacts", () -> { stopSpecialContacts(game); refresh(game, drawing, controls, status) }))
}

prepareShots(Game game) {
    prepareEncounter(game)
    game.subchief.x = 165
    game.subchief.endX = 165
    game.subchief.normalSteps = 11
}

prepareSpecial(Game game) {
    prepareEncounter(game)
    game.ship.y = 106
    game.weapons.level = 3
    game.weapons.charges = 2
}

prepareFatalLaser(Game game) {
    prepareEncounter(game)
    game.subchief.lives = 1
    game.weapons.lasers.shots[0].fire(0, 100)
    game.weapons.lasers.shots[0].x = 86
}

prepareBodyContact(Game game) {
    prepareEncounter(game)
    game.ship.x = 100
    game.ship.y = 100
}

prepareInvulnerableContact(Game game) {
    prepareBodyContact(game)
    game.ship.phase = ShipPhase.Restart
}

prepareDefeatEncounter(Game game) {
    prepareEncounter(game)
    game.subchief.lives = 1
    game.ship.lives = 1
    game.ship.explode()
    game.ship.explosionSteps = 29
    game.score = 17
}

prepareCompleteJourney(Game game) {
    game.start(902)
    game.ship.lives = 1000
    for (var i = 0; i < 30000 && game.screen == Screen.Play; i++) { game.step() }
}

prepareNewShotBoundary(Game game) {
    prepareEncounter(game)
    game.ship.x = 40
    game.ship.y = 100
    game.subchief.x = 101
    game.subchief.endX = 101
    game.subchief.normalSteps = 11
}

prepareExistingShotBoundary(Game game) {
    prepareEncounter(game)
    game.ship.y = 100
    game.subchief.shots[0].active = true
    game.subchief.shots[0].x = 51
    game.subchief.shots[0].y = 113
}

prepareReusedShotSlot(Game game) {
    prepareNewShotBoundary(game)
    for (var shot in game.subchief.shots) { shot.active = true; shot.y = 113 }
    game.subchief.shots[0].x = 40
    game.subchief.shots[1].x = 150
    game.subchief.shots[2].x = 160
}

prepareExhaustedSpecial(Game game) {
    prepareEncounter(game)
    game.subchief.endX = 120
    for (var beam in game.weapons.beams) { beam.active = true; beam.x = 0; beam.y = 100 + beam.color * 10 }
    game.weapons.beams[0].lives = 1
}

stopSpecialContacts(Game game) {
    game.subchief.x = 1000
    game.subchief.endX = 1000
    game.weapons.beams[1].active = false
    game.weapons.beams[2].active = false
}

refresh(Game game, GameView drawing, GameControls controls, Label status) {
    drawing.render(game)
    controls.update()
    status.text = statusText(game)
}

statusText(Game game): String {
    return "steps:" + game.steps + ":position:" + game.stagePosition() + ":normal:" + flag(game.subchief.phase == SubchiefPhase.Normal) + ":explosion:" + flag(game.subchief.phase == SubchiefPhase.Explosion) + ":x:" + game.subchief.x + ":y:" + game.subchief.y + ":hp:" + game.subchief.lives + ":lifetime:" + game.subchief.lifeTime + ":clock:" + game.subchief.normalSteps + ":frame:" + game.subchief.explosionSteps / 3 + ":explosionX:" + game.subchief.explosionX + ":shots:" + activeShots(game) + ":shotX:" + game.subchief.shots[0].x + ":shotY:" + game.subchief.shots[0].y + ":score:" + game.score + ":displayed:" + game.displayedScore + ":lives:" + game.ship.lives + ":shipNormal:" + flag(game.ship.phase == ShipPhase.Normal) + ":shipExplosion:" + flag(game.ship.phase == ShipPhase.Explosion) + ":result:" + flag(game.screen == Screen.Result) + ":charges:" + game.weapons.charges + ":blueLives:" + game.weapons.beams[1].lives + ":blueX:" + game.weapons.beams[1].x + ":orangeActive:" + flag(game.weapons.beams[0].active) + ":orangeLives:" + game.weapons.beams[0].lives + ":orangeDeath:" + game.weapons.beams[0].deathSteps + ":orangeMarker:" + game.weapons.beams[0].contactSteps + ":orangeX:" + game.weapons.beams[0].x + ":darkX:" + game.weapons.beams[2].x + ":shot1X:" + game.subchief.shots[1].x + ":shot2X:" + game.subchief.shots[2].x
}

activeShots(Game game): Int {
    var shots = 0
    for (var shot in game.subchief.shots) { if (shot.active) { shots = shots + 1 } }
    return shots
}

flag(Bool value): Int {
    if (value) { return 1 }
    return 0
}
