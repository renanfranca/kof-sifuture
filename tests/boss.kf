import sifuture.GameControls
import sifuture.GameView
import sifuture.game.*
import kof.ui.*

prepareBoss(Game game) {
    game.start(943)
    game.stageSteps = 1420
    game.boss.phase = BossPhase.Normal
    game.boss.x = 120
    game.boss.y = 100
    game.boss.endX = 135
    game.boss.endY = 110
    game.ship.phase = ShipPhase.Normal
    game.ship.y = 200
    for (var meteor in game.meteors) { meteor.x = 10000; meteor.y = -100 }
    for (var item in game.items) { item.x = 10000 }
}

prepareLaser(Game game) {
    game.weapons.lasers.shots[0].fire(0, 100)
    game.weapons.lasers.shots[0].x = 86
}

refresh(Game game, GameView drawing, GameControls controls, Label status) {
    drawing.render(game)
    controls.update()
    status.text = statusText(game)
}

statusText(Game game): String {
    var b = game.boss
    return "position:" + game.stagePosition() + ":steps:" + game.steps + ":phase:" + phaseCode(b.phase) + ":x:" + b.x + ":y:" + b.y + ":hp:" + b.lives + ":level:" + b.weapons.level + ":clock:" + b.weapons.fireSteps + ":lifetime:" + b.lifeTime + ":normalSteps:" + b.normalSteps + ":explosionSteps:" + b.explosionSteps + ":explosionFrame:" + b.explosionFrame() + ":explosionX:" + b.explosionX + ":explosionY:" + b.explosionY + ":sprite:" + b.spriteFrame() + ":shots:" + activeBossShots(b) + ":shotX:" + b.weapons.shots[0].x + ":shotY:" + b.weapons.shots[0].y + ":shotFrame:" + b.weapons.shots[0].spriteFrame() + ":special:" + flag(b.weapons.special.active) + ":specialX:" + b.weapons.special.x + ":specialY:" + b.weapons.special.y + ":specialFrame:" + b.weapons.special.frame() + ":score:" + game.score + ":displayed:" + game.displayedScore + ":lives:" + game.ship.lives + ":shipExplosion:" + flag(game.ship.phase == ShipPhase.Explosion) + ":result:" + flag(game.screen == Screen.Result) + ":playerShots:" + activePlayerShots(game) + ":charges:" + game.weapons.charges + ":meteorHit:" + flag(game.meteors[0].collided && game.meteors[1].collided) + ":meteorX:" + game.meteors[0].x
}

phaseCode(BossPhase phase): Int {
    if (phase == BossPhase.Normal) { return 1 }
    if (phase == BossPhase.Fury) { return 2 }
    if (phase == BossPhase.Frenzy) { return 3 }
    if (phase == BossPhase.Explosion) { return 4 }
    return 0
}

activeBossShots(Boss b): Int {
    var shots = 0
    for (var shot in b.weapons.shots) { if (shot.active) { shots = shots + 1 } }
    return shots
}

activePlayerShots(Game game): Int {
    var playerShots = 0
    for (var shot in game.weapons.lasers.shots) { if (shot.active) { playerShots = playerShots + 1 } }
    if (game.weapons.blaster.active) { playerShots = playerShots + 1 }
    for (var beam in game.weapons.beams) { if (beam.active) { playerShots = playerShots + 1 } }
    return playerShots
}

flag(Bool value): Int {
    if (value) { return 1 }
    return 0
}

main() {
    var game = Game()
    prepareApproach(game)
    var canvas = Canvas(176, 220)
    var drawing = GameView(canvas)
    var controls = GameControls(game, drawing, canvas)
    var status = Label("")
    status.setId("boss-status")
    var window = Window("SiFuture boss")
    window.size(296, 1000)
    window.bind(Column(widgets(game, drawing, controls, status)))
    window.show()
    refresh(game, drawing, controls, status)
    time.interval(Rules.STEP_MS, () -> { game.step(); refresh(game, drawing, controls, status) })
}

prepareApproach(Game game) {
    prepareBoss(game)
    game.boss.phase = BossPhase.Inactive
    game.stageSteps = 1409
}

widgets(Game game, GameView drawing, GameControls controls, Label status): List<Component> {
    var items = listOf<Component>(controls.root, status)
    for (var button in phaseButtons(game, drawing, controls, status)) { items.add(button) }
    for (var button in contactButtons(game, drawing, controls, status)) { items.add(button) }
    for (var button in shotButtons(game, drawing, controls, status)) { items.add(button) }
    return items
}

phaseButtons(Game game, GameView drawing, GameControls controls, Label status): List<Button> {
    return listOf(
        Button("Repaint", () -> { drawing.render(game) }),
        Button("Encounter", () -> { prepareBoss(game); refresh(game, drawing, controls, status) }),
        Button("Fury", () -> { prepareFury(game); refresh(game, drawing, controls, status) }),
        Button("Frenzy", () -> { prepareFrenzy(game); refresh(game, drawing, controls, status) }),
        Button("Shots", () -> { prepareShots(game); refresh(game, drawing, controls, status) }),
        Button("Boss special", () -> { prepareBossSpecial(game); refresh(game, drawing, controls, status) }),
        Button("Fatal laser", () -> { prepareFatalLaser(game); refresh(game, drawing, controls, status) }))
}

contactButtons(Game game, GameView drawing, GameControls controls, Label status): List<Button> {
    return listOf(
        Button("Body contact", () -> { prepareBodyContact(game); refresh(game, drawing, controls, status) }),
        Button("Invulnerable contact", () -> { prepareInvulnerableContact(game); refresh(game, drawing, controls, status) }),
        Button("Player special", () -> { preparePlayerSpecial(game); refresh(game, drawing, controls, status) }),
        Button("Defeat", () -> { prepareDefeat(game); refresh(game, drawing, controls, status) }),
        Button("Complete journey", () -> { prepareCompleteJourney(game); refresh(game, drawing, controls, status) }))
}

shotButtons(Game game, GameView drawing, GameControls controls, Label status): List<Button> {
    return listOf(
        Button("New shot", () -> { prepareNewShot(game); refresh(game, drawing, controls, status) }),
        Button("Moving shot", () -> { prepareMovingShot(game); refresh(game, drawing, controls, status) }),
        Button("Reused shot", () -> { prepareReusedShot(game); refresh(game, drawing, controls, status) }),
        Button("Special boundary", () -> { prepareSpecialBoundary(game); refresh(game, drawing, controls, status) }),
        Button("Absorbed meteors", () -> { prepareAbsorbedMeteors(game); refresh(game, drawing, controls, status) }))
}

prepareFury(Game game) {
    prepareBoss(game)
    game.boss.lives = 45
    game.boss.weapons.level = 2
    prepareLaser(game)
}

prepareFrenzy(Game game) {
    prepareBoss(game)
    game.boss.lives = 20
    game.boss.weapons.level = 3
    prepareLaser(game)
}

prepareShots(Game game) {
    prepareBoss(game)
    game.boss.x = 165
    game.boss.endX = 165
    game.boss.endY = 10000
    game.boss.weapons.level = 1
    game.boss.weapons.evolve()
    game.boss.weapons.level = 1
    game.boss.weapons.fireSteps = 30
}

prepareBossSpecial(Game game) {
    prepareBoss(game)
    game.boss.weapons.level = 2
    game.boss.weapons.specialReady = true
    game.boss.weapons.fireSteps = 11
}

prepareFatalLaser(Game game) {
    prepareBoss(game)
    game.boss.lives = 1
    game.boss.lifeTime = 30
    game.boss.normalSteps = 35
    game.boss.weapons.fireSteps = 12
    prepareLaser(game)
}

prepareBodyContact(Game game) {
    prepareBoss(game)
    game.ship.x = 70
    game.ship.y = 100
    game.boss.lives = 80
}

prepareInvulnerableContact(Game game) {
    prepareBoss(game)
    game.ship.x = 70
    game.ship.y = 100
    game.ship.phase = ShipPhase.Restart
}

preparePlayerSpecial(Game game) {
    prepareBoss(game)
    game.ship.y = 130
    game.weapons.level = 3
    game.weapons.charges = 2
}

prepareDefeat(Game game) {
    prepareBoss(game)
    game.boss.lives = 1
    game.ship.lives = 1
    game.ship.explode()
    game.ship.explosionSteps = 29
    game.score = 17
    game.weapons.level = 3
    game.weapons.fireSteps = 12
    game.weapons.lasers.shots[0].fire(0, 100)
}

prepareCompleteJourney(Game game) {
    game.start(909)
    game.ship.lives = 1000
    for (var i = 0; i < 30000 && game.screen == Screen.Play; i++) { game.step() }
}

prepareNewShot(Game game) {
    prepareBoss(game)
    game.ship.x = 40
    game.ship.y = 100
    game.boss.x = 91
    game.boss.weapons.fireSteps = 12
}

prepareMovingShot(Game game) {
    prepareBoss(game)
    game.ship.y = 100
    game.boss.x = 400
    game.boss.endX = 400
    game.boss.endY = 10000
    game.boss.weapons.shots[0].fire(61, 100)
}

prepareReusedShot(Game game) {
    prepareBoss(game)
    game.ship.x = 40
    game.ship.y = 100
    game.boss.x = 91
    game.boss.weapons.level = 1
    game.boss.weapons.fireSteps = 30
    game.boss.weapons.shots[0].fire(50, 100)
    game.boss.weapons.shots[1].fire(160, 100)
}

prepareSpecialBoundary(Game game) {
    prepareBoss(game)
    game.ship.y = 100
    game.boss.weapons.special.fire(43, 62)
    game.boss.weapons.special.preparationSteps = 17
}

prepareAbsorbedMeteors(Game game) {
    prepareBoss(game)
    game.ship.phase = ShipPhase.Restart
    game.meteors[0].x = 121
    game.meteors[0].y = 100
    game.meteors[1].x = 161
    game.meteors[1].y = 150
}
