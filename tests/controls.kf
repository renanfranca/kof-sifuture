import sifuture.GameControls
import sifuture.GameView
import sifuture.game.*
import kof.ui.*

main() {
    var game = Game()
    game.start(77)
    game.ship.x = 60
    game.ship.y = 100
    game.ship.phase = ShipPhase.Normal
    for (var meteor in game.meteors) { meteor.y = 30 }

    var canvas = Canvas(Rules.WORLD_WIDTH, Rules.WORLD_HEIGHT)
    var drawing = GameView(canvas)
    var controls = GameControls(game, drawing, canvas)
    var window = Window("SiFuture controles")
    window.size(296, 510)
    window.bind(controls.root)
    window.show()
    drawing.render(game)
    time.interval(Rules.STEP_MS, () -> {
        game.step()
        drawing.render(game)
        controls.update()
    })
}
