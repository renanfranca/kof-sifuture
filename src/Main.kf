import kof.ui.*

class GameView {
    Canvas canvas
    Image title
    Image menu
    Image ship
    Image meteor
    Image laser
    Image result0
    Image result1
    Image result2
    Image result3

    public constructor(Canvas canvas) {
        this.canvas = canvas
        title = Image("assets/sifuture.png")
        menu = Image("assets/menu0.png")
        ship = Image("assets/Middle.png")
        meteor = Image("assets/meteor000.png")
        laser = Image("assets/laser00.png")
        result0 = Image("assets/result0.png")
        result1 = Image("assets/result1.png")
        result2 = Image("assets/result2.png")
        result3 = Image("assets/result3.png")
    }

    render(Game game) {
        canvas.clearRect(0, 0, 176, 220)
        canvas.setFill(Palette.white)
        if (game.screen == 0) {
            canvas.drawImage(title, 11, 30)
            canvas.drawImage(menu, 48, 120)
            canvas.fillText("Enter: Novo Jogo", 42, 174)
            return
        }
        if (game.screen == 2) {
            canvas.fillText("PONTOS: " + game.score, 40, 86)
            if (game.resultIndex() == 0) { canvas.drawImage(result0, 31, 108) }
            if (game.resultIndex() == 1) { canvas.drawImage(result1, 31, 108) }
            if (game.resultIndex() == 2) { canvas.drawImage(result2, 31, 108) }
            if (game.resultIndex() == 3) { canvas.drawImage(result3, 31, 108) }
            canvas.fillText("Enter: menu", 52, 160)
            return
        }
        canvas.fillText("PONTOS " + game.score + "   VIDAS " + game.lives, 4, 18)
        for (var m in game.meteors) {
            canvas.drawImage(meteor, m.x, m.y)
        }
        for (var s in game.shots) {
            if (s.active) { canvas.drawImage(laser, s.x, s.y) }
        }
        if (game.immunity % 2 == 0) { canvas.drawImage(ship, game.shipX, game.shipY) }
    }
}

main() {
    var game = Game()
    var canvas = Canvas(176, 220)
    var view = GameView(canvas)
    var keys = Input("Clique para teclado")
    var hint = Label("Menu: Enter inicia")
    keys.on("keydown", (e: Event) -> {
        game.key(e.key(), true)
        view.render(game)
    })
    keys.on("keyup", (e: Event) -> {
        game.key(e.key(), false)
    })
    keys.on("blur", (e: Event) -> { game.clearInput() })

    var window = Window("SiFuture em Kof")
    window.size(210, 340)
    window.bind(Column(listOf(canvas, keys, hint)))
    window.show()
    view.render(game)
    time.interval(30, () -> {
        game.step()
        view.render(game)
        if (game.screen == 0) { hint.text = "Menu: Enter inicia" }
        if (game.screen == 1) { hint.text = "Setas: mover" }
        if (game.screen == 2) { hint.text = "Resultado: Enter volta" }
    })
}
