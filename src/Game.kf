// Logical coordinates and fixed updates are independent from kof.ui.
class Meteor {
    Int x = 0
    Int y = 0
    Int frame = 0
    Int frameDirection = 1
    Int frameSteps = 0
    Int collisionSteps = 0
    Bool collided = false
}

class Shot {
    Int x = 0
    Int y = 0
    Bool active = false
    Bool impact = false
}

class Game {
    Int screen = 0 // 0 menu, 1 play, 2 result
    Int shipX = 0
    Int shipY = 100
    Int lives = 3
    Int score = 0
    Int steps = 0
    Int shipState = 2 // 0 normal, 1 explosion, 2 restart
    Int restartFrame = 0
    Int explosionSteps = 0
    Int fireSteps = 0
    Bool left = false
    Bool right = false
    Bool up = false
    Bool down = false
    Int lastX = 0
    Int lastY = 0
    Bool shipRightFrame = false
    List<Meteor> meteors = listOf(Meteor(), Meteor(), Meteor(), Meteor(), Meteor(), Meteor())
    List<Shot> shots = listOf(Shot(), Shot(), Shot())

    start(Int seed) {
        rng.seed(seed)
        screen = 1
        shipX = 0
        shipY = 100
        lives = 3
        score = 0
        steps = 0
        shipState = 2
        restartFrame = 0
        explosionSteps = 0
        fireSteps = 0
        shipRightFrame = false
        clearInput()
        for (var m in meteors) { resetMeteor(m) }
        for (var s in shots) { s.active = false; s.impact = false }
    }

    clearInput() {
        left = false
        right = false
        up = false
        down = false
        lastX = 0
        lastY = 0
    }

    key(String name, Bool pressed) {
        if (name == "ArrowLeft") { left = pressed; if (pressed) { lastX = 0 } }
        if (name == "ArrowRight") { right = pressed; if (pressed) { lastX = 1 } }
        if (name == "ArrowUp") { up = pressed; if (pressed) { lastY = 0 } }
        if (name == "ArrowDown") { down = pressed; if (pressed) { lastY = 1 } }
        if (name == "Enter" && pressed) {
            if (screen == 0) { start(random.int(2147483647)) }
            else if (screen == 2) { screen = 0; clearInput() }
        }
    }

    resetMeteor(Meteor m) {
        // Historical horizontal spawn: world width + 0..199.
        m.x = 176 + rng.int(200)
        m.y = 30 + rng.int(172)
        m.frame = 0
        m.frameDirection = 1
        m.frameSteps = 0
        m.collisionSteps = 0
        m.collided = false
    }

    shipHitsMeteor(Meteor m): Bool {
        return m.x >= shipX && m.x <= shipX + 50 &&
            ((m.y >= shipY && m.y <= shipY + 20) ||
             (m.y + 18 >= shipY && m.y + 18 <= shipY + 20))
    }

    laserHitsMeteor(Shot s, Meteor m): Bool {
        return ((s.x + 30 >= m.x && s.x + 30 <= m.x + 20) &&
                (s.y >= m.y && s.y <= m.y + 18)) ||
               ((s.x + 30 >= m.x && s.x <= m.x + 20) &&
                (s.y + 12 >= m.y && s.y + 12 <= m.y + 18))
    }

    step() {
        if (screen != 1) { return }
        steps = steps + 1
        var vulnerable = shipState == 0
        var restarting = shipState == 2
        var exploding = shipState == 1
        if (shipState == 1) {
            explosionSteps = explosionSteps + 1
            if (explosionSteps == 30) {
                lives = lives - 1
                if (lives == 0) {
                    screen = 2
                    clearInput()
                    return
                }
                shipState = 2
                restartFrame = 0
                shipX = 5
                shipY = 100
                shipRightFrame = false
            }
        }
        if (restarting) {
            restartFrame = restartFrame + 1
            if (restartFrame == 45) { shipState = 0; shipRightFrame = false }
        }
        if (!exploding) {
            if (left && (!right || lastX == 0)) { shipX = shipX - 5 }
            if (right && (!left || lastX == 1)) { shipX = shipX + 5 }
            if (up && (!down || lastY == 0)) { shipY = shipY - 5 }
            if (down && (!up || lastY == 1)) { shipY = shipY + 5 }
        }
        if (!exploding && !restarting) {
            shipRightFrame = right && (!left || lastX == 1)
        }
        if (shipX < 0) { shipX = 0 }
        if (shipX > 126) { shipX = 126 }
        if (shipY < 30) { shipY = 30 }
        if (shipY > 200) { shipY = 200 }

        // At the basic laser level the historical counter fires on step 13.
        if (vulnerable) {
            fireSteps = fireSteps + 1
            if (fireSteps == 13) {
                fireSteps = 0
                var shot = shots[0]
                if (!shot.active) {
                    shot.x = shipX + 15
                    shot.y = shipY + 8
                    shot.active = true
                    shot.impact = false
                }
            }
        }

        for (var s in shots) {
            if (s.active) {
                if (s.impact) {
                    s.active = false
                    s.impact = false
                } else {
                    s.x = s.x + 5
                    if (s.x > 176) { s.active = false }
                }
            }
        }
        var shipCanCollide = shipState == 0
        var shipCollision = false
        for (var m in meteors) {
            m.x = m.x - 1
            if (m.x < -25) {
                if (m.collided) {
                    m.x = 176 + rng.int(200)
                    m.y = 30 + rng.int(172)
                } else { resetMeteor(m) }
            }
            if (m.collided) {
                m.collisionSteps = m.collisionSteps + 1
                if (m.collisionSteps == 6) { resetMeteor(m) }
            } else {
                m.frameSteps = m.frameSteps + 1
                if (m.frameSteps == 2) {
                    m.frameSteps = 0
                    m.frame = m.frame + m.frameDirection
                    if (m.frame == 5) { m.frameDirection = -1 }
                    if (m.frame == 0) { m.frameDirection = 1 }
                }
                if (shipCanCollide && shipHitsMeteor(m)) {
                    if (!shipCollision) {
                        score = score + 5
                        shipState = 1
                        explosionSteps = 0
                        shipCollision = true
                    }
                    m.collided = true
                    m.collisionSteps = 0
                }
                if (!m.collided) {
                    for (var s in shots) {
                        if (s.active && !s.impact && laserHitsMeteor(s, m)) {
                            s.x = m.x
                            s.y = m.y
                            s.impact = true
                            score = score + 5
                            m.collided = true
                            m.collisionSteps = 0
                        }
                    }
                }
            }
        }
    }

    resultIndex(): Int {
        if (score < 1500) { return 0 }
        if (score < 2200) { return 1 }
        if (score < 3300) { return 2 }
        return 3
    }
}

test "same seed produces the same meteors" {
    var a = Game()
    a.start(42)
    var x = a.meteors[0].x
    var y = a.meteors[0].y
    a.start(42)
    assert(a.meteors[0].x == x && a.meteors[0].y == y)
}

test "ship moves five units and stops at bounds and release" {
    var g = Game()
    g.start(1)
    g.key("ArrowRight", true)
    g.step()
    assert(g.shipX == 5)
    g.key("ArrowRight", false)
    g.step()
    assert(g.shipX == 5)
    g.shipX = 125
    g.key("ArrowRight", true)
    g.step()
    assert(g.shipX == 126)
    g.shipY = 31
    g.key("ArrowUp", true)
    g.step()
    assert(g.shipY == 30)
}

test "normal fire starts on thirteenth step and earns five points" {
    var g = Game()
    g.start(2)
    g.shipState = 0
    for (var i = 0; i < 12; i++) { g.step() }
    assert(!g.shots[0].active)
    g.step()
    assert(g.shots[0].active)
    g.shipY = 50
    g.meteors[0].x = g.shots[0].x + 4
    g.meteors[0].y = g.shots[0].y
    g.step()
    assert(g.score == 5)
    assert(g.shots[0].active && g.shots[0].impact)
}

test "three meteor hits end the attempt and result persists" {
    var g = Game()
    g.start(3)
    for (var i = 0; i < 3; i++) {
        g.shipState = 0
        g.meteors[0].x = g.shipX + 10
        g.meteors[0].y = g.shipY
        g.step()
        assert(g.shipState == 1 && g.lives == 3 - i)
        for (var j = 0; j < 30; j++) { g.step() }
    }
    assert(g.lives == 0 && g.screen == 2)
    g.step()
    assert(g.screen == 2)
    g.key("Enter", true)
    assert(g.screen == 0)
    g.start(3)
    assert(g.lives == 3 && g.score == 0 && g.steps == 0)
}

test "all result boundaries select a message" {
    var g = Game()
    g.score = 1499
    assert(g.resultIndex() == 0)
    g.score = 1500
    assert(g.resultIndex() == 1)
    g.score = 2199
    assert(g.resultIndex() == 1)
    g.score = 2200
    assert(g.resultIndex() == 2)
    g.score = 3299
    assert(g.resultIndex() == 2)
    g.score = 3300
    assert(g.resultIndex() == 3)
}

test "initial restart is invulnerable for fifteen three-step alternations" {
    var g = Game()
    g.start(11)
    assert(g.shipState == 2 && g.restartFrame == 0)
    for (var i = 0; i < 44; i++) {
        g.meteors[0].x = g.shipX + 10
        g.meteors[0].y = g.shipY
        g.step()
        assert(g.lives == 3 && g.shipState == 2)
    }
    assert(g.restartFrame == 44)
    g.meteors[0].x = 400
    g.step()
    assert(g.shipState == 0 && g.lives == 3)
}

test "restart ends before collision on step forty five but fire waits" {
    var g = Game()
    g.start(71)
    g.restartFrame = 43
    g.fireSteps = 12
    for (var m in g.meteors) { m.x = 400; m.y = 30 }
    g.meteors[0].x = 11
    g.meteors[0].y = 100
    g.step()
    assert(g.shipState == 2 && g.score == 0 && g.fireSteps == 12)
    g.meteors[0].x = 11
    g.step()
    assert(g.shipState == 1 && g.score == 5)
    assert(g.fireSteps == 12 && !g.shots[0].active)
}

test "one ship collision marks every overlapping meteor and scores once" {
    var g = Game()
    g.start(73)
    g.shipState = 0
    for (var m in g.meteors) { m.x = 400; m.y = 30 }
    g.meteors[0].x = 20
    g.meteors[0].y = 100
    g.meteors[1].x = 30
    g.meteors[1].y = 100
    g.step()
    assert(g.shipState == 1 && g.score == 5)
    assert(g.meteors[0].collided && g.meteors[1].collided)
    for (var i = 0; i < 5; i++) { g.step() }
    assert(g.meteors[0].collided && g.meteors[1].collided && g.score == 5)
    g.step()
    assert(!g.meteors[0].collided && !g.meteors[1].collided)
    assert(g.meteors[0].x >= 176 && g.meteors[1].x >= 176 && g.score == 5)
}

test "last pressed opposite direction wins until released" {
    var g = Game()
    g.start(9)
    g.shipX = 60
    g.shipY = 100
    g.key("ArrowLeft", true)
    g.key("ArrowRight", true)
    g.key("ArrowUp", true)
    g.key("ArrowDown", true)
    g.step()
    assert(g.shipX == 65 && g.shipY == 105)
    g.key("ArrowRight", false)
    g.key("ArrowDown", false)
    g.step()
    assert(g.shipX == 60 && g.shipY == 100)
}

test "basic laser allows only one active shot and retries each thirteen normal steps" {
    var g = Game()
    g.start(7)
    g.shipState = 0
    for (var i = 0; i < 13; i++) { g.step() }
    assert(g.shots[0].active)
    var firstX = g.shots[0].x
    for (var i = 0; i < 13; i++) { g.step() }
    assert(g.shots[0].active && g.shots[0].x > firstX)
    assert(!g.shots[1].active && !g.shots[2].active)
    g.shots[0].active = false
    for (var i = 0; i < 13; i++) { g.step() }
    assert(g.shots[0].active)
}

test "ship collision scores once and explosion blocks movement and fire for thirty steps" {
    var g = Game()
    g.start(17)
    g.shipState = 0
    g.key("ArrowRight", true)
    g.meteors[0].x = 20
    g.meteors[0].y = 100
    g.step()
    assert(g.score == 5 && g.lives == 3 && g.shipState == 1)
    var x = g.shipX
    for (var i = 0; i < 29; i++) {
        g.step()
        assert(g.shipX == x && g.lives == 3 && !g.shots[0].active)
    }
    assert(g.explosionSteps == 29)
    g.step()
    assert(g.lives == 2 && g.shipState == 2 && g.shipX == 5)
}

test "laser hit holds meteor collision images for three pairs of steps" {
    var g = Game()
    g.start(21)
    g.shipState = 0
    for (var i = 0; i < 13; i++) { g.step() }
    g.shipY = 50
    g.meteors[0].x = g.shots[0].x + 4
    g.meteors[0].y = g.shots[0].y
    g.step()
    assert(g.score == 5 && g.meteors[0].collided)
    var x = g.meteors[0].x
    for (var i = 0; i < 5; i++) {
        g.step()
        assert(g.meteors[0].collided && g.meteors[0].x == x - i - 1 && g.score == 5)
        assert(g.meteors[0].collisionSteps / 2 == (i + 1) / 2)
    }
    g.step()
    assert(!g.meteors[0].collided && g.meteors[0].x >= 176)
}

test "ship image follows horizontal direction and last opposing key" {
    var g = Game()
    g.start(63)
    assert(!g.shipRightFrame)
    g.shipState = 0
    g.key("ArrowRight", true)
    g.step()
    assert(g.shipRightFrame)
    g.key("ArrowLeft", true)
    g.step()
    assert(!g.shipRightFrame)
    g.key("ArrowLeft", false)
    g.step()
    assert(g.shipRightFrame)
    g.key("ArrowRight", false)
    g.step()
    assert(!g.shipRightFrame)
    g.key("ArrowUp", true)
    g.step()
    assert(!g.shipRightFrame)
    g.key("ArrowLeft", true)
    g.step()
    assert(!g.shipRightFrame)
}

test "meteor sprite advances every two steps and returns through the historical frames" {
    var g = Game()
    g.start(31)
    var m = g.meteors[0]
    assert(m.frame == 0)
    g.step()
    assert(m.frame == 0)
    g.step()
    assert(m.frame == 1)
    for (var i = 0; i < 8; i++) { g.step() }
    assert(m.frame == 5)
    g.step()
    g.step()
    assert(m.frame == 4)
}

test "ship collision takes priority when its laser reaches the same meteor" {
    var g = Game()
    g.start(33)
    g.shipState = 0
    g.meteors[0].x = 20
    g.meteors[0].y = 100
    g.shots[0].x = 20
    g.shots[0].y = 100
    g.shots[0].active = true
    g.step()
    assert(g.shipState == 1 && g.score == 5 && g.shots[0].active)
}

test "ship meteor collision uses meteor left edge and inclusive ship bounds" {
    var g = Game()
    g.start(51)
    g.shipState = 0
    g.meteors[0].x = -5
    g.meteors[0].y = 100
    g.step()
    assert(g.score == 0 && g.shipState == 0)
    g.meteors[0].x = 51
    g.meteors[0].y = 100
    g.step()
    assert(g.score == 5 && g.shipState == 1)
}

test "laser meteor collision uses historical tip and bottom conditions" {
    var g = Game()
    g.start(53)
    g.shipState = 0
    g.shipY = 50
    g.shots[0].active = true
    g.shots[0].x = 0
    g.shots[0].y = 110
    g.meteors[0].x = 10
    g.meteors[0].y = 100
    g.step()
    assert(g.score == 0 && !g.meteors[0].collided)
    g.shots[0].x = 0
    g.shots[0].y = 100
    g.meteors[0].x = 36
    g.step()
    assert(g.score == 5 && g.meteors[0].collided)
}

test "laser impact remains at meteor for one rendered step without scoring twice" {
    var g = Game()
    g.start(55)
    g.shipState = 0
    g.shipY = 50
    g.shots[0].active = true
    g.shots[0].x = 0
    g.shots[0].y = 100
    g.meteors[0].x = 36
    g.meteors[0].y = 100
    g.step()
    assert(g.score == 5 && g.shots[0].active && g.shots[0].impact)
    assert(g.shots[0].x == g.meteors[0].x && g.shots[0].y == g.meteors[0].y)
    g.step()
    assert(g.score == 5 && !g.shots[0].active && !g.shots[0].impact)
    assert(g.meteors[0].collided)
}
