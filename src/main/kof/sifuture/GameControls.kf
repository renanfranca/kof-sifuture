package sifuture

import sifuture.ControlKeys
import sifuture.ControlStyles
import sifuture.ControlsGuide
import sifuture.DirectionPad
import sifuture.MenuChoice
import sifuture.MenuOption
import sifuture.SpecialButton
import sifuture.game.*
import kof.ui.*

class GameControls {
    Game game
    GameView drawing
    ControlKeys keys
    ControlStyles styles = ControlStyles()
    ControlsGuide guide = ControlsGuide()
    List<MenuOption> options = listOf<MenuOption>()
    Button overlay
    Button action
    SpecialButton special
    DirectionPad pad
    View surface
    View bitmap
    View creditsBitmap
    Label controlsHeading
    Column gameColumn
    Row movementControls
    Column root

    public constructor(Game game, GameView drawing, Canvas canvas) {
        this.game = game
        this.drawing = drawing
        keys = ControlKeys(game, guide)
        keyboardSurface(canvas)
        pad = DirectionPad(this)
        special = SpecialButton(this)
        gameColumn = Column(listOf(surface, pad.column))
        gameColumn.setStyle(styles.gameColumn)
        movementControls = Row(listOf(gameColumn, special.column))
        movementControls.setStyle(styles.movement)
        actionButton()
        root = Column(listOf(movementControls, guide.root, action))
        root.setStyle(styles.root)
        root.on("keydown", (e: Event) -> { this.applyKey(this.keys.keyDown(e.key(), e.target())) })
        root.on("keyup", (e: Event) -> { this.applyKey(this.keys.keyUp(e.key(), e.target())) })
        update()
    }

    private keyboardSurface(Canvas canvas) {
        overlayButton()
        surface = View(styles.surface)
        bitmap = View(styles.canvas)
        bitmap.bind(canvas)
        surface.bind(bitmap)
        creditsBitmap = View(styles.creditsCanvas)
        creditsBitmap.bind(drawing.creditsCanvas)
        surface.bind(creditsBitmap)
        controlsHeading = Label("Controles")
        controlsHeading.setId("controls-heading")
        controlsHeading.setStyle(styles.hidden)
        surface.bind(controlsHeading)
        surface.bind(overlay)
        menuOptions()
    }

    private menuOptions() {
        var choices = keys.choices
        options.add(MenuOption(this, choices[0], Style("position: absolute; left: 48; top: 120; width: 128; height: 19; padding: 0; pointer-events: none")))
        options.add(MenuOption(this, choices[1], Style("position: absolute; left: 48; top: 139; width: 128; height: 19; padding: 0; pointer-events: none")))
        options.add(MenuOption(this, choices[2], Style("position: absolute; left: 48; top: 80; width: 128; height: 19; padding: 0; pointer-events: none")))
        options.add(MenuOption(this, choices[3], Style("position: absolute; left: 48; top: 99; width: 128; height: 19; padding: 0; pointer-events: none")))
        options.add(MenuOption(this, choices[4], Style("position: absolute; left: 48; top: 118; width: 128; height: 19; padding: 0; pointer-events: none")))
    }

    private overlayButton() {
        overlay = Button("", () -> { if (this.keys.overlayClicked()) { this.refresh() } })
        overlay.setId("game-keyboard")
        overlay.setStyle(styles.keyboard)
        overlay.on("pointerdown", (e: Event) -> { this.game.rearmKeyboard() })
        overlay.on("focus", (e: Event) -> { this.keys.focusKeyboard(); this.updateSurfaceFocus() })
        overlay.on("blur", (e: Event) -> { this.keys.blurKeyboard(); this.updateSurfaceFocus() })
    }

    private actionButton() {
        action = Button("Novo Jogo", () -> { if (this.keys.actionClicked()) { this.refresh() } })
        action.setId("game-action")
        action.on("pointerdown", (e: Event) -> { this.keys.actionPointerDown() })
        action.on("focus", (e: Event) -> { this.keys.focusAction(); this.action.setStyle(this.styles.focusedAction) })
        action.on("blur", (e: Event) -> { this.keys.blurAction(); this.action.setStyle(this.styles.action) })
    }

    private applyKey(KeyOutcome outcome) {
        if (outcome.render) { drawing.render(game) }
        if (outcome.update) { update() }
        if (outcome.updateSpecial) { special.show() }
    }

    refresh() {
        drawing.render(game)
        update()
    }

    update() {
        special.show()
        pad.lock(keys)
        for (var option in options) { option.show(keys, styles) }
        action.setStyle(if (keys.actionFocused) styles.focusedAction else styles.action)
        updateSurfaceFocus()
        var credits = keys.creditsLayout()
        creditsBitmap.setStyle(if (credits) styles.creditsCanvas else styles.hidden)
        movementControls.setStyle(if (credits) styles.creditsMovement else styles.movement)
        root.setStyle(if (credits) styles.creditsRoot else styles.root)
        action.text = keys.actionLabel()
        if (keys.guideLayout()) { showGuideLayout() }
        else if (credits) { showCreditsLayout() }
        else { showGameLayout() }
    }

    private updateSurfaceFocus() {
        var focused = keys.surfaceFocused()
        if (keys.guideLayout()) { surface.setStyle(if (focused) styles.focusedGuideSurface else styles.guideSurface) }
        else if (keys.creditsLayout()) { surface.setStyle(if (focused) styles.focusedCreditsSurface else styles.creditsSurface) }
        else { surface.setStyle(if (focused) styles.focusedSurface else styles.surface) }
    }

    private showGuideLayout() {
        guide.show()
        showSurfaceParts(styles.hidden, styles.heading, styles.guideKeyboard)
        pad.column.setStyle(styles.hidden)
        gameColumn.setStyle(styles.guideColumn)
        special.column.setStyle(if (keys.specialRetained()) styles.retainedOption else styles.hidden)
    }

    private showCreditsLayout() {
        guide.close()
        showSurfaceParts(styles.hidden, styles.hidden, styles.creditsKeyboard)
        pad.column.setStyle(styles.hidden)
        gameColumn.setStyle(styles.creditsColumn)
        special.column.setStyle(styles.hidden)
    }

    private showGameLayout() {
        guide.close()
        showSurfaceParts(styles.canvas, styles.hidden, styles.keyboard)
        pad.column.setStyle(styles.pad)
        gameColumn.setStyle(styles.gameColumn)
        special.column.setStyle(styles.specialColumn)
    }

    private showSurfaceParts(Style canvas, Style heading, Style keyboard) {
        bitmap.setStyle(canvas)
        controlsHeading.setStyle(heading)
        overlay.setStyle(keyboard)
    }
}
