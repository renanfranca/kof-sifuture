package sifuture

import sifuture.game.*
import kof.ui.*

class GameControls {
    Game game
    GameView drawing
    Button overlay
    Button action
    Button secondary
    Button mainMenu
    Label help
    Bool secondaryFocused = false
    Bool menuFocused = false
    String discardOptionClick = ""
    Button special
    Button north
    Button west
    Button east
    Button south
    Column root
    Bool enterHeld = false
    Bool oneHeld = false
    Bool spaceHeld = false
    Bool specialPointerHeld = false
    Bool discardEnterClick = false
    private Bool specialFocused = false
    private Style hiddenStyle
    private Style optionStyle
    private Style selectedOptionStyle
    private Style helpStyle
    private Style specialAvailableStyle
    private Style specialUnavailableStyle

    public constructor(Game game, GameView drawing, Canvas canvas) {
        this.game = game
        this.drawing = drawing
        hiddenStyle = Style("display: none")
        optionStyle = Style("display: block; outline: none")
        selectedOptionStyle = Style("display: block; outline: 2px solid blue")
        helpStyle = Style("display: block; max-width: 272; white-space: normal; padding: 8")
        var surface = keyboardSurface(canvas)

        north = directionButton(Direction.Up, "↑")
        west = directionButton(Direction.Left, "←")
        east = directionButton(Direction.Right, "→")
        south = directionButton(Direction.Down, "↓")
        var empty = View(Style("width: 56; height: 56; padding: 0"))
        var top = Row(listOf(north))
        var middle = Row(listOf(west, empty, east))
        var bottom = Row(listOf(south))
        var rowStyle = Style("gap: 0; padding: 0")
        top.setStyle(rowStyle)
        middle.setStyle(rowStyle)
        bottom.setStyle(rowStyle)
        var pad = Column(listOf(top, middle, bottom))
        pad.setStyle(Style("align-items: center; gap: 0; padding: 0"))
        special = Button("Especial", () -> {})
        special.setId("game-special")
        specialAvailableStyle = Style("width: 56; height: 220; writing-mode: vertical-rl; padding: 0; touch-action: none; user-select: none; opacity: 1")
        specialUnavailableStyle = Style("width: 56; height: 220; writing-mode: vertical-rl; padding: 0; touch-action: none; user-select: none; opacity: 0.5")
        special.on("focus", (e: Event) -> { this.specialFocused = true })
        special.on("blur", (e: Event) -> {
            this.specialFocused = false
            this.updateSpecial()
        })
        special.on("pointerdown", (e: Event) -> {
            if (!this.specialPointerHeld) {
                this.specialPointerHeld = true
                this.activateSpecial()
            }
        })
        special.on("pointerup", (e: Event) -> { this.specialPointerHeld = false })
        special.on("pointercancel", (e: Event) -> { this.specialPointerHeld = false })
        special.on("pointerleave", (e: Event) -> { this.specialPointerHeld = false })
        var gameColumn = Column(listOf(surface, pad))
        gameColumn.setStyle(Style("width: 176; align-items: center; padding: 0"))
        var specialColumn = Column(listOf(special))
        specialColumn.setStyle(Style("width: 56; height: 220; justify-content: center; padding: 0"))
        var movementControls = Row(listOf(gameColumn, specialColumn))
        movementControls.setStyle(Style("width: 248; flex-wrap: nowrap; align-self: center; align-items: flex-start; gap: 16; padding: 0"))
        action = Button("Novo Jogo", () -> { this.activateAction() })
        action.setId("game-action")
        action.on("pointerdown", (e: Event) -> { this.discardEnterClick = false })
        action.on("blur", (e: Event) -> { this.discardEnterClick = false })
        secondary = Button("Controles", () -> { this.activateOption(1, "game-secondary") })
        secondary.setId("game-secondary")
        secondary.on("pointerdown", (e: Event) -> { this.discardOptionClick = "" })
        secondary.on("focus", (e: Event) -> { this.secondaryFocused = true; this.focusOption(1) })
        secondary.on("blur", (e: Event) -> { this.secondaryFocused = false; this.discardOptionClick = "" })
        mainMenu = Button("Menu principal", () -> { this.activateOption(2, "game-menu") })
        mainMenu.setId("game-menu")
        mainMenu.on("pointerdown", (e: Event) -> { this.discardOptionClick = "" })
        mainMenu.on("focus", (e: Event) -> { this.menuFocused = true; this.focusOption(2) })
        mainMenu.on("blur", (e: Event) -> { this.menuFocused = false; this.discardOptionClick = "" })
        help = Label("Teclado: clique no jogo ou use Tab para dar foco. Setas movem a nave; Enter confirma e pausa; 1 tenta o especial. Toque: setas independentes combinam diagonais; em opostos vale a última seta pressionada, e soltá-la retoma a outra ainda mantida. Arrasto mantém a seta inicial até soltar ou cancelar. Soltar uma seta conserva as demais. Especial faz uma tentativa por pressão, sem repetir enquanto mantido. Pausa limpa movimentos; Continuar exige nova pressão.")
        help.setId("game-help")
        help.setStyle(helpStyle)
        var hint = Label("Clique no jogo ou use Tab para ativar teclado. Setas movem; Enter age; 1 dispara especial.")
        root = Column(listOf(movementControls, action, secondary, mainMenu, help, hint))
        root.on("keydown", (e: Event) -> { this.keyChanged(e.key(), e.target(), true) })
        root.on("keyup", (e: Event) -> { this.keyChanged(e.key(), e.target(), false) })
        update()
    }

    View keyboardSurface(Canvas canvas) {
        overlay = Button("Ativar teclado do jogo", () -> {
            if (game.screen == Screen.Credits) { this.activateAction() }
        })
        configureOverlay()
        var surface = View(Style("position: relative; width: 176; height: 220; padding: 0; align-self: center"))
        surface.bind(canvas)
        surface.bind(overlay)
        return surface
    }

    configureOverlay() {
        overlay.setId("game-keyboard")
        var idleStyle = overlayStyle(false)
        var focusedStyle = overlayStyle(true)
        overlay.setStyle(idleStyle)
        overlay.on("pointerdown", (e: Event) -> { game.rearmKeyboard() })
        overlay.on("focus", (e: Event) -> { overlay.setStyle(focusedStyle) })
        overlay.on("blur", (e: Event) -> {
            game.clearKeyboard()
            overlay.setStyle(idleStyle)
        })
    }

    Style overlayStyle(Bool focused) {
        if (focused) {
            return Style("position: absolute; top: 0; left: 0; width: 176; height: 220; padding: 0; border: 0; background: transparent; color: transparent; cursor: default; outline: 2px solid blue")
        }
        return Style("position: absolute; top: 0; left: 0; width: 176; height: 220; padding: 0; border: 0; background: transparent; color: transparent; cursor: default; outline: none")
    }

    Button directionButton(Direction direction, String name) {
        var button = Button(name, () -> {})
        button.setStyle(Style("width: 56; height: 56; padding: 0; touch-action: none; user-select: none"))
        button.on("pointerdown", (e: Event) -> { this.directionChanged(direction, true) })
        button.on("pointerup", (e: Event) -> { this.directionChanged(direction, false) })
        button.on("pointercancel", (e: Event) -> { this.directionChanged(direction, false) })
        button.on("pointerleave", (e: Event) -> { this.directionChanged(direction, false) })
        return button
    }

    private directionChanged(Direction direction, Bool pressed) {
        game.movement(direction, pressed)
        drawing.render(game)
        update()
    }

    focusOption(Int option) {
        if (game.screen == Screen.Menu) { game.menuSelection = option }
        if (game.screen == Screen.Pause) { game.pauseSelection = option }
        drawing.render(game)
        update()
    }

    activateOption(Int option, String id) {
        if (discardOptionClick == id) { discardOptionClick = ""; return }
        focusOption(option)
        game.confirm()
        drawing.render(game)
        update()
    }

    activateAction() {
        if (discardEnterClick) {
            discardEnterClick = false
            return
        }
        if (game.screen == Screen.Menu) { game.menuSelection = 0 }
        if (game.screen == Screen.Pause) { game.pauseSelection = 0 }
        game.confirm()
        drawing.render(game)
        update()
    }

    activateSpecial() {
        game.trySpecial()
        drawing.render(game)
        update()
    }

    keyChanged(String key, String target, Bool pressed) {
        if (key == "1") {
            var freshPress = pressed && !oneHeld
            oneHeld = pressed
            if (freshPress && (target == "game-keyboard" || target == "game-special")) { activateSpecial() }
            if (!pressed) { updateSpecial() }
            return
        }
        if (key == " ") {
            var freshPress = pressed && !spaceHeld
            spaceHeld = pressed
            if (freshPress && target == "game-special") { activateSpecial() }
            if (!pressed) { updateSpecial() }
            if (pressed && target == "game-action") { discardEnterClick = false }
            return
        }
        if (key == "Enter") {
            var freshPress = pressed && !enterHeld
            enterHeld = pressed
            if (pressed && target == "game-action") { discardEnterClick = true }
            if (pressed && (target == "game-secondary" || target == "game-menu")) { discardOptionClick = target }
            if (freshPress && (target == "game-keyboard" || target == "game-action" || target == "game-special" || target == "game-secondary" || target == "game-menu")) {
                if (target == "game-special") { activateSpecial() }
                else { game.confirm(); drawing.render(game); update() }
            }
            if (!pressed) {
                discardEnterClick = false
                discardOptionClick = ""
                update()
            }
            return
        }
        var movementAllowed = target == "game-keyboard" || game.screen == Screen.Menu || game.screen == Screen.Pause
        if (key == "ArrowLeft") { game.keyboard(Direction.Left, pressed, movementAllowed) }
        if (key == "ArrowRight") { game.keyboard(Direction.Right, pressed, movementAllowed) }
        if (key == "ArrowUp") { game.keyboard(Direction.Up, pressed, movementAllowed) }
        if (key == "ArrowDown") { game.keyboard(Direction.Down, pressed, movementAllowed) }
        drawing.render(game)
        update()
    }

    private updateSpecial() {
        var available = game.canSpecial()
        var preserveFocus = specialFocused && (oneHeld || enterHeld || spaceHeld)
        if (available) { special.setStyle(specialAvailableStyle) }
        else { special.setStyle(specialUnavailableStyle) }
        special.setDisabled(!available && !preserveFocus)
    }

    setOptionStyle(Button button, Bool visible, Bool selected) {
        if (!visible) { button.setStyle(hiddenStyle) }
        else if (selected) { button.setStyle(selectedOptionStyle) }
        else { button.setStyle(optionStyle) }
    }

    update() {
        var playing = game.screen == Screen.Play
        updateSpecial()
        var navigating = game.screen == Screen.Menu || game.screen == Screen.Pause
        north.setDisabled(!playing && !navigating)
        west.setDisabled(!playing)
        east.setDisabled(!playing)
        south.setDisabled(!playing && !navigating)
        if (game.screen == Screen.Credits) { action.text = "Pular créditos" }
        if (game.screen == Screen.Menu) { action.text = "Novo Jogo"; secondary.text = "Controles" }
        if (game.screen == Screen.Controls) { action.text = "Voltar" }
        if (game.screen == Screen.Pause) { secondary.text = "Reiniciar" }
        var showSecondary = navigating || (secondaryFocused && (enterHeld || spaceHeld))
        var showMenu = game.screen == Screen.Pause || (menuFocused && (enterHeld || spaceHeld))
        setOptionStyle(secondary, showSecondary, (game.screen == Screen.Menu && game.menuSelection == 1) || (game.screen == Screen.Pause && game.pauseSelection == 1))
        setOptionStyle(mainMenu, showMenu, game.screen == Screen.Pause && game.pauseSelection == 2)
        setOptionStyle(action, true, navigating && ((game.screen == Screen.Menu && game.menuSelection == 0) || (game.screen == Screen.Pause && game.pauseSelection == 0)))
        if (game.screen == Screen.Controls) { help.setStyle(helpStyle) }
        else { help.setStyle(hiddenStyle) }
        if (game.screen == Screen.Play) { action.text = "Pausar" }
        if (game.screen == Screen.Pause) { action.text = "Continuar" }
        if (game.screen == Screen.Result) {
            if (game.countComplete()) { action.text = "Voltar ao menu" }
            else { action.text = "Concluir contagem" }
        }
    }
}
