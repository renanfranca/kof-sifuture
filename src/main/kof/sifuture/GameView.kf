package sifuture

import sifuture.game.*
import kof.ui.*

class GameView {
    Canvas canvas
    Image title
    Image menu
    Image ship
    Image subchief
    Image subchiefShot
    Image shipRight
    List<Image> meteors
    List<Image> meteorHits
    List<Image> explosions
    Image background
    Image specialIcon
    List<Image> evolutionItems
    List<Image> lifeItems
    List<Image> itemEffects
    List<Image> lasers
    List<Image> blasters
    List<Image> specialFrames
    Image laserImpact
    Image stageStart
    Image stageTrack
    List<Image> lifeShips
    List<Image> digits
    Image scoreLabel
    Image finalScoreLabel
    Image timesLabel
    Image result0
    Image result1
    Image result2
    Image result3

    public constructor(Canvas canvas) {
        this.canvas = canvas
        title = Image("assets/sifuture.png")
        menu = Image("assets/menu0.png")
        ship = Image("assets/Middle.png")
        subchief = Image("assets/subchief.png")
        subchiefShot = Image("assets/laser0.png")
        shipRight = Image("assets/Middle2.png")
        meteors = listOf(Image("assets/meteor000.png"), Image("assets/meteor001.png"), Image("assets/meteor002.png"), Image("assets/meteor003.png"), Image("assets/meteor004.png"), Image("assets/meteor005.png"))
        meteorHits = listOf(Image("assets/meteor0C0.png"), Image("assets/meteor0C1.png"), Image("assets/meteor0C2.png"))
        explosions = listOf(Image("assets/explosion0.png"), Image("assets/explosion1.png"), Image("assets/explosion2.png"), Image("assets/explosion3.png"), Image("assets/explosion4.png"), Image("assets/explosion5.png"), Image("assets/explosion6.png"), Image("assets/explosion7.png"), Image("assets/explosion8.png"), Image("assets/explosion9.png"))
        background = Image("assets/background.png")
        specialIcon = Image("assets/especialActivated1.png")
        evolutionItems = listOf(Image("assets/iten0.png"), Image("assets/iten1.png"), Image("assets/iten2.png"), Image("assets/iten3.png"), Image("assets/iten4.png"))
        lifeItems = listOf(Image("assets/life0.png"), Image("assets/life1.png"), Image("assets/life2.png"), Image("assets/life3.png"), Image("assets/life4.png"), Image("assets/life5.png"), Image("assets/life6.png"), Image("assets/life7.png"), Image("assets/life8.png"), Image("assets/life9.png"), Image("assets/life10.png"))
        itemEffects = listOf(Image("assets/effect0.png"), Image("assets/effect1.png"), Image("assets/effect2.png"))
        lasers = listOf(Image("assets/laser00.png"), Image("assets/laser01.png"), Image("assets/laser02.png"))
        blasters = listOf(Image("assets/ylwBlaster00.png"), Image("assets/ylwBlaster01.png"), Image("assets/ylwBlaster02.png"), Image("assets/ylwBlaster03.png"), Image("assets/ylwBlaster04.png"), Image("assets/ylwBlaster05.png"), Image("assets/ylwBlaster06.png"), Image("assets/ylwBlaster07.png"), Image("assets/ylwBlaster08.png"))
        specialFrames = listOf(Image("assets/e0.png"), Image("assets/e1.png"), Image("assets/e2.png"), Image("assets/e3.png"), Image("assets/e4.png"), Image("assets/e5.png"), Image("assets/e6.png"), Image("assets/e7.png"), Image("assets/e8.png"))
        laserImpact = Image("assets/laser03.png")
        stageStart = Image("assets/StageBeginer.png")
        stageTrack = Image("assets/StageMiddle.png")
        lifeShips = listOf(Image("assets/1lives.png"), Image("assets/2lives.png"), Image("assets/3lives.png"))
        digits = listOf(Image("assets/0.png"), Image("assets/1.png"), Image("assets/2.png"), Image("assets/3.png"), Image("assets/4.png"), Image("assets/5.png"), Image("assets/6.png"), Image("assets/7.png"), Image("assets/8.png"), Image("assets/9.png"))
        scoreLabel = Image("assets/score.png")
        finalScoreLabel = Image("assets/score1.png")
        timesLabel = Image("assets/x.png")
        result0 = Image("assets/result0.png")
        result1 = Image("assets/result1.png")
        result2 = Image("assets/result2.png")
        result3 = Image("assets/result3.png")
    }

    render(Game game) {
        canvas.clearRect(0, 0, Rules.WORLD_WIDTH, Rules.WORLD_HEIGHT)
        canvas.setFill(Palette.white)
        if (game.screen == Screen.Menu) {
            canvas.drawImage(title, 11, 30)
            canvas.drawImage(menu, 48, 120)
            canvas.fillText("Novo Jogo", 56, 174)
            return
        }
        for (var y = Rules.HEADER_HEIGHT; y < Rules.WORLD_HEIGHT; y = y + 60) {
            for (var x = -game.background.offset; x < Rules.WORLD_WIDTH; x = x + 60) {
                canvas.drawImage(background, x, y)
            }
        }
        for (var item in game.items) {
            if (item.collected) { canvas.drawImage(itemEffects[item.effectSteps / 2], item.x, item.y) }
            else if (item.kind == ItemKind.Evolution) { canvas.drawImage(evolutionItems[item.frame], item.x, item.y) }
            else { canvas.drawImage(lifeItems[item.frame], item.x, item.y) }
        }
        for (var shot in game.subchief.shots) {
            if (shot.active) { canvas.drawImage(subchiefShot, shot.x, shot.y) }
        }
        var chief = game.subchief
        if (chief.phase == SubchiefPhase.Normal) { canvas.drawImage(subchief, chief.x, chief.y) }
        if (chief.phase == SubchiefPhase.Explosion) {
            canvas.drawImage(explosions[chief.explosionSteps / 3], chief.explosionX, chief.y)
        }
        for (var m in game.meteors) {
            if (m.active) {
                if (m.collided) { canvas.drawImage(meteorHits[m.impactFrame()], m.x, m.y) }
                else { canvas.drawImage(meteors[m.frame], m.x, m.y) }
            }
        }
        for (var s in game.weapons.lasers.shots) {
            if (s.active && s.impact) { canvas.drawImage(laserImpact, s.x + 5, s.y) }
            else if (s.active) { canvas.drawImage(lasers[s.spriteFrame()], s.x, s.y) }
        }
        var blaster = game.weapons.blaster
        if (blaster.active) {
            if (blaster.lives > 0) {
                if (blaster.spriteFrame() == 4) { canvas.drawImage(blasters[8], blaster.x, blaster.y) }
                else { canvas.drawImage(blasters[blaster.spriteFrame()], blaster.x, blaster.y) }
            } else {
                var y = blaster.y
                if (blaster.impactSteps == 1) { y = y - 14 }
                if (blaster.impactSteps > 1) { y = y - 15 }
                canvas.drawImage(blasters[4 + blaster.impactSteps], blaster.x, y)
            }
        }
        for (var beam in game.weapons.beams) {
            if (beam.active) { canvas.drawImage(specialFrames[beam.color * 3 + beam.spriteFrame()], beam.x, beam.y) }
        }
        if (game.ship.phase == ShipPhase.Explosion && game.ship.explosionSteps < Rules.SHIP_EXPLOSION_STEPS) { canvas.drawImage(explosions[game.ship.explosionSteps / Rules.SHIP_EXPLOSION_FRAME_STEPS], game.ship.x, game.ship.y) }
        if (game.ship.phase == ShipPhase.Normal || (game.ship.phase == ShipPhase.Restart && (game.ship.restartFrame / Rules.SHIP_RESTART_BLINK_STEPS) % 2 == 0)) {
            if (game.ship.phase == ShipPhase.Normal && game.ship.rightFrame) {
                canvas.drawImage(shipRight, game.ship.x, game.ship.y)
            } else { canvas.drawImage(ship, game.ship.x, game.ship.y) }
        }
        drawHud(game)
        if (game.screen == Screen.Result) { drawResult(game) }
        if (game.screen == Screen.Pause) { canvas.fillText("PAUSADO", 60, 100) }
    }

    private drawHud(Game game) {
        canvas.clearRect(0, 0, Rules.WORLD_WIDTH, Rules.HEADER_HEIGHT)
        for (var x = 8; x < Rules.WORLD_WIDTH; x = x + 18) { canvas.drawImage(stageTrack, x, 0) }
        var lifeFrame = 2
        if (game.ship.lives == 1) { lifeFrame = 0 }
        if (game.ship.lives == 2) { lifeFrame = 1 }
        canvas.drawImage(lifeShips[lifeFrame], game.stagePosition(), 9)
        canvas.drawImage(stageStart, 0, 0)
        var scoreX = Rules.WORLD_WIDTH - numberWidth(game.score)
        drawNumber(game.score, scoreX, 0)
        canvas.drawImage(scoreLabel, scoreX - 24, 7)
        canvas.drawImage(lifeShips[1], 146, 21)
        canvas.drawImage(timesLabel, 140, 21)
        drawNumber(game.ship.lives, 142 - numberWidth(game.ship.lives), 21)
        if (game.weapons.charges > 0) { canvas.drawImage(specialIcon, 50, 21) }
    }

    private drawResult(Game game) {
        var scoreX = (Rules.WORLD_WIDTH - 53 - numberWidth(game.displayedScore)) / 2
        canvas.drawImage(finalScoreLabel, scoreX, 86)
        drawNumber(game.displayedScore, scoreX + 53, 86)
        if (!game.countComplete()) { return }
        if (game.resultIndex() == 0) { canvas.drawImage(result0, 31, 113) }
        if (game.resultIndex() == 1) { canvas.drawImage(result1, 22, 113) }
        if (game.resultIndex() == 2) { canvas.drawImage(result2, 54, 113) }
        if (game.resultIndex() == 3) { canvas.drawImage(result3, 26, 113) }
    }

    private numberWidth(Int value): Int {
        var width = 16
        var remaining = value / 10
        while (remaining > 0) { width = width + 16; remaining = remaining / 10 }
        return width
    }

    private drawNumber(Int value, Int x, Int y) {
        var divisor = 1
        while (value / divisor >= 10) { divisor = divisor * 10 }
        var digitX = x
        while (divisor > 0) {
            canvas.drawImage(digits[(value / divisor) % 10], digitX, y)
            digitX = digitX + 16
            divisor = divisor / 10
        }
    }
}
