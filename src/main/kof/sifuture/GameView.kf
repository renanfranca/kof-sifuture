package sifuture

import sifuture.Scene
import sifuture.Scenes
import sifuture.Sheet
import sifuture.game.*
import kof.ui.*

class GameView {
    Canvas canvas
    Canvas creditsCanvas
    List<List<Image>> sheet = listOf<List<Image>>()

    public constructor(Canvas canvas) {
        this.canvas = canvas
        creditsCanvas = Canvas(Rules.CREDITS_WIDTH, Rules.CREDITS_HEIGHT)
        for (var paths in sheetPaths()) {
            var images = listOf<Image>()
            for (var path in paths) { images.add(Image(path)) }
            sheet.add(images)
        }
    }

    render(Game game) {
        var scene = sceneOf(game)
        if (scene.credits) { paintCredits(scene) }
        else { paint(scene) }
    }

    private paintCredits(Scene scene) {
        creditsCanvas.clearRect(0, 0, Rules.CREDITS_WIDTH, Rules.CREDITS_HEIGHT)
        creditsCanvas.setFill(Palette.white)
        for (var caption in scene.captions) { write(creditsCanvas, caption, Color(0, 128, 255)) }
    }

    private paint(Scene scene) {
        canvas.clearRect(0, 0, Rules.WORLD_WIDTH, Rules.WORLD_HEIGHT)
        canvas.setFill(Palette.white)
        drawAll(scene.world)
        canvas.clearRect(0, 0, Rules.WORLD_WIDTH, Rules.HEADER_HEIGHT)
        drawAll(scene.hud)
        for (var caption in scene.captions) { write(canvas, caption, Palette.white) }
        drawAll(scene.top)
    }

    private drawAll(List<Sprite> sprites) {
        for (var sprite in sprites) { canvas.drawImage(sheet[sprite.art][sprite.frame], sprite.x, sprite.y) }
    }

    private write(Canvas target, Caption caption, Color color) {
        target.save()
        target.setFill(color)
        target.transform(1.6, 0.0, 0.0, 1.6, caption.x.toDouble(), caption.baseline.toDouble())
        target.fillText(caption.text, 0, 0)
        target.restore()
    }
}
