package sifuture

import kof.ui.*

class BitmapGlyph {
    String character
    Image image
    Int advance
    Int left
    Int top

    public constructor(String character, Image image, Int advance, Int left, Int top) {
        this.character = character
        this.image = image
        this.advance = advance
        this.left = left
        this.top = top
    }
}

