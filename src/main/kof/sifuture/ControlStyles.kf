package sifuture

import kof.ui.*

class ControlStyles {
    Style hidden = Style("display: none")
    Style option = Style("display: block; width: 128; height: 19; padding: 0; pointer-events: auto; border: 0; background: transparent; color: transparent; opacity: 0; outline: none")
    Style retainedOption = Style("position: absolute; left: -10000; top: 0; width: 1; height: 1; padding: 0; pointer-events: none; opacity: 0")
    Style action = Style("display: block; outline: none")
    Style focusedAction = Style("display: block; outline: 1px solid gray")
    Style surface = Style("position: relative; width: 176; height: 220; padding: 0; align-self: center; outline: none")
    Style focusedSurface = Style("position: relative; width: 176; height: 220; padding: 0; align-self: center; outline: 1px solid gray")
    Style guideSurface = Style("position: relative; width: 248; height: 44; padding: 0; align-self: center; outline: none")
    Style focusedGuideSurface = Style("position: relative; width: 248; height: 44; padding: 0; align-self: center; outline: 1px solid gray")
    Style creditsSurface = Style("position: relative; width: 262; height: 260; padding: 0; align-self: center; outline: none; background: #121212")
    Style focusedCreditsSurface = Style("position: relative; width: 262; height: 260; padding: 0; align-self: center; outline: 1px solid gray; background: #121212")
    Style keyboard = Style("position: absolute; top: 0; left: 0; width: 176; height: 220; padding: 0; border: 0; background: transparent; color: transparent; cursor: default; outline: none")
    Style guideKeyboard = Style("position: absolute; top: 0; left: 0; width: 248; height: 44; padding: 0; border: 0; background: transparent; color: transparent; cursor: default; outline: none")
    Style creditsKeyboard = Style("position: absolute; top: 0; left: 0; width: 262; height: 260; padding: 0; border: 0; background: transparent; color: transparent; cursor: default; outline: none")
    Style canvas = Style("display: block; width: 176; height: 220; padding: 0")
    Style creditsCanvas = Style("display: block; width: 262; height: 260; padding: 0")
    Style heading = Style("display: block; height: 44; font-family: sans-serif; font-size: 16; line-height: 44px; font-weight: bold; text-align: center; color: #eeeeee; background: #121212")
    Style gameColumn = Style("width: 176; align-items: center; padding: 0")
    Style guideColumn = Style("width: 248; align-items: center; padding: 0")
    Style creditsColumn = Style("width: 262; align-items: center; padding: 0")
    Style movement = Style("width: 248; flex-wrap: nowrap; align-self: center; align-items: flex-start; gap: 16; padding: 0")
    Style creditsMovement = Style("width: 262; flex-wrap: nowrap; align-self: center; align-items: flex-start; gap: 0; padding: 0")
    Style root = Style("width: 248; max-width: 248; align-self: center; padding: 0")
    Style creditsRoot = Style("width: 262; max-width: 262; align-self: center; padding: 0")
    Style pad = Style("display: flex; align-items: center; gap: 0; padding: 0")
    Style padRow = Style("gap: 0; padding: 0")
    Style padGap = Style("width: 56; height: 56; padding: 0")
    Style arrow = Style("width: 56; height: 56; padding: 0; touch-action: none; user-select: none; outline: none")
    Style focusedArrow = Style("width: 56; height: 56; padding: 0; touch-action: none; user-select: none; outline: 1px solid gray")
    Style specialColumn = Style("display: flex; width: 56; height: 220; justify-content: center; padding: 0")
    Style specialAvailable = Style("width: 56; height: 220; writing-mode: vertical-rl; padding: 0; touch-action: none; user-select: none; opacity: 1; outline: none")
    Style specialAvailableFocused = Style("width: 56; height: 220; writing-mode: vertical-rl; padding: 0; touch-action: none; user-select: none; opacity: 1; outline: 1px solid gray")
    Style specialUnavailable = Style("width: 56; height: 220; writing-mode: vertical-rl; padding: 0; touch-action: none; user-select: none; opacity: 0.5; outline: none")
    Style specialUnavailableFocused = Style("width: 56; height: 220; writing-mode: vertical-rl; padding: 0; touch-action: none; user-select: none; opacity: 0.5; outline: 1px solid gray")

    public constructor() { }
}
