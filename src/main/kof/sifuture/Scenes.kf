package sifuture

import sifuture.Scene
import sifuture.Sheet
import sifuture.WorldScene
import sifuture.HudScene
import sifuture.game.*

Scene sceneOf(Game game) {
    var scene = Scene()
    if (game.screen == Screen.Credits) { creditsScene(scene, game.credits); return scene }
    if (game.screen == Screen.Menu) { menuScene(scene, game); return scene }
    if (game.screen == Screen.Controls) { return scene }
    worldScene(scene.world, game)
    hudScene(scene.hud, game)
    if (game.screen == Screen.Result) { resultScene(scene.hud, game) }
    if (game.screen == Screen.Pause) { pauseScene(scene, game) }
    return scene
}

creditsScene(Scene scene, Credits credits) {
    scene.credits = true
    if (credits.exitComplete) { return }
    creditBlock(scene, listOf("Copyright (c) 2006-2007", "Renan Meneses", "de Andrade Franca"), credits.x, credits.firstY)
    creditBlock(scene, listOf("contact:", "renan.andradefranca@gmail.com", "Inc. All rights reserved."), credits.x, credits.secondY)
}

creditBlock(Scene scene, List<String> lines, Int x, Int y) {
    var baseline = y + 16
    for (var line in lines) {
        scene.captions.add(Caption(line, x, baseline))
        baseline = baseline + 24
    }
}

menuScene(Scene scene, Game game) {
    scene.hud.add(Sprite(Art.TITLE, 0, 11, 30))
    scene.label("Novo Jogo", 120)
    scene.label("Controles", 139)
    var selector = 1
    if (game.menuEntrance.phase == MenuEntrancePhase.Entry) { selector = 2 }
    scene.top.add(Sprite(Art.LIFE_SHIP, selector, game.menuEntrance.x, 120 + game.menuSelection * 19))
}
