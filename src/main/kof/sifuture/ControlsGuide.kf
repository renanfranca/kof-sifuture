package sifuture

import sifuture.GuideDisclosure
import kof.ui.*

class ControlsGuide {
    Column root
    Button disclosure
    Bool discardClick = false
    GuideDisclosure detailsState = GuideDisclosure()
    private Column details
    private Style hiddenStyle
    private Style panelStyle
    private Style contentStyle

    public constructor() {
        hiddenStyle = Style("display: none")
        panelStyle = Style("display: flex; flex-direction: column; box-sizing: border-box; width: 248; max-width: 248; gap: 12; padding: 16; background: black; color: #eeeeee; font-family: sans-serif; font-size: 14; line-height: 20px; white-space: normal")
        contentStyle = Style("display: flex; flex-direction: column; width: 100%; gap: 12; padding: 0; color: #eeeeee; font-family: sans-serif; font-size: 14; line-height: 20px; white-space: normal")
        var keyboard = keyboardBlock()
        var touch = touchBlock()
        var special = specialBlock()
        disclosure = disclosureButton()
        details = detailsBlock()
        root = Column(listOf(keyboard, touch, special, disclosure, details))
        root.setId("game-help")
        close()
    }

    private Column keyboardBlock() {
        var keyboard = Table(listOf("Tecla", "Ação"), listOf(
            listOf("Setas", "Mover a nave na partida"),
            listOf("↑ / ↓", "Escolher uma opção nos menus"),
            listOf("Enter", "Confirmar nos menus; pausar na partida"),
            listOf("1", "Usar o especial quando disponível")))
        keyboard.setStyle(Style("width: 100%; table-layout: fixed; border-collapse: collapse; font-family: sans-serif; font-size: 14; line-height: 20px; text-align: left"))
        var block = Column(listOf(
            heading("Teclado"),
            paragraph("Na abertura, use Tab ou clique em um controle. O foco do menu permite jogar sem clicar na área; ela continua disponível por clique ou Tab."),
            keyboard))
        block.setStyle(contentStyle)
        return block
    }

    private Column touchBlock() {
        var touch = Ul(listOf(
            "Toque em uma opção do menu para abri-la.",
            "Segure as setas para mover. Combine duas para fazer diagonal.",
            "Solte todas as setas para parar.",
            "Especial: uma tentativa por pressão, quando disponível.",
            "Pausar: abrir o menu da pausa."))
        touch.setId("controls-touch")
        touch.setStyle(Style("margin: 0; padding: 0 0 0 18px; font-family: sans-serif; font-size: 14; line-height: 20px"))
        var block = Column(listOf(heading("Toque"), touch))
        block.setStyle(contentStyle)
        return block
    }

    private Column specialBlock() {
        var special = Column(listOf(
            heading("Especial"),
            paragraph("O botão Especial fica à direita da área de jogo. Quando estiver habilitado, toque nele para lançar três feixes e gastar uma carga. No teclado, use 1 com foco no jogo. Segurar não repete o disparo."),
            paragraph("Depois de atingir a potência máxima da arma, pegar outro item de evolução concede uma carga.")))
        special.setId("controls-special")
        special.setStyle(contentStyle)
        return special
    }

    private Column detailsBlock() {
        var block = Column(listOf(
            paragraph("Direções opostas: vence a última pressionada. Ao soltá-la, retoma a outra ainda mantida."),
            paragraph("Arrasto: o dedo mantém a seta inicial; deslizar não troca a direção. Soltura ou cancelamento encerra essa pressão. Com o mouse, sair da seta encerra a pressão."),
            paragraph("Soltar uma seta conserva as outras; soltar a última para. Pausar limpa movimentos; Continuar exige novas pressões."),
            paragraph("O direcional tem prioridade sobre o teclado enquanto pressionado. Depois de soltá-lo, uma seta já mantida não move sozinha."),
            paragraph("Setas e 1 funcionam na área do jogo, no botão principal e na opção que conserva foco. Fora da tela original, a opção se chama ‘Teclado do jogo’. Ao perder esse foco, a nave para. Voltar por Tab conserva bloqueios; solte a tecla nos controles antes de pressionar novamente. Clicar na área rearma apenas as setas, sem mover nem liberar Enter."),
            paragraph("Especial só funciona na partida, com carga e nave normal, sem outro especial ativo. Uma pressão faz uma tentativa quando disponível; manter o botão ou a tecla não repete."),
            paragraph("Tab muda o foco dos botões; Espaço ativa o botão funcional focado. Enter/Espaço sobre Especial tentam o especial. Enter na área, no botão principal ou na opção retida executa a ação principal da tela. Espaço na opção fora da tela original não confirma."),
            paragraph("O contorno neutro mostra o foco; a nave mostra a opção selecionada. Solte Enter/Espaço nos controles antes de outra ação; uma tecla mantida não confirma a próxima tela.")))
        block.setId("controls-details")
        return block
    }

    private Button disclosureButton() {
        var idle = Style("outline: none; font-family: sans-serif; font-size: 14")
        var focused = Style("outline: 1px solid gray; font-family: sans-serif; font-size: 14")
        var button = Button("Mais detalhes", () -> { this.clicked() })
        button.setId("game-details")
        button.setStyle(idle)
        button.on("pointerdown", (e: Event) -> { this.pointerDown() })
        button.on("focus", (e: Event) -> { button.setStyle(focused) })
        button.on("blur", (e: Event) -> { this.blurred(); button.setStyle(idle) })
        return button
    }

    private Label heading(String text) {
        var label = Label(text)
        label.setStyle(Style("font-family: sans-serif; font-size: 16; line-height: 20px; font-weight: bold; color: #eeeeee"))
        return label
    }

    private Label paragraph(String text) {
        var label = Label(text)
        label.setStyle(Style("font-family: sans-serif; font-size: 14; line-height: 20px; color: #eeeeee; white-space: normal"))
        return label
    }

    private showDetailsState() {
        if (detailsState.expanded) { details.setStyle(contentStyle); disclosure.text = "Menos detalhes" }
        else { details.setStyle(hiddenStyle); disclosure.text = "Mais detalhes" }
    }

    clicked() {
        if (discardClick) { discardClick = false; return }
        toggle()
    }

    pointerDown() {
        discardClick = false
    }

    blurred() {
        discardClick = false
    }

    toggle() {
        detailsState.toggle()
        showDetailsState()
    }

    show() {
        root.setStyle(panelStyle)
    }

    close() {
        detailsState.close()
        showDetailsState()
        root.setStyle(hiddenStyle)
    }
}
