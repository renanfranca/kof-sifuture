package sifuture.game
import sifuture.game.Course
import sifuture.game.Overlap
import sifuture.game.ShipContact

enum SubchiefPhase { Inactive, Normal, Explosion }

class Subchief {
    SubchiefPhase phase = SubchiefPhase.Inactive
    Int x = 0
    Int y = 0
    Int endX = 0
    Int endY = 0
    Int lives = 30
    Int lifeTime = 0
    Int normalSteps = 0
    Int explosionSteps = 0
    Int explosionX = 0
    List<SubchiefShot> shots = listOf(SubchiefShot(), SubchiefShot(), SubchiefShot())

    public constructor() { }

    reset() {
        phase = SubchiefPhase.Inactive
        lives = 30
        lifeTime = 0
        normalSteps = 0
        explosionSteps = 0
        Int spawnRange = 200
        Int yRange = 164
        x = 220 + rng.int(spawnRange)
        y = 30 + rng.int(yRange)
        newDestination()
        for (var shot in shots) { shot.active = false }
    }

    private newDestination() {
        Int xRange = 60
        Int yRange = 164
        endX = 88 + rng.int(xRange)
        endY = 30 + rng.int(yRange)
    }

    touchesShip(Ship ship): Bool {
        return phase == SubchiefPhase.Normal && ship.phase == ShipPhase.Normal && bodyTouches(ship)
    }

    private bodyTouches(Ship ship): Bool {
        Bool topInside = edgeWithinShipHeight(y, ship.y) && bandsOverlap(x, 28, ship.x, Rules.SHIP_WIDTH)
        return topInside || (withinShipWidth(x, ship.x) && edgeWithinShipHeight(y + 26, ship.y))
    }

    damage(Int amount) {
        if (phase != SubchiefPhase.Normal) { return }
        lives = lives - amount
        if (lives <= 0) {
            phase = SubchiefPhase.Explosion
            explosionSteps = 0
            explosionX = x
        }
    }

    reward(): Int {
        if (lifeTime <= 30) { return 600 }
        if (lifeTime <= 60) { return 300 }
        return 150
    }

    advance() {
        advanceExplosion()
        advanceNormal()
        advanceShots()
    }

    advanceExplosion() {
        if (phase != SubchiefPhase.Explosion) { return }
        explosionSteps = explosionSteps + 1
        if (explosionSteps >= 3) {
            var previousFrame = (explosionSteps - 1) / 3
            var displacement = 1
            if (previousFrame >= 4) { displacement = 2 }
            if (previousFrame >= 6) { displacement = 3 }
            if (previousFrame >= 8) { displacement = 5 }
            explosionX = explosionX - displacement
        }
        if (explosionSteps == 30) { reset() }
    }

    advanceNormal() {
        if (phase != SubchiefPhase.Normal) { return }
        x = stepToward(x, endX)
        y = stepToward(y, endY)
        if (x == endX && y == endY) { newDestination() }
        normalSteps = normalSteps + 1
        if (normalSteps % 12 == 0) { fireShot() }
        if (normalSteps == 36) { lifeTime = lifeTime + 1; normalSteps = 0 }
    }

    private fireShot() {
        for (var shot in shots) {
            if (!shot.active) { shot.fire(x, y); return }
        }
    }

    advanceShots() {
        for (var shot in shots) { shot.advance() }
    }
}
