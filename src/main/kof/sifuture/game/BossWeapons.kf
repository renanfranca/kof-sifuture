package sifuture.game

class BossWeapons {
    Int level = 0
    Int fireSteps = 0
    Int attempts = 0
    Bool specialReady = false
    BossSpecial special = BossSpecial()
    List<BossShot> shots = listOf(BossShot(), BossShot())

    public constructor() { }

    reset() {
        level = 0
        fireSteps = 0
        attempts = 0
        specialReady = false
        special.reset()
        for (var shot in shots) { shot.reset() }
    }

    evolve() {
        level = level + 1
        for (var shot in shots) { shot.animated = true }
    }

    attemptFire(Int x, Int y) {
        if (specialDue()) { special.fire(x, y) }
        fireSteps = fireSteps + 1
        if (fireSteps >= fireInterval()) { fireVolley(x, y) }
    }

    private fireVolley(Int x, Int y) {
        fireSteps = 0
        fireFreeShot(x, y)
        if (level > 0) { countTowardSpecial() }
    }

    private fireFreeShot(Int x, Int y) {
        var capacity = if (level > 0) 2 else 1
        for (var i = 0; i < capacity; i++) {
            if (!shots[i].active) { shots[i].fire(x, y); return }
        }
    }

    private countTowardSpecial() {
        attempts = attempts + 1
        if (attempts == 4) { specialReady = true; attempts = 0 }
        else { specialReady = false }
    }

    private specialDue(): Bool {
        return (level == 2 && fireSteps > 10 && specialReady) ||
            (level == 3 && specialReady) || (level == 4 && fireSteps > 4)
    }

    private fireInterval(): Int {
        if (level >= 3) { return 24 }
        if (level == 1 || level == 2) { return 31 }
        return 13
    }

    hitShip(Ship ship) {
        for (var shot in shots) {
            if (shot.touchesShip(ship)) { ship.explode(); shot.active = false; break }
        }
        if (special.touchesShip(ship)) { ship.explode(); special.reset() }
    }

    advance(Bool existingSpecial) {
        for (var shot in shots) { shot.advance() }
        if (existingSpecial) { special.advance() }
    }
}
