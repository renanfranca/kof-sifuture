package sifuture.game
import sifuture.game.DirectionInput
import sifuture.game.Match

class Game {
    Screen screen = Screen.Credits
    Int pauseSelection = 0
    Int menuSelection = 0
    Credits credits = Credits()
    MenuEntrance menuEntrance = MenuEntrance()
    Ship ship = Ship()
    Background background = Background()
    List<Item> items = listOf(Item(ItemKind.Evolution), Item(ItemKind.Life))
    Int displayedScore = 0
    Int score = 0
    Int steps = 0
    Int stageSteps = 0
    Subchief subchief = Subchief()
    Boss boss = Boss()
    List<Meteor> meteors = listOf(Meteor(), Meteor(), Meteor(), Meteor(), Meteor(), Meteor(), Meteor(), Meteor())
    Weapons weapons = Weapons()
    DirectionInput input = DirectionInput()

    public constructor() {
        meteors[6].motion = MeteorMotion.Vertical
        meteors[7].motion = MeteorMotion.Vertical
    }

    clearMovement() {
        input.clearPad(ship)
    }

    clearKeyboard() {
        input.releaseKeyboard(ship)
    }

    rearmKeyboard() {
        input.rearmKeyboard(ship)
    }

    keyboard(Direction direction, Bool pressed) {
        this.keyboard(direction, pressed, true)
    }

    keyboard(Direction direction, Bool pressed, Bool movementAllowed) {
        if (!input.keyChanged(direction, pressed) || !movementAllowed) { return }
        if (pressed) { navigate(direction) }
        if (screen == Screen.Play) { input.steerByKeyboard(ship, direction, pressed) }
    }

    padPressed(): Bool {
        return input.pad.any()
    }

    movement(Direction direction, Bool pressed) {
        if (!pressed) { input.releaseMenuArrow(direction) }
        if (screen == Screen.Menu || screen == Screen.Pause) {
            if (input.menuArrowPressed(direction, pressed)) { navigate(direction) }
            return
        }
        if (pressed && screen != Screen.Play) { return }
        input.steerByPad(ship, direction, pressed)
    }

    start(Int seed) {
        menuEntrance.finish()
        clearMovement()
        rng.seed(seed)
        screen = Screen.Play
        resetMatch(this)
    }

    navigate(Direction direction) {
        var offset = 0
        if (direction == Direction.Up) { offset = -1 }
        if (direction == Direction.Down) { offset = 1 }
        if (screen == Screen.Pause) { pauseSelection = math.clamp(pauseSelection + offset, 0, 2) }
        if (screen == Screen.Menu) { menuSelection = math.clamp(menuSelection + offset, 0, 1) }
    }

    openControls() {
        if (screen == Screen.Menu) { menuEntrance.finish(); screen = Screen.Controls; clearMovement() }
    }

    confirm() {
        Int seedBound = Rules.RANDOM_SEED_BOUND
        this.confirm(random.int(seedBound))
    }

    confirm(Int seed) {
        if (screen == Screen.Credits) { enterMenu(0) }
        else if (screen == Screen.Menu) { confirmMenu(seed) }
        else if (screen == Screen.Controls) { enterMenu(menuSelection) }
        else if (screen == Screen.Play) { pause() }
        else if (screen == Screen.Pause) { confirmPause(seed) }
        else if (screen == Screen.Result) { confirmResult() }
    }

    private confirmMenu(Int seed) {
        if (menuSelection == 0) { start(seed) }
        else { openControls() }
    }

    private confirmPause(Int seed) {
        if (pauseSelection == 0) { resume() }
        else if (pauseSelection == 1) { restart(seed) }
        else { abandon() }
    }

    private confirmResult() {
        if (!countComplete()) { displayedScore = score }
        else { enterMenu(0) }
    }

    private enterMenu(Int selection) {
        if (screen == Screen.Menu) { return }
        screen = Screen.Menu
        menuSelection = selection
        menuEntrance = MenuEntrance()
        clearMovement()
    }

    abandon() {
        if (screen == Screen.Pause) {
            enterMenu(0)
        }
    }

    restart(Int seed) {
        if (screen == Screen.Pause) { start(seed) }
    }

    pause() {
        if (screen == Screen.Play) { screen = Screen.Pause; pauseSelection = 0; clearMovement() }
    }

    resume() {
        if (screen == Screen.Pause) { screen = Screen.Play; clearMovement() }
    }

    step() {
        if (screen == Screen.Menu) { menuEntrance.advance() }
        else if (screen == Screen.Credits) { advanceCredits() }
        else if (screen == Screen.Result) { advanceResult(this) }
        else if (screen == Screen.Play) { advancePlay(this) }
    }

    private advanceCredits() {
        if (credits.advance()) { enterMenu(0) }
    }

    canSpecial(): Bool {
        return screen == Screen.Play && ship.phase == ShipPhase.Normal && weapons.canSpecial()
    }

    trySpecial(): Bool {
        if (!canSpecial()) { return false }
        return weapons.fireSpecial(ship)
    }

    finish() {
        screen = Screen.Result
        displayedScore = 0
        clearMovement()
    }

    countComplete(): Bool { return displayedScore == score }

    stagePosition(): Int {
        Int width = Rules.WORLD_WIDTH
        return math.min(5 + stageSteps / 10, width)
    }

    resultIndex(): Int {
        if (score < Rules.RESULT_GOOD) { return 0 }
        if (score < Rules.RESULT_GREAT) { return 1 }
        if (score < Rules.RESULT_BEST) { return 2 }
        return 3
    }
}
