package sifuture.game

class Game {
    Screen screen = Screen.Menu
    Ship ship = Ship()
    Int score = 0
    Int steps = 0
    List<Meteor> meteors = listOf(Meteor(), Meteor(), Meteor(), Meteor(), Meteor(), Meteor())
    Lasers lasers = Lasers()
    Zone activeZone = Zone.Neutral
    Bool heldLeft = false
    Bool heldRight = false
    Bool heldUp = false
    Bool heldDown = false

    clearMovement() {
        activeZone = Zone.Neutral
        ship.clearInput()
    }

    clearKeyboard() {
        if (activeZone == Zone.Neutral) { ship.clearInput() }
    }

    keyboard(Direction direction, Bool pressed) {
        this.keyboard(direction, pressed, true)
    }

    keyboard(Direction direction, Bool pressed, Bool movementAllowed) {
        var held = false
        if (direction == Direction.Left) { held = heldLeft }
        if (direction == Direction.Right) { held = heldRight }
        if (direction == Direction.Up) { held = heldUp }
        if (direction == Direction.Down) { held = heldDown }
        if (held == pressed) { return }
        if (direction == Direction.Left) { heldLeft = pressed }
        if (direction == Direction.Right) { heldRight = pressed }
        if (direction == Direction.Up) { heldUp = pressed }
        if (direction == Direction.Down) { heldDown = pressed }
        if (screen == Screen.Play && activeZone == Zone.Neutral && movementAllowed) { ship.direction(direction, pressed) }
    }

    movement(Zone zone, Bool pressed) {
        if (pressed) {
            if (screen != Screen.Play || zone == Zone.Neutral || activeZone != Zone.Neutral) { return }
            activeZone = zone
            ship.clearInput()
            ship.direction(Direction.Left, zone == Zone.NorthWest || zone == Zone.West || zone == Zone.SouthWest)
            ship.direction(Direction.Right, zone == Zone.NorthEast || zone == Zone.East || zone == Zone.SouthEast)
            ship.direction(Direction.Up, zone == Zone.NorthWest || zone == Zone.North || zone == Zone.NorthEast)
            ship.direction(Direction.Down, zone == Zone.SouthWest || zone == Zone.South || zone == Zone.SouthEast)
        } else if (activeZone == zone) {
            activeZone = Zone.Neutral
            ship.clearInput()
        }
    }

    start(Int seed) {
        clearMovement()
        rng.seed(seed)
        screen = Screen.Play
        ship.reset()
        score = 0
        steps = 0
        lasers.reset()
        for (var m in meteors) { m.reset() }
    }

    confirm() {
        if (screen == Screen.Menu) {
            Int seedBound = Rules.RANDOM_SEED_BOUND
            start(random.int(seedBound))
        }
        else if (screen == Screen.Play) { pause() }
        else if (screen == Screen.Pause) { resume() }
        else if (screen == Screen.Result) { screen = Screen.Menu; clearMovement() }
    }

    pause() {
        if (screen == Screen.Play) { screen = Screen.Pause; clearMovement() }
    }

    resume() {
        if (screen == Screen.Pause) { screen = Screen.Play; clearMovement() }
    }

    step() {
        if (screen != Screen.Play) { return }
        steps = steps + 1
        var normalBefore = ship.phase == ShipPhase.Normal
        ship.advance()
        if (ship.lives == 0) {
            screen = Screen.Result
            clearMovement()
            return
        }

        if (normalBefore) { lasers.attemptFire(ship) }
        lasers.advance()

        var shipCanCollide = ship.phase == ShipPhase.Normal
        var shipCollision = false
        for (var m in meteors) {
            var wasCollided = m.collided
            m.advance()
            if (!wasCollided && !m.collided) {
                if (shipCanCollide && m.touchesShip(ship.x, ship.y)) {
                    if (!shipCollision) {
                        score = score + Rules.COLLISION_SCORE
                        ship.explode()
                        shipCollision = true
                    }
                    m.collide()
                }
                if (!m.collided) {
                    for (var s in lasers.shots) {
                        if (s.active && !s.impact && s.hitsMeteor(m)) {
                            s.impactAt(m)
                            score = score + Rules.COLLISION_SCORE
                            m.collide()
                        }
                    }
                }
            }
        }
    }

    resultIndex(): Int {
        if (score < Rules.RESULT_GOOD) { return 0 }
        if (score < Rules.RESULT_GREAT) { return 1 }
        if (score < Rules.RESULT_BEST) { return 2 }
        return 3
    }
}
