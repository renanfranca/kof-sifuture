package sifuture.game

class Game {
    Screen screen = Screen.Menu
    Ship ship = Ship()
    Background background = Background()
    List<Item> items = listOf(Item(ItemKind.Evolution), Item(ItemKind.Life))
    Int displayedScore = 0
    Int score = 0
    Int steps = 0
    Int stageSteps = 0
    Subchief subchief = Subchief()
    Boss boss = Boss()
    List<Meteor> meteors = listOf(Meteor(), Meteor(), Meteor(), Meteor(), Meteor(), Meteor(), Meteor(), Meteor())
    Weapons weapons = Weapons()
    Bool padLeft = false
    Bool padRight = false
    Bool padUp = false
    Bool padDown = false
    Bool heldLeft = false
    Bool heldRight = false
    Bool heldUp = false
    Bool heldDown = false

    public constructor() {
        meteors[6].motion = MeteorMotion.Vertical
        meteors[6].active = false
        meteors[7].motion = MeteorMotion.Vertical
        meteors[7].active = false
    }

    clearMovement() {
        padLeft = false
        padRight = false
        padUp = false
        padDown = false
        ship.clearInput()
    }

    clearKeyboard() {
        if (!padPressed()) { ship.clearInput() }
    }

    rearmKeyboard() {
        heldLeft = false
        heldRight = false
        heldUp = false
        heldDown = false
        if (!padPressed()) { ship.clearInput() }
    }

    keyboard(Direction direction, Bool pressed) {
        this.keyboard(direction, pressed, true)
    }

    keyboard(Direction direction, Bool pressed, Bool movementAllowed) {
        var held = false
        if (direction == Direction.Left) { held = heldLeft }
        if (direction == Direction.Right) { held = heldRight }
        if (direction == Direction.Up) { held = heldUp }
        if (direction == Direction.Down) { held = heldDown }
        if (held == pressed) { return }
        if (direction == Direction.Left) { heldLeft = pressed }
        if (direction == Direction.Right) { heldRight = pressed }
        if (direction == Direction.Up) { heldUp = pressed }
        if (direction == Direction.Down) { heldDown = pressed }
        if (screen == Screen.Play && !padPressed() && movementAllowed) { ship.direction(direction, pressed) }
    }

    padPressed(): Bool {
        return padLeft || padRight || padUp || padDown
    }

    movement(Direction direction, Bool pressed) {
        var held = false
        if (direction == Direction.Left) { held = padLeft }
        if (direction == Direction.Right) { held = padRight }
        if (direction == Direction.Up) { held = padUp }
        if (direction == Direction.Down) { held = padDown }
        if (held == pressed || (pressed && screen != Screen.Play)) { return }
        if (pressed && !padPressed()) { ship.clearInput() }
        if (direction == Direction.Left) { padLeft = pressed }
        if (direction == Direction.Right) { padRight = pressed }
        if (direction == Direction.Up) { padUp = pressed }
        if (direction == Direction.Down) { padDown = pressed }
        ship.direction(direction, pressed)
    }

    start(Int seed) {
        clearMovement()
        rng.seed(seed)
        screen = Screen.Play
        ship.reset()
        score = 0
        displayedScore = 0
        steps = 0
        stageSteps = 0
        background.reset()
        weapons.reset()
        for (var m in meteors) { m.reset() }
        for (var item in items) { item.reset() }
        subchief.reset()
        boss.reset()
    }

    confirm() {
        if (screen == Screen.Menu) {
            Int seedBound = Rules.RANDOM_SEED_BOUND
            start(random.int(seedBound))
        }
        else if (screen == Screen.Play) { pause() }
        else if (screen == Screen.Pause) { resume() }
        else if (screen == Screen.Result) {
            if (!countComplete()) { displayedScore = score }
            else { screen = Screen.Menu; clearMovement() }
        }
    }

    pause() {
        if (screen == Screen.Play) { screen = Screen.Pause; clearMovement() }
    }

    resume() {
        if (screen == Screen.Pause) { screen = Screen.Play; clearMovement() }
    }

    step() {
        if (screen == Screen.Result) {
            subchief.advance()
            boss.advance()
            background.advance()
            for (var item in items) { item.advance() }
            ship.advanceVisual()
            if (ship.lives > 0 && (ship.phase == ShipPhase.Normal || ship.phase == ShipPhase.Hidden)) { weapons.attemptFire(ship) }
            weapons.advance()
            if (subchief.phase == SubchiefPhase.Inactive && boss.phase == BossPhase.Inactive && stagePosition() > 30 && !meteors[6].active && !meteors[7].active) {
                meteors[6].active = true
                meteors[7].active = true
            }
            for (var m in meteors) { m.advance() }
            displayedScore = displayedScore + Rules.COLLISION_SCORE
            if (displayedScore > score) { displayedScore = score }
            return
        }
        if (screen != Screen.Play) { return }
        steps = steps + 1
        if (subchief.phase == SubchiefPhase.Inactive && boss.phase == BossPhase.Inactive) {
            stageSteps = stageSteps + 1
            if (stagePosition() == 88) {
                subchief.phase = SubchiefPhase.Normal
                stageSteps = stageSteps + 10
            }
            if (stagePosition() == 146) {
                boss.phase = BossPhase.Normal
                stageSteps = stageSteps + 10
            }
        }
        background.advance()
        for (var item in items) { item.advance() }
        var normalBefore = ship.phase == ShipPhase.Normal
        var livesBefore = ship.lives
        ship.advance()
        if (ship.lives < livesBefore) { weapons.loseOnDeath() }
        if (ship.lives == 0) {
            subchief.advance()
            boss.advance()
            finish()
            return
        }

        if (normalBefore) { weapons.attemptFire(ship) }
        weapons.advance()

        for (var item in items) {
            if (item.collect(ship)) {
                score = score + 10
                if (item.kind == ItemKind.Life) { ship.lives = ship.lives + 1 }
                else { weapons.evolve() }
            }
        }

        var chiefPhaseBeforeContacts = subchief.phase
        if (subchief.touchesShip(ship)) {
            ship.explode()
            subchief.damage(1)
        }
        weapons.hitSubchiefLaser(subchief)
        weapons.hitSubchiefBlaster(subchief)
        weapons.hitSubchiefSpecial(subchief)
        if (chiefPhaseBeforeContacts == SubchiefPhase.Normal && subchief.phase == SubchiefPhase.Explosion) { score = score + subchief.reward() }
        for (var shot in subchief.shots) {
            if (shot.touchesShip(ship)) { ship.explode(); shot.active = false; break }
        }
        if (chiefPhaseBeforeContacts == SubchiefPhase.Explosion) { subchief.advanceExplosion() }
        subchief.advanceNormal()
        subchief.advanceShots()
        if (subchief.phase == SubchiefPhase.Inactive && boss.phase == BossPhase.Inactive && stagePosition() > 30 && !meteors[6].active && !meteors[7].active) {
            meteors[6].active = true
            meteors[7].active = true
        }
        var targets = listOf<Meteor>()
        for (var m in meteors) {
            var wasCollided = m.collided
            m.advance()
            if (m.active && !wasCollided && !m.collided) { targets.add(m) }
        }
        var bossPhaseBeforeContacts = boss.phase
        if (boss.touchesShip(ship)) { ship.explode(); boss.damage(1) }
        weapons.hitBossLaser(boss)
        weapons.hitBossBlaster(boss)
        weapons.hitBossSpecial(boss)
        if (bossPhaseBeforeContacts != BossPhase.Explosion && boss.phase == BossPhase.Explosion) { score = score + boss.reward() }
        boss.absorbMeteors(targets)
        boss.weapons.hitShip(ship)
        boss.advance(bossPhaseBeforeContacts == BossPhase.Explosion)

        var shipCanCollide = ship.phase == ShipPhase.Normal
        var shipCollision = false
        for (var m in targets) {
            if (!m.collided && shipCanCollide && m.touchesShip(ship.x, ship.y)) {
                if (!shipCollision) {
                    score = score + Rules.COLLISION_SCORE
                    ship.explode()
                    shipCollision = true
                }
                m.collide()
            }
        }
        if (weapons.hitLaser(targets)) { score = score + Rules.COLLISION_SCORE }
        if (weapons.hitBlaster(targets)) { score = score + Rules.COLLISION_SCORE }
        if (weapons.hitSpecial(targets)) { score = score + Rules.COLLISION_SCORE }
        if (stagePosition() == Rules.WORLD_WIDTH) { finish() }
    }

    canSpecial(): Bool {
        return screen == Screen.Play && ship.phase == ShipPhase.Normal && weapons.canSpecial()
    }

    trySpecial(): Bool {
        if (!canSpecial()) { return false }
        return weapons.fireSpecial(ship)
    }

    private finish() {
        screen = Screen.Result
        displayedScore = 0
        clearMovement()
    }

    countComplete(): Bool { return displayedScore == score }

    stagePosition(): Int {
        var position = 5 + stageSteps / 10
        if (position > Rules.WORLD_WIDTH) { return Rules.WORLD_WIDTH }
        return position
    }

    resultIndex(): Int {
        if (score < Rules.RESULT_GOOD) { return 0 }
        if (score < Rules.RESULT_GREAT) { return 1 }
        if (score < Rules.RESULT_BEST) { return 2 }
        return 3
    }
}
