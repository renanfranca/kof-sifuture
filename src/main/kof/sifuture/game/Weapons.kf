package sifuture.game

class Weapons {
    Int level = 0
    Int charges = 0
    Int fireSteps = 0
    Int laserAttempts = 0
    Lasers lasers = Lasers()
    Blaster blaster = Blaster()
    List<SpecialBeam> beams = listOf(SpecialBeam(0), SpecialBeam(1), SpecialBeam(2))

    reset() {
        level = 0
        charges = 0
        fireSteps = 0
        lasers.reset()
        blaster.reset()
        laserAttempts = 0
        for (var beam in beams) { beam.reset() }
    }

    evolve() {
        if (level < 3) { level = level + 1 }
        else { charges = charges + 1 }
    }

    loseOnDeath() {
        if (charges > 0) { charges = charges - 1 }
        else if (level > 0) { level = level - 1 }
    }

    attemptFire(Ship ship) {
        if (blasterDue()) { blaster.fire(ship) }
        fireSteps = fireSteps + 1
        if (fireSteps != Rules.LASER_INTERVAL) { return }
        fireSteps = 0
        fireLaser(ship)
    }

    private blasterDue(): Bool {
        Bool laserCycleDone = laserAttempts > 0 && laserAttempts % 6 == 0
        return (level == 2 && fireSteps > 10 && laserCycleDone) || (level == 3 && fireSteps > 4)
    }

    private fireLaser(Ship ship) {
        if (level == 0) { lasers.shots[0].fire(ship.x, ship.y); return }
        laserAttempts = laserAttempts + 1
        for (var shot in lasers.shots) {
            if (!shot.active) { shot.fire(ship.x, ship.y); shot.animated = true; return }
        }
    }

    hitLaser(List<Meteor> meteors): Bool {
        for (var shot in lasers.shots) {
            if (shot.active && !shot.impact && laserHitsMeteor(shot, meteors)) { return true }
        }
        return false
    }

    private laserHitsMeteor(Shot shot, List<Meteor> meteors): Bool {
        for (var meteor in meteors) {
            if (!meteor.collided && shot.hitsMeteor(meteor)) { shot.impactAt(meteor); meteor.collide(); return true }
        }
        return false
    }

    hitBlaster(List<Meteor> meteors): Bool {
        for (var meteor in meteors) {
            if (!meteor.collided && blaster.hitsMeteor(meteor)) {
                blaster.hit()
                meteor.collide()
                return true
            }
        }
        return false
    }

    hitSpecial(List<Meteor> meteors): Bool {
        for (var beam in beams) {
            if (beamHitsMeteor(beam, meteors)) { return true }
        }
        return false
    }

    private beamHitsMeteor(SpecialBeam beam, List<Meteor> meteors): Bool {
        for (var meteor in meteors) {
            if (!meteor.collided && beam.hitsMeteor(meteor)) { beam.hit(); meteor.collide(); return true }
        }
        return false
    }

    hitSubchiefLaser(Subchief chief) {
        if (chief.phase == SubchiefPhase.Normal && laserStrikes(chief.x, chief.y, 28, 26)) { chief.damage(1) }
    }

    hitSubchiefBlaster(Subchief chief) {
        if (chief.phase == SubchiefPhase.Normal && blaster.hitsSubchief(chief)) { chief.damage(blaster.spend()) }
    }

    hitSubchiefSpecial(Subchief chief) {
        var contact = false
        for (var beam in beams) {
            if (beam.beginsSubchiefContact(chief)) { contact = true; break }
        }
        if (!contact) { return }
        for (var beam in beams) {
            if (beam.contactSteps > 0) { chief.damage(1) }
        }
        for (var beam in beams) { if (beam.contactSteps > 0) { beam.hit() } }
    }

    hitBossLaser(Boss boss) {
        if (!boss.vulnerable() || !laserStrikes(boss.x, boss.y, 40, 51)) { return }
        boss.damage(1)
        boss.evolveWeapons()
    }

    private laserStrikes(Int left, Int top, Int width, Int height): Bool {
        for (var shot in lasers.shots) {
            if (shot.strikes(left, top, width, height)) { shot.impactAt(left, top); return true }
        }
        return false
    }

    hitBossBlaster(Boss boss) {
        if (!boss.vulnerable() || !blaster.hitsBoss(boss)) { return }
        boss.damage(blaster.spend())
        boss.evolveWeapons()
    }

    hitBossSpecial(Boss boss) {
        var contact = false
        for (var beam in beams) {
            if (beam.beginsBossContact(boss)) { contact = true; break }
        }
        if (!contact) { return }
        for (var beam in beams) {
            if (beam.contactSteps > 0) { boss.damage(1) }
        }
        for (var beam in beams) { if (beam.contactSteps > 0) { beam.hit() } }
        boss.evolveWeapons()
    }

    canSpecial(): Bool {
        if (charges == 0) { return false }
        for (var beam in beams) { if (beam.active) { return false } }
        return true
    }

    fireSpecial(Ship ship): Bool {
        if (!canSpecial()) { return false }
        for (var beam in beams) { beam.fire(ship) }
        charges = charges - 1
        return true
    }

    advance() {
        lasers.advance()
        blaster.advance()
        for (var beam in beams) { beam.advance() }
    }
}
