package sifuture.game

class Weapons {
    Int level = 0
    Int charges = 0
    Int fireSteps = 0
    Int laserAttempts = 0
    Lasers lasers = Lasers()
    Blaster blaster = Blaster()
    List<SpecialBeam> beams = listOf(SpecialBeam(0), SpecialBeam(1), SpecialBeam(2))

    reset() {
        level = 0
        charges = 0
        fireSteps = 0
        lasers.reset()
        blaster.reset()
        laserAttempts = 0
        for (var beam in beams) { beam.reset() }
    }

    evolve() {
        if (level < 3) { level = level + 1 }
        else { charges = charges + 1 }
    }

    loseOnDeath() {
        if (charges > 0) { charges = charges - 1 }
        else if (level > 0) { level = level - 1 }
    }

    attemptFire(Ship ship) {
        if (level == 2 && fireSteps > 10 && laserAttempts > 0 && laserAttempts % 6 == 0) { blaster.fire(ship) }
        if (level == 3 && fireSteps > 4) { blaster.fire(ship) }
        fireSteps = fireSteps + 1
        if (fireSteps == Rules.LASER_INTERVAL) {
            fireSteps = 0
            if (level == 0) { lasers.shots[0].fire(ship.x, ship.y) }
            else {
                laserAttempts = laserAttempts + 1
                for (var shot in lasers.shots) {
                    if (!shot.active) {
                        shot.fire(ship.x, ship.y)
                        shot.animated = true
                        break
                    }
                }
            }
        }
    }

    hitLaser(List<Meteor> meteors): Bool {
        for (var shot in lasers.shots) {
            for (var meteor in meteors) {
                if (!meteor.collided && shot.active && !shot.impact && shot.hitsMeteor(meteor)) {
                    shot.impactAt(meteor)
                    meteor.collide()
                    return true
                }
            }
        }
        return false
    }

    hitBlaster(List<Meteor> meteors): Bool {
        for (var meteor in meteors) {
            if (!meteor.collided && blaster.hitsMeteor(meteor)) {
                blaster.hit()
                meteor.collide()
                return true
            }
        }
        return false
    }

    hitSpecial(List<Meteor> meteors): Bool {
        for (var beam in beams) {
            for (var meteor in meteors) {
                if (!meteor.collided && beam.hitsMeteor(meteor)) {
                    beam.hit()
                    meteor.collide()
                    return true
                }
            }
        }
        return false
    }

    hitSubchiefLaser(Subchief chief): Bool {
        if (chief.phase != SubchiefPhase.Normal) { return false }
        for (var shot in lasers.shots) {
            if (shot.active && !shot.impact && shot.x + Rules.LASER_WIDTH >= chief.x &&
                shot.x + Rules.LASER_WIDTH <= chief.x + 28 &&
                ((shot.y >= chief.y && shot.y <= chief.y + 26) ||
                 (shot.y + Rules.LASER_HEIGHT >= chief.y && shot.y + Rules.LASER_HEIGHT <= chief.y + 26))) {
                shot.x = chief.x
                shot.y = chief.y
                shot.impact = true
                return chief.damage(1)
            }
        }
        return false
    }

    hitSubchiefBlaster(Subchief chief): Bool {
        if (chief.phase != SubchiefPhase.Normal || !blaster.active || blaster.lives <= 0) { return false }
        if (chief.x >= blaster.x && chief.x <= blaster.x + 68 &&
            ((chief.y >= blaster.y && chief.y <= blaster.y + 21) ||
             (chief.y + 26 >= blaster.y && chief.y + 26 <= blaster.y + 21))) {
            var damage = blaster.lives
            blaster.lives = 0
            return chief.damage(damage)
        }
        return false
    }

    hitSubchiefSpecial(Subchief chief): Bool {
        var contact = false
        for (var beam in beams) {
            if (beam.beginsSubchiefContact(chief)) { contact = true; break }
        }
        if (!contact) { return false }
        var fatal = false
        for (var beam in beams) {
            if (beam.contactSteps > 0 && !fatal) { fatal = chief.damage(1) }
        }
        for (var beam in beams) { if (beam.contactSteps > 0) { beam.hit() } }
        return fatal
    }

    hitBossLaser(Boss boss) {
        if (!boss.vulnerable()) { return }
        for (var shot in lasers.shots) {
            if (shot.active && !shot.impact && shot.x + Rules.LASER_WIDTH >= boss.x &&
                shot.x + Rules.LASER_WIDTH <= boss.x + 40 &&
                ((shot.y >= boss.y && shot.y <= boss.y + 51) ||
                 (shot.y + Rules.LASER_HEIGHT >= boss.y && shot.y + Rules.LASER_HEIGHT <= boss.y + 51))) {
                shot.x = boss.x
                shot.y = boss.y
                shot.impact = true
                boss.damage(1)
                boss.evolveWeapons()
                return
            }
        }
    }

    hitBossBlaster(Boss boss) {
        if (!boss.vulnerable() || !blaster.active || blaster.lives <= 0) { return }
        if (blaster.x + 68 >= boss.x && blaster.x + 68 <= boss.x + 40 &&
            ((blaster.y >= boss.y && blaster.y <= boss.y + 51) ||
             (blaster.y + 21 >= boss.y && blaster.y + 21 <= boss.y + 51))) {
            var damage = blaster.lives
            blaster.lives = 0
            boss.damage(damage)
            boss.evolveWeapons()
        }
    }

    hitBossSpecial(Boss boss) {
        var contact = false
        for (var beam in beams) {
            if (beam.beginsBossContact(boss)) { contact = true; break }
        }
        if (!contact) { return }
        for (var beam in beams) {
            if (beam.contactSteps > 0) { boss.damage(1) }
        }
        for (var beam in beams) { if (beam.contactSteps > 0) { beam.hit() } }
        boss.evolveWeapons()
    }

    canSpecial(): Bool {
        if (charges == 0) { return false }
        for (var beam in beams) { if (beam.active) { return false } }
        return true
    }

    fireSpecial(Ship ship): Bool {
        if (!canSpecial()) { return false }
        for (var beam in beams) { beam.fire(ship) }
        charges = charges - 1
        return true
    }

    advance() {
        lasers.advance()
        blaster.advance()
        for (var beam in beams) { beam.advance() }
    }
}
