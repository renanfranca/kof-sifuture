package sifuture.game
import sifuture.game.ShipContact

class SubchiefShot {
    Int x = 0
    Int y = 0
    Bool active = false

    public constructor() { }

    fire(Int chiefX, Int chiefY) {
        active = true
        x = chiefX - 7
        y = chiefY + 13
    }

    touchesShip(Ship ship): Bool {
        return active && ship.phase == ShipPhase.Normal && edgeTouchesShip(x, y, 4, ship)
    }

    advance() {
        if (!active) { return }
        x = x - 4
        if (x < -30) { active = false }
    }
}
