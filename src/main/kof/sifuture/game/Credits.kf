package sifuture.game

class Credits {
    Int x = -Rules.CREDITS_WIDTH
    Int firstY = 40
    Int secondY = 136
    Int waitSteps = 0
    Bool exitComplete = false

    public constructor() { }

    advance(): Bool {
        if (exitComplete) { return true }
        if (x < Rules.CREDITS_MARGIN) {
            Int margin = Rules.CREDITS_MARGIN
            x = math.min(x + 5, margin)
        }
        else if (waitSteps < Rules.CREDITS_WAIT_STEPS) { waitSteps = waitSteps + 1 }
        else if (firstY < Rules.CREDITS_HEIGHT) {
            firstY = firstY + 1
            secondY = secondY - 1
        }
        else { exitComplete = true }
        return false
    }
}
