package sifuture.game

class Credits {
    Int x = -Rules.CREDITS_WIDTH
    Int firstY = 40
    Int secondY = 136
    Int waitSteps = 0
    Bool exitComplete = false

    public constructor() { }

    advance(): Bool {
        if (exitComplete) { return true }
        if (x < Rules.CREDITS_MARGIN) {
            x = x + 5
            if (x > Rules.CREDITS_MARGIN) { x = Rules.CREDITS_MARGIN }
        }
        else if (waitSteps < Rules.CREDITS_WAIT_STEPS) { waitSteps = waitSteps + 1 }
        else if (firstY < Rules.CREDITS_HEIGHT || secondY > -Rules.CREDITS_BLOCK_HEIGHT) {
            firstY = firstY + 1
            secondY = secondY - 1
        }
        else { exitComplete = true }
        return false
    }
}
