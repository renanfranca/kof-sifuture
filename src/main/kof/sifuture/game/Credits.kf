package sifuture.game

class Credits {
    Int x = -134
    Int firstY = 110
    Int secondY = 141
    Int waitSteps = 0

    public constructor() { }

    advance(): Bool {
        if (x < Rules.WORLD_WIDTH / 4) { x = x + 5 }
        else if (waitSteps < 50) { waitSteps = waitSteps + 1 }
        else if (secondY >= -31 || firstY <= Rules.WORLD_HEIGHT) {
            firstY = firstY + 1
            secondY = secondY - 1
        }
        else { return true }
        return false
    }
}
