package sifuture.game
import sifuture.game.Overlap

class Blaster {
    Int x = 0
    Int y = 0
    Int flightSteps = 0
    Int lives = 2
    Int impactSteps = 0
    Bool active = false

    reset() {
        active = false
        flightSteps = 0
        lives = 2
        impactSteps = 0
    }

    fire(Ship ship) {
        if (active) { return }
        reset()
        active = true
        x = ship.x
        y = ship.y
    }

    spriteFrame(): Int {
        if (flightSteps < 2) { return 0 }
        if (flightSteps > 4) { return 4 }
        return flightSteps - 1
    }

    armed(): Bool { return active && lives > 0 }

    hitsMeteor(Meteor m): Bool {
        return armed() && m.x >= x && m.x <= x + 68 &&
            m.y + Rules.METEOR_HEIGHT >= y && m.y <= y + 21
    }

    hitsSubchief(Subchief chief): Bool {
        return armed() && chief.x >= x && chief.x <= x + 68 && (spans(chief.y) || spans(chief.y + 26))
    }

    private spans(Int edgeY): Bool { return edgeY >= y && edgeY <= y + 21 }

    hitsBoss(Boss boss): Bool {
        Int front = x + 68
        return armed() && front >= boss.x && front <= boss.x + 40 && bandsOverlap(y, 21, boss.y, 51)
    }

    spend(): Int {
        var damage = lives
        lives = 0
        return damage
    }

    hit() { lives = lives - 1 }

    advance() {
        if (!active) { return }
        if (lives > 0) { advanceFlight() }
        else { advanceImpact() }
    }

    advanceFlight() {
        if (flightSteps == 3) { x = x + 3 }
        else { x = x + 5 }
        flightSteps = flightSteps + 1
        if (x > Rules.WORLD_WIDTH) { reset() }
    }

    advanceImpact() {
        if (impactSteps < 2) { x = x + 2 }
        if (impactSteps == 2) { x = x + 3 }
        impactSteps = impactSteps + 1
        if (impactSteps == 4) { reset() }
    }
}
