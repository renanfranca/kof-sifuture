package sifuture.game

enum BossPhase { Inactive, Normal, Fury, Frenzy, Explosion }

class Boss {
    BossPhase phase = BossPhase.Inactive
    Int frenzySteps = 0
    Int lifeTime = 0
    Int normalSteps = 0
    Int explosionSteps = 0
    Int explosionX = 0
    Int explosionY = 0
    Int lives = 100
    Int x = 0
    Int y = 0
    Int endX = 0
    Int endY = 0
    BossWeapons weapons = BossWeapons()

    public constructor() { }

    reset() {
        phase = BossPhase.Inactive
        weapons.reset()
        lives = 100
        frenzySteps = 0
        lifeTime = 0
        normalSteps = 0
        explosionSteps = 0
        explosionX = 0
        explosionY = 0
        Int spawnRange = 200
        Int yRange = 139
        x = 220 + rng.int(spawnRange)
        y = 30 + rng.int(yRange)
        newDestination()
    }

    private newDestination() {
        Int xRange = 48
        Int yRange = 139
        endX = 88 + rng.int(xRange)
        endY = 30 + rng.int(yRange)
    }

    absorbMeteors(List<Meteor> meteors) {
        if (phase == BossPhase.Inactive) { return }
        for (var meteor in meteors) {
            if (!meteor.collided && meteor.x >= x && meteor.x <= x + 40 &&
                ((meteor.y >= y && meteor.y <= y + 51) ||
                 (meteor.y + Rules.METEOR_HEIGHT >= y && meteor.y + Rules.METEOR_HEIGHT <= y + 51))) { meteor.collide() }
        }
    }

    touchesShip(Ship ship): Bool {
        return phase == BossPhase.Normal && ship.phase == ShipPhase.Normal &&
            ship.x + Rules.SHIP_WIDTH >= x && ship.x <= x + 40 &&
            ((ship.y >= y && ship.y <= y + 51) ||
             (ship.y + Rules.SHIP_HEIGHT >= y && ship.y + Rules.SHIP_HEIGHT <= y + 51))
    }

    vulnerable(): Bool {
        return phase == BossPhase.Normal || phase == BossPhase.Fury || phase == BossPhase.Frenzy
    }

    damage(Int amount) {
        if (!vulnerable()) { return }
        lives = lives - amount
        if (lives <= 0) { phase = BossPhase.Explosion; explosionSteps = 0 }
    }

    reward(): Int {
        if (lifeTime <= 30) { return 1650 }
        if (lifeTime <= 60) { return 1100 }
        if (lifeTime <= 120) { return 550 }
        return 275
    }

    evolveWeapons() {
        if (!vulnerable()) { return }
        if (weapons.level == 0 && lives < 80) { weapons.evolve() }
        if (weapons.level == 1 && lives < 70) { weapons.evolve() }
        if (weapons.level == 2 && lives < 45) { weapons.evolve(); phase = BossPhase.Fury }
        if (weapons.level == 3 && lives < 20) { weapons.evolve(); phase = BossPhase.Frenzy }
    }

    spriteFrame(): Int {
        if (phase == BossPhase.Fury) { return 1 }
        if (phase == BossPhase.Frenzy && frenzySteps > 0) { return ((frenzySteps - 1) / 4) % 3 }
        return 0
    }

    explosionFrame(): Int {
        if (explosionSteps == 0) { return 0 }
        return 1 + (explosionSteps - 1) / 3
    }

    private advanceExplosion() {
        var frame = explosionFrame()
        var displacement = 1
        if (frame >= 4) { displacement = 2 }
        if (frame >= 6) { displacement = 3 }
        if (frame >= 8) { displacement = 5 }
        explosionX = explosionX - displacement
        explosionSteps = explosionSteps + 1
        if (explosionSteps == 28) { reset() }
    }

    advance() { this.advance(phase == BossPhase.Explosion) }

    advance(Bool existingExplosion) {
        if (phase == BossPhase.Inactive) { return }
        if (x < endX) { x = x + 1 }
        else if (x > endX) { x = x - 1 }
        if (y < endY) { y = y + 1 }
        else if (y > endY) { y = y - 1 }
        if (x == endX && y == endY) { newDestination() }
        if (existingExplosion) { advanceExplosion() }
        if (vulnerable()) {
            if (phase == BossPhase.Frenzy) { frenzySteps = frenzySteps + 1 }
            weapons.attemptFire(x, y)
            normalSteps = normalSteps + 1
            if (normalSteps == 36) { lifeTime = lifeTime + 1; normalSteps = 0 }
        }
        if (phase == BossPhase.Explosion && !existingExplosion) { explosionX = x; explosionY = y }
        weapons.advance()
    }
}
