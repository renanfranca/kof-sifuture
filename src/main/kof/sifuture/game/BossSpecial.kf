package sifuture.game
import sifuture.game.ShipContact

class BossSpecial {
    Int x = 0
    Int y = 0
    Int preparationSteps = 0
    Bool active = false

    public constructor() { }

    reset() { active = false; preparationSteps = 0 }

    fire(Int bossX, Int bossY) {
        if (active) { return }
        active = true
        preparationSteps = 0
        x = bossX - 3
        y = bossY + 38
    }

    frame(): Int { return preparationSteps / 3 }

    touchesShip(Ship ship): Bool {
        return active && ship.phase == ShipPhase.Normal && frame() == 6 && edgeTouchesShip(x, y, 26, ship)
    }

    advance() {
        if (!active) { return }
        if (preparationSteps < 18) { preparationSteps = preparationSteps + 1 }
        else { x = x - 10 }
        if (x < -48) { reset() }
    }
}
