package sifuture.game

class Shot {
    Int x = 0
    Int y = 0
    Int flightSteps
    Bool animated
    Bool active
    Bool impact

    public constructor() { reset() }

    reset() {
        active = false
        impact = false
        flightSteps = 0
        animated = false
    }

    fire(Int shipX, Int shipY) {
        if (active) { return }
        reset()
        x = shipX + Rules.LASER_WIDTH / 2
        y = shipY + Rules.SHIP_HEIGHT / 2 - 2
        active = true
    }

    advance() {
        if (!active) { return }
        if (impact) {
            active = false
            impact = false
        } else {
            x = x + Rules.LASER_SPEED
            flightSteps = flightSteps + 1
            if (x > Rules.WORLD_WIDTH) { active = false }
        }
    }

    spriteFrame(): Int {
        if (!animated || flightSteps < 3) { return 0 }
        if (flightSteps < 5) { return 1 }
        return 2
    }

    hitsMeteor(Meteor m): Bool {
        Bool frontInside = x + Rules.LASER_WIDTH <= m.x + Rules.METEOR_WIDTH
        Bool bottomInside = y + Rules.LASER_HEIGHT <= m.y + Rules.METEOR_HEIGHT
        return overlaps(m) && (frontInside || bottomInside)
    }

    overlaps(Meteor m): Bool {
        return x + Rules.LASER_WIDTH >= m.x && x <= m.x + Rules.METEOR_WIDTH &&
               y + Rules.LASER_HEIGHT >= m.y && y <= m.y + Rules.METEOR_HEIGHT
    }

    impactAt(Meteor m) {
        x = m.x
        y = m.y
        impact = true
    }
}
