package sifuture.game

Bool edgeTouchesShip(Int x, Int y, Int height, Ship ship) {
    return withinShipWidth(x, ship.x) && edgesWithinShipHeight(y, height, ship.y)
}

Bool withinShipWidth(Int x, Int shipX) {
    return x >= shipX && x <= shipX + Rules.SHIP_WIDTH
}

Bool edgesWithinShipHeight(Int y, Int height, Int shipY) {
    return edgeWithinShipHeight(y, shipY) || edgeWithinShipHeight(y + height, shipY)
}

Bool edgeWithinShipHeight(Int edgeY, Int shipY) {
    return edgeY >= shipY && edgeY <= shipY + Rules.SHIP_HEIGHT
}
