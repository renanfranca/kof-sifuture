package sifuture.game

class Ship {
    Int x = 0
    Int y = Rules.SHIP_START_Y
    Int lives = Rules.START_LIVES
    ShipPhase phase = ShipPhase.Restart
    Int restartFrame = 0
    Int explosionSteps = 0
    Bool left = false
    Bool right = false
    Bool up = false
    Bool down = false
    Direction lastX = Direction.Left
    Direction lastY = Direction.Up
    Bool rightFrame = false

    reset() {
        x = 0
        y = Rules.SHIP_START_Y
        lives = Rules.START_LIVES
        phase = ShipPhase.Restart
        restartFrame = 0
        explosionSteps = 0
        clearInput()
    }

    clearInput() {
        rightFrame = false
        left = false
        right = false
        up = false
        down = false
        lastX = Direction.Left
        lastY = Direction.Up
    }

    direction(Direction direction, Bool pressed) {
        if (direction == Direction.Left) { left = pressed; if (pressed) { lastX = Direction.Left } }
        if (direction == Direction.Right) { right = pressed; if (pressed) { lastX = Direction.Right } }
        if (direction == Direction.Up) { up = pressed; if (pressed) { lastY = Direction.Up } }
        if (direction == Direction.Down) { down = pressed; if (pressed) { lastY = Direction.Down } }
    }

    advance() {
        if (phase == ShipPhase.Explosion) { advanceExplosion(); return }
        var restarting = phase == ShipPhase.Restart
        if (restarting) { advanceRestart() }
        steer()
        if (!restarting) { rightFrame = movingRight() }
    }

    advanceExplosion() {
        explosionSteps = explosionSteps + 1
        if (explosionSteps == Rules.SHIP_EXPLOSION_STEPS) { loseLife() }
    }

    loseLife() {
        lives = lives - 1
        if (lives == 0) { phase = ShipPhase.Hidden; return }
        phase = ShipPhase.Restart
        restartFrame = 0
        x = Rules.SHIP_RESPAWN_X
        y = Rules.SHIP_START_Y
        rightFrame = false
    }

    advanceRestart() {
        restartFrame = restartFrame + 1
        if (restartFrame == Rules.SHIP_RESTART_STEPS) {
            phase = ShipPhase.Normal
            rightFrame = false
        }
    }

    steer() {
        if (movingLeft()) { x = x - Rules.SHIP_SPEED }
        if (movingRight()) { x = x + Rules.SHIP_SPEED }
        if (movingUp()) { y = y - Rules.SHIP_SPEED }
        if (movingDown()) { y = y + Rules.SHIP_SPEED }
        keepInBounds()
    }

    movingLeft(): Bool {
        return left && (!right || lastX == Direction.Left)
    }

    movingRight(): Bool {
        return right && (!left || lastX == Direction.Right)
    }

    movingUp(): Bool {
        return up && (!down || lastY == Direction.Up)
    }

    movingDown(): Bool {
        return down && (!up || lastY == Direction.Down)
    }

    keepInBounds() {
        Int rightBound = Rules.SHIP_RIGHT_BOUND
        Int top = Rules.HEADER_HEIGHT
        Int bottom = Rules.SHIP_BOTTOM_BOUND
        x = math.clamp(x, 0, rightBound)
        y = math.clamp(y, top, bottom)
    }

    advanceVisual() {
        if (phase == ShipPhase.Explosion) {
            explosionSteps = explosionSteps + 1
            if (explosionSteps >= Rules.SHIP_EXPLOSION_STEPS) { phase = ShipPhase.Hidden }
        } else if (phase == ShipPhase.Restart) {
            restartFrame = restartFrame + 1
            if (restartFrame == Rules.SHIP_RESTART_STEPS) { phase = ShipPhase.Normal }
        }
    }

    explode() {
        phase = ShipPhase.Explosion
        explosionSteps = 0
    }
}
