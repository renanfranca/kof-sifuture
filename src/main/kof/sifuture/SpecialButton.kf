package sifuture

import sifuture.ControlKeys
import sifuture.ControlStyles
import sifuture.GameControls
import kof.ui.*

class SpecialButton {
    Button button
    Column column
    ControlKeys keys
    ControlStyles styles

    public constructor(GameControls controls) {
        keys = controls.keys
        styles = controls.styles
        button = Button("Especial", () -> {})
        button.setId("game-special")
        button.on("focus", (e: Event) -> { this.keys.focusSpecial(); this.show() })
        button.on("blur", (e: Event) -> { this.keys.blurSpecial(); this.show() })
        button.on("pointerdown", (e: Event) -> { if (this.keys.specialPointerDown()) { controls.refresh() } })
        button.on("pointerup", (e: Event) -> { this.keys.specialPointerUp() })
        button.on("pointercancel", (e: Event) -> { this.keys.specialPointerUp() })
        button.on("pointerleave", (e: Event) -> { this.keys.specialPointerUp() })
        column = Column(listOf(button))
        column.setStyle(styles.specialColumn)
    }

    show() {
        var available = keys.specialAvailable()
        if (keys.specialFocused) { button.setStyle(if (available) styles.specialAvailableFocused else styles.specialUnavailableFocused) }
        else { button.setStyle(if (available) styles.specialAvailable else styles.specialUnavailable) }
        button.setDisabled(keys.specialDisabled())
    }
}
