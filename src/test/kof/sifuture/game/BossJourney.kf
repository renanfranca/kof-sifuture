    var game = Game()
    prepareBoss(game)
    game.boss.phase = BossPhase.Fury
    game.ship.x = 70
    game.ship.y = 100
    game.meteors[0].x = 121
    game.meteors[0].y = 100
    game.step()
    assert(game.meteors[0].x == 120 && game.meteors[0].collided)
    assert(game.ship.phase == ShipPhase.Normal && game.ship.lives == 3)
