test "fatal boss damage by the ship body rewards once before clock increment stops firing and captures moved explosion" {
    var at30 = givenLastBossLifeAtLifetime(30)
    givenShipOnBossBody(at30)
    at30.step()
    assert(bossExplodesWithRewardBeforeClockAndFire(at30, 30, 1650))
    advanceSteps(at30, 3)
    assert(at30.score == 1650 && at30.stagePosition() == 147)
    var at31 = givenLastBossLifeAtLifetime(31)
    givenShipOnBossBody(at31)
    at31.step()
    assert(bossExplodesWithRewardBeforeClockAndFire(at31, 31, 1100))
    advanceSteps(at31, 3)
    assert(at31.score == 1100 && at31.stagePosition() == 147)
    var at60 = givenLastBossLifeAtLifetime(60)
    givenShipOnBossBody(at60)
    at60.step()
    assert(bossExplodesWithRewardBeforeClockAndFire(at60, 60, 1100))
    advanceSteps(at60, 3)
    assert(at60.score == 1100 && at60.stagePosition() == 147)
    var at61 = givenLastBossLifeAtLifetime(61)
    givenShipOnBossBody(at61)
    at61.step()
    assert(bossExplodesWithRewardBeforeClockAndFire(at61, 61, 550))
    advanceSteps(at61, 3)
    assert(at61.score == 550 && at61.stagePosition() == 147)
    var at120 = givenLastBossLifeAtLifetime(120)
    givenShipOnBossBody(at120)
    at120.step()
    assert(bossExplodesWithRewardBeforeClockAndFire(at120, 120, 550))
    advanceSteps(at120, 3)
    assert(at120.score == 550 && at120.stagePosition() == 147)
    var at121 = givenLastBossLifeAtLifetime(121)
    givenShipOnBossBody(at121)
    at121.step()
    assert(bossExplodesWithRewardBeforeClockAndFire(at121, 121, 275))
    advanceSteps(at121, 3)
    assert(at121.score == 275 && at121.stagePosition() == 147)
}

