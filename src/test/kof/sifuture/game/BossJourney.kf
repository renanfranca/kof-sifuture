test "nonfatal laser hits evolve a level zero boss only below 80 lives preserving fire clock" {
    var g = givenBossOneLifeAboveThreshold(0, 80)
    var laser = g.weapons.lasers.shots[0]
    g.step()
    assert(g.boss.lives == 80 && g.boss.weapons.level == 0)
    laser.reset()
    laser.fire(0, 100)
    laser.x = g.boss.x - 34
    g.step()
    assert(g.boss.lives == 79 && g.boss.weapons.level == 1)
    assert(g.boss.weapons.fireSteps == 5 && g.boss.weapons.shots[0].animated)
}

