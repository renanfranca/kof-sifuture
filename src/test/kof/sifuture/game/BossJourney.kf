test "boss blaster contact at both inclusive edges spends the remaining resistance" {
    var left = givenBlasterAtBossHeight(47)
    left.step()
    assert(left.boss.lives == 98)
    assert(left.weapons.blaster.lives == 0)
    var right = givenBlasterAtBossHeight(87)
    right.step()
    assert(right.boss.lives == 98)
    assert(right.weapons.blaster.lives == 0)
}

test "boss blaster beside either edge keeps its resistance" {
    var left = givenBlasterAtBossHeight(46)
    left.step()
    assert(left.boss.lives == 100)
    assert(left.weapons.blaster.lives == 2)
    var right = givenBlasterAtBossHeight(88)
    right.step()
    assert(right.boss.lives == 100)
    assert(right.weapons.blaster.lives == 2)
}

test "an exhausted boss blaster causes no damage" {
    var g = givenBlasterAtBossHeight(47)
    g.weapons.blaster.lives = 0
    g.step()
    assert(g.boss.lives == 100)
}

test "boss special center reapplies marked colors and expires after the boss leaves" {
    var g = Game()
    prepareBoss(g)
    g.boss.endY = 100
    givenEveryBeamActiveAt(g, 0, 115)
    g.weapons.beams[0].lives = 1
    g.step()
    assert(g.boss.lives == 99 && g.weapons.beams[0].lives == 0 && g.weapons.beams[0].contactSteps == 6)
    g.step()
    assert(g.boss.lives == 97 && g.weapons.beams[0].lives == -1 && g.weapons.beams[1].lives == 9)
    g.step()
    assert(g.boss.lives == 94 && g.weapons.beams[0].lives == -2 && g.weapons.beams[2].lives == 9)
    g.boss.x = 1000
    g.boss.endX = 1000
    advanceSteps(g, 6)
    assert(g.boss.lives == 94 && !g.weapons.beams[0].active && g.weapons.beams[0].contactSteps == 0)
}

test "boss fury frenzy and evolved shots keep historical sprite cadence without drawing updates" {
    var g = Game()
    prepareBoss(g)
    g.boss.lives = 20
    g.boss.weapons.level = 3
    g.boss.weapons.shots[0].fire(400, -100)
    g.weapons.lasers.shots[0].fire(0, 100)
    g.weapons.lasers.shots[0].x = 86
    g.step()
    assert(g.boss.phase == BossPhase.Frenzy && g.boss.spriteFrame() == 0)
    assert(g.boss.weapons.shots[0].spriteFrame() == 0)
    advanceSteps(g, 3)
    assert(g.boss.spriteFrame() == 0 && g.boss.weapons.shots[0].spriteFrame() == 1)
    g.step()
    assert(g.boss.spriteFrame() == 1 && g.boss.weapons.shots[0].spriteFrame() == 2)
    advanceSteps(g, 4)
    assert(g.boss.spriteFrame() == 2)
    advanceSteps(g, 4)
    assert(g.boss.spriteFrame() == 0)
    g.boss.phase = BossPhase.Fury
    assert(g.boss.spriteFrame() == 1)
    g.start(943)
    assert(g.boss.spriteFrame() == 0 && g.boss.weapons.shots[0].spriteFrame() == 0)
}

test "the ship body claims a fatal boss hit before laser blaster and special and rewards only once" {
    var g = givenLastBossLifeWithMeteorOnItsEdge()
    givenShipOnBossBody(g)
    givenLaserOnBoss(g)
    givenBlasterOnBoss(g)
    givenBeamOnBoss(g)
    g.step()
    assert(g.score == 1650 && g.boss.phase == BossPhase.Explosion && g.meteors[0].collided)
    assert(g.ship.phase == ShipPhase.Explosion && !g.weapons.lasers.shots[0].impact)
}

test "a laser claims a fatal boss hit before blaster and special and rewards only once" {
    var g = givenLastBossLifeWithMeteorOnItsEdge()
    givenLaserOnBoss(g)
    givenBlasterOnBoss(g)
    givenBeamOnBoss(g)
    g.step()
    assert(g.score == 1650 && g.boss.phase == BossPhase.Explosion && g.meteors[0].collided)
    assert(g.weapons.lasers.shots[0].impact && g.weapons.blaster.lives == 2)
}

test "the blaster claims a fatal boss hit before the special and rewards only once" {
    var g = givenLastBossLifeWithMeteorOnItsEdge()
    givenBlasterOnBoss(g)
    givenBeamOnBoss(g)
    g.step()
    assert(g.score == 1650 && g.boss.phase == BossPhase.Explosion && g.meteors[0].collided)
    assert(g.weapons.blaster.lives == 0 && g.weapons.beams[0].lives == 10)
}

test "the special claims a fatal boss hit when it is the only weapon in contact and rewards only once" {
    var g = givenLastBossLifeWithMeteorOnItsEdge()
    givenBeamOnBoss(g)
    g.step()
    assert(g.score == 1650 && g.boss.phase == BossPhase.Explosion && g.meteors[0].collided)
    assert(g.weapons.beams[0].lives == 9)
}

test "boss laser corner geometry is inclusive and rejects mere overlap outside the sampled edge" {
    assert(bossLivesAfterLaserAt(84, 100) == 100)
    assert(bossLivesAfterLaserAt(85, 100) == 99)
    assert(bossLivesAfterLaserAt(125, 100) == 99)
    assert(bossLivesAfterLaserAt(126, 100) == 100)
    assert(bossLivesAfterLaserAt(86, 88) == 99)
    assert(bossLivesAfterLaserAt(86, 87) == 100)
    assert(bossLivesAfterLaserAt(86, 151) == 99)
    assert(bossLivesAfterLaserAt(86, 152) == 100)
}

test "defeat during boss fight animates without contacts score changes or new player fire and resets all clocks" {
    var g = Game()
    givenShipLosingLastLifeDuringBoss(g)
    g.step()
    assert(g.screen == Screen.Result)
    assert(g.ship.lives == 0)
    assert(g.score == 17)
    var x = g.boss.x
    advanceSteps(g, 40)
    assert(g.boss.x != x)
    assert(g.boss.lives == 1)
    assert(g.score == 17)
    assert(g.ship.lives == 0)
    assert(g.stagePosition() == 147)
    assert(!g.weapons.beams[0].active)
    assert(g.weapons.fireSteps == 12)
    assert(noLaserActive(g))
    g.start(943)
    assert(g.boss.phase == BossPhase.Inactive)
    assert(g.boss.lives == 100)
    assert(g.boss.lifeTime == 0)
    assert(g.boss.normalSteps == 0)
    assert(g.boss.weapons.level == 0)
    assert(g.boss.weapons.fireSteps == 0)
    assert(!g.boss.weapons.specialReady)
    assert(g.boss.weapons.attempts == 0)
    assert(!g.boss.weapons.special.active)
    assert(g.boss.weapons.special.preparationSteps == 0)
    assert(g.boss.frenzySteps == 0)
    assert(bossShotsCleared(g))
}

test "boss evolution preserves a due clock uses first free slot and jumps crossed levels on nonfatal weapons" {
    var g = Game()
    prepareBoss(g)
    g.boss.lives = 80
    g.boss.weapons.fireSteps = 12
    g.boss.weapons.shots[0].fire(400, -100)
    g.weapons.lasers.shots[0].fire(0, 100)
    g.weapons.lasers.shots[0].x = 86
    g.step()
    assert(g.boss.weapons.level == 1)
    assert(g.boss.weapons.fireSteps == 13)
    assert(!g.boss.weapons.shots[1].active)
    g.boss.weapons.fireSteps = 30
    g.step()
    assert(g.boss.weapons.shots[0].x == 382)
    assert(g.boss.weapons.shots[1].active)
    assert(g.boss.weapons.shots[1].x == 108)
    prepareBoss(g)
    g.boss.lives = 21
    g.boss.normalSteps = 35
    g.boss.lifeTime = 60
    g.boss.weapons.fireSteps = 5
    g.weapons.blaster.fire(g.ship)
    g.weapons.blaster.x = 47
    g.weapons.blaster.y = 100
    g.step()
    assert(g.boss.lives == 19)
    assert(g.boss.weapons.level == 4)
    assert(g.boss.phase == BossPhase.Frenzy)
    assert(g.boss.lifeTime == 61)
    assert(g.boss.normalSteps == 0)
    assert(g.boss.weapons.fireSteps == 6)
    assert(g.score == 0)
    assert(g.boss.weapons.special.active)
    assert(g.weapons.blaster.lives == 0)
}

test "initial boss capacity remains one with first slot occupied and second free" {
    var game = Game()
    prepareBoss(game)
    game.boss.weapons.shots[0].fire(1010, -100)
    advanceSteps(game, 26)
    assert(game.boss.weapons.shots[0].active && game.boss.weapons.shots[0].x == 896)
    assert(!game.boss.weapons.shots[1].active)
    assert(game.boss.weapons.fireSteps == 0 && game.boss.weapons.attempts == 0)
}

