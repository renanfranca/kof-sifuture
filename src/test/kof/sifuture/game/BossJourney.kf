test "boss special checks previous fire clock and prepares six frames before moving" {
    assert(!bossSpecialStartsAfterOneStep(2, 10, true))
    assert(bossSpecialStartsAfterOneStep(2, 11, true))
    assert(bossSpecialStartsAfterOneStep(3, 0, true))
    assert(!bossSpecialStartsAfterOneStep(4, 4, false))
    assert(bossSpecialStartsAfterOneStep(4, 5, false))
    var g = givenBossSpecialStarted()
    var shot = g.boss.weapons.special
    assert(shot.active && shot.x == 118 && shot.y == 139 && shot.frame() == 0)
    var x = shot.x
    assert(bossSpecialHoldsEachPreparationFrameForThreeSteps(g))
    assert(shot.frame() == 6 && shot.x == x)
    g.step()
    assert(shot.x == x - 10)
    g.pause()
    g.step()
    assert(shot.x == x - 10 && shot.frame() == 6)
}

test "a normal ship touching the boss body edge explodes and costs the boss one life without evolving its weapons" {
    var g = givenNormalShipTouchingBossBody()
    g.step()
    assert(g.ship.phase == ShipPhase.Explosion && g.boss.lives == 79)
    assert(g.boss.weapons.level == 0 && g.score == 0)
}

test "a restarting ship touching the boss body causes no contact" {
    var g = givenNormalShipTouchingBossBody()
    g.ship.phase = ShipPhase.Restart
    g.step()
    assert(g.ship.phase != ShipPhase.Explosion && g.boss.lives == 80)
    assert(g.boss.weapons.level == 0 && g.score == 0)
}

test "a fury boss body causes no contact with a normal ship" {
