test "boss explosion displays short first frame then three-step frames ends at 28 and resumes 290 steps" {
    var g = Game()
    prepareBoss(g)
    g.boss.lives = 1
    g.weapons.lasers.shots[0].fire(0, 100)
    g.weapons.lasers.shots[0].x = 86
    g.boss.weapons.shots[0].fire(400, -100)
    g.boss.weapons.special.fire(400, -100)
    g.step()
    assert(g.boss.explosionFrame() == 0 && g.boss.explosionX == 121 && g.boss.explosionY == 101)
    assert(bossExplosionFollowsHistoricalOffsetsAndHoldsOnPause(g))
    assert(g.boss.explosionFrame() == 9)
    g.step()
    assert(g.boss.phase == BossPhase.Inactive && g.stagePosition() == 147)
    assert(!g.boss.weapons.shots[0].active && !g.boss.weapons.special.active)
    advanceSteps(g, 289)
    assert(g.screen == Screen.Play && g.stagePosition() == 175)
    g.step()
    assert(g.screen == Screen.Result && g.stagePosition() == 176 && g.score == 1650)
}

test "boss enemy contacts use previous positions new reused and special preparation shots wait a step" {
    var g = Game()
    prepareBoss(g)
    g.ship.x = 40
    g.ship.y = 100
    g.boss.x = 91
    g.boss.weapons.fireSteps = 12
    g.step()
    assert(g.ship.phase == ShipPhase.Normal)
    assert(g.boss.weapons.shots[0].active)
    assert(g.boss.weapons.shots[0].x == 78)
    g.step()
    assert(g.ship.phase == ShipPhase.Explosion)
    assert(!g.boss.weapons.shots[0].active)

    prepareBoss(g)
    g.ship.y = 100
    g.boss.x = 400
    g.boss.endX = 400
    g.boss.weapons.shots[0].fire(0, 100)
    g.boss.weapons.shots[0].x = 51
    g.step()
    assert(g.ship.phase == ShipPhase.Normal)
    assert(g.boss.weapons.shots[0].x == 47)
    g.step()
    assert(g.ship.phase == ShipPhase.Explosion)
    assert(!g.boss.weapons.shots[0].active)

    prepareBoss(g)
    g.ship.x = 40
    g.ship.y = 100
    g.boss.x = 91
    g.boss.weapons.level = 1
    g.boss.weapons.fireSteps = 30
    g.boss.weapons.shots[0].fire(50, 100)
    g.boss.weapons.shots[1].fire(160, 100)
    g.step()
    assert(g.ship.phase == ShipPhase.Explosion)
    assert(g.boss.weapons.shots[0].active)
    assert(g.boss.weapons.shots[0].x == 78)
    assert(g.boss.weapons.shots[1].x == 146)
    g.ship.phase = ShipPhase.Normal
    g.step()
    assert(g.ship.phase == ShipPhase.Explosion)
    assert(!g.boss.weapons.shots[0].active)

    prepareBoss(g)
    g.ship.y = 100
    g.boss.weapons.special.fire(43, 62)
    g.boss.weapons.special.preparationSteps = 17
    g.step()
    assert(g.ship.phase == ShipPhase.Normal)
    assert(g.boss.weapons.special.frame() == 6)
    assert(g.boss.weapons.special.x == 40)
    g.step()
    assert(g.ship.phase == ShipPhase.Explosion)
    assert(!g.boss.weapons.special.active)
}

test "normal boss absorbs inclusive meteors before player contacts with one movement and suppresses vertical relaunch" {
    var g = givenBossFacingTwoMeteorsAndALaser(BossPhase.Normal)
    g.step()
    assert(g.meteors[0].x == 120 && g.meteors[1].x == 160)
    assert(g.meteors[0].collided && g.meteors[1].collided && g.meteors[0].collisionSteps == 0)
    assert(g.boss.lives == 100 && g.score == 0 && !g.weapons.lasers.shots[0].impact)
    assert(!g.meteors[6].active && !g.meteors[7].active)
    g.meteors[6].active = true
    g.meteors[6].x = 20
    g.meteors[6].y = 219
    g.step()
    assert(g.meteors[6].active && g.meteors[6].y == 220)
    g.step()
    g.step()
    assert(!g.meteors[6].active && !g.meteors[7].active)
    assert(g.items[0].x == 9996 && g.items[1].x == 9996)
}

test "fury boss absorbs inclusive meteors before player contacts with one movement and suppresses vertical relaunch" {
    var g = givenBossFacingTwoMeteorsAndALaser(BossPhase.Fury)
    g.step()
    assert(g.meteors[0].x == 120 && g.meteors[1].x == 160)
    assert(g.meteors[0].collided && g.meteors[1].collided && g.meteors[0].collisionSteps == 0)
    assert(g.boss.lives == 100 && g.score == 0 && !g.weapons.lasers.shots[0].impact)
    assert(!g.meteors[6].active && !g.meteors[7].active)
    g.meteors[6].active = true
    g.meteors[6].x = 20
    g.meteors[6].y = 219
    g.step()
    assert(g.meteors[6].active && g.meteors[6].y == 220)
    g.step()
    g.step()
    assert(!g.meteors[6].active && !g.meteors[7].active)
    assert(g.items[0].x == 9996 && g.items[1].x == 9996)
}

