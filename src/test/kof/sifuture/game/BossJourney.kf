test "final encounter enters at 146 advances marker to 147 and suspends track once" {
    var g = Game()
    g.start(941)
    g.stageSteps = 1409
    g.ship.phase = ShipPhase.Restart
    g.ship.restartFrame = 0
    givenMeteorsAway(g)

    g.step()
    assert(g.stagePosition() == 147)
    advanceSteps(g, 20)
    assert(g.stagePosition() == 147 && g.stageSteps == 1420)
    g.pause()
    g.step()
    assert(g.stageSteps == 1420)
}

test "boss seeded spawn and destination move one unit per axis including arrival" {
    var g = Game()
    g.start(942)
    var b = g.boss
    assert(b.x >= 220)
    assert(b.x <= 419)
    assert(b.y >= 30)
    assert(b.y <= 168)
    assert(b.endX >= 88)
    assert(b.endX <= 135)
    assert(b.endY >= 30)
    assert(b.endY <= 168)
    var x = b.x
    var y = b.y
    var dx = b.endX
    var dy = b.endY
    g.start(942)
    assert(b.x == x)
    assert(b.y == y)
    assert(b.endX == dx)
    assert(b.endY == dy)
    g.stageSteps = 1409
    g.ship.phase = ShipPhase.Restart
    givenMeteorsAway(g)

    g.step()
    assert(b.phase == BossPhase.Normal)
    assert(b.x == x - 1)
    b.x = 100
    b.y = 80
    b.endX = 101
    b.endY = 81
    rng.seed(42)
    g.step()
    assert(b.x == 101)
    assert(b.y == 81)
    assert(b.endX >= 88)
    assert(b.endX <= 135)
}

test "level zero boss fire uses a 13 step interval and the first free slot and never readies the special" {
    var g = givenBossFiringAtLevel(0)
    advanceSteps(g, 12)
    assert(!g.boss.weapons.shots[0].active)
    g.step()
    assert(g.boss.weapons.shots[0].active && g.boss.weapons.shots[0].x == 386)
    assert(g.boss.weapons.shots[0].y == g.boss.y)
    advanceBossAttemptsWithOccupiedSlots(g, 13, 3)
    assert(g.boss.weapons.shots[0].x == 9948 && g.boss.weapons.shots[1].x == 9948)
    assert(!g.boss.weapons.specialReady && g.boss.weapons.attempts == 0)
    occupyBossShots(g)
    advanceSteps(g, 12)
    g.step()
    assert(!g.boss.weapons.specialReady)
    assert(g.boss.weapons.shots[0].x == 9948 && g.boss.weapons.shots[1].x == 9948)
}

test "level one boss fire uses a 31 step interval and the first free slot and readies the special after three occupied attempts" {
    var g = givenBossFiringAtLevel(1)
    advanceSteps(g, 30)
    assert(!g.boss.weapons.shots[0].active)
    g.step()
    assert(g.boss.weapons.shots[0].active && g.boss.weapons.shots[0].x == 386)
    assert(g.boss.weapons.shots[0].y == g.boss.y)
    advanceBossAttemptsWithOccupiedSlots(g, 31, 3)
    assert(g.boss.weapons.shots[0].x == 9876 && g.boss.weapons.shots[1].x == 9876)
    assert(g.boss.weapons.specialReady && g.boss.weapons.attempts == 0)
    occupyBossShots(g)
    advanceSteps(g, 30)
    assert(g.boss.weapons.specialReady)
    g.step()
    assert(!g.boss.weapons.specialReady)
    assert(g.boss.weapons.attempts == 1)
    assert(g.boss.weapons.shots[0].x == 9876 && g.boss.weapons.shots[1].x == 9876)
}

