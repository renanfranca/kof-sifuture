test "stage moves on each tenth active step including restart and pause" {
    var g = Game()
    g.start(901)
    assert(g.stagePosition() == 5)
    for (var i = 0; i < 9; i++) { g.step() }
    assert(g.stagePosition() == 5)
    g.pause()
    for (var i = 0; i < 20; i++) { g.step() }
    assert(g.stagePosition() == 5 && g.steps == 9)
    g.resume()
    g.step()
    assert(g.stagePosition() == 6 && g.ship.phase == ShipPhase.Restart)
    g.ship.explode()
    for (var i = 0; i < 10; i++) { g.step() }
    assert(g.stagePosition() == 7 && g.ship.phase == ShipPhase.Explosion)
    g.start(901)
    assert(g.stagePosition() == 5 && g.steps == 0)
}


test "full stage completes after combat explosion and resumed track without second encounter" {
    var g = Game()
    g.start(902)
    g.ship.lives = 100
    for (var i = 0; i < 1710; i++) { g.step() }
    assert(g.screen == Screen.Play && g.stagePosition() == 89)
    for (var i = 0; i < 10000 && g.screen == Screen.Play; i++) { g.step() }
    assert(g.screen == Screen.Result && g.stagePosition() == 176 && g.steps > 1710)
    assert(g.subchief.phase == SubchiefPhase.Inactive)
    var score = g.score
    var lives = g.ship.lives
    var steps = g.steps
    for (var i = 0; i < 50; i++) { g.step() }
    assert(g.steps == steps && g.score == score && g.ship.lives == lives)
}


test "vertical pair unlocks above position thirty and falls one unit per step" {
    var g = Game()
    g.start(903)
    assert(g.meteors.size == 8)
    assert(g.meteors[0].motion == MeteorMotion.Horizontal && g.meteors[5].motion == MeteorMotion.Horizontal)
    assert(g.meteors[6].motion == MeteorMotion.Vertical && !g.meteors[6].active && !g.meteors[7].active)
    g.steps = 258
    g.stageSteps = 258
    g.step()
    assert(g.stagePosition() == 30 && !g.meteors[6].active && !g.meteors[7].active)
    var x = g.meteors[6].x
    var y = g.meteors[6].y
    g.step()
    assert(g.stagePosition() == 31 && g.meteors[6].active && g.meteors[7].active)
    assert(g.meteors[6].x == x && g.meteors[6].y == y + 1)
    g.pause()
    g.step()
    assert(g.meteors[6].y == y + 1)
    g.resume()
    g.step()
    assert(g.meteors[6].y == y + 2)
    g.start(903)
    assert(g.meteors[6].x == x && g.meteors[6].y == y && !g.meteors[6].active)
    assert(Meteor().motion == MeteorMotion.Horizontal)
}


test "vertical impact has three moving frames and pair relaunch waits for both inactive" {
    var g = Game()
    g.start(904)
    g.steps = 260
    g.stageSteps = 260
    g.step()
    var first = g.meteors[6]
    var second = g.meteors[7]
    first.x = 80
    first.y = 50
    second.x = 120
    second.y = -100
    first.collide()
    assert(first.impactFrame() == 0)
    g.step()
    assert(first.active && first.y == 51 && first.impactFrame() == 1)
    g.step()
    assert(first.active && first.y == 52 && first.impactFrame() == 2)
    g.step()
    assert(!first.active && second.active)
    var waitingY = first.y
    g.step()
    assert(!first.active && first.y == waitingY)
    second.y = 220
    g.step()
    assert(!first.active && !second.active)
    g.step()
    assert(first.active && second.active && first.y == waitingY + 1)
    assert(second.x >= 0 && second.x < 176 && second.y <= 1)
}


test "result counts by five to exact total then confirms in two stages" {
    var g = Game()
    g.start(905)
    g.score = 17
    g.ship.lives = 0
    g.step()
    assert(g.screen == Screen.Result && g.displayedScore == 0 && !g.countComplete())
    g.step()
    assert(g.displayedScore == 5 && g.score == 17)
    g.step()
    g.step()
    assert(g.displayedScore == 15 && !g.countComplete())
    g.step()
    assert(g.displayedScore == 17 && g.countComplete())
    g.step()
    assert(g.displayedScore == 17 && g.screen == Screen.Result)
    g.confirm()
    assert(g.screen == Screen.Menu)
    g.start(905)
    g.score = 17
    g.ship.lives = 0
    g.step()
    g.confirm()
    assert(g.screen == Screen.Result && g.displayedScore == 17 && g.countComplete())
    g.confirm()
    assert(g.screen == Screen.Menu)
    g.start(905)
    g.ship.lives = 0
    g.step()
    assert(g.score == 0 && g.displayedScore == 0 && g.countComplete())
    g.confirm()
    assert(g.screen == Screen.Menu)
}


test "result keeps scenery and pending effects moving with frozen gameplay" {
    var g = Game()
    g.start(906)
    g.steps = 1709
    g.stageSteps = 1709
    g.ship.explode()
    g.ship.explosionSteps = 28
    g.ship.lives = 4
    g.weapons.level = 3
    g.weapons.charges = 2
    g.score = 37
    g.items[1].x = g.ship.x + 10
    g.items[1].y = g.ship.y - 16
    g.meteors[0].x = 80
    g.meteors[0].y = 100
    g.meteors[0].collide()
    g.step()
    assert(g.screen == Screen.Result && g.ship.explosionSteps == 29)
    var background = g.background.offset
    var meteorX = g.meteors[0].x
    var itemX = g.items[1].x
    g.keyboard(Direction.Right, true)
    g.movement(Direction.Right, true)
    assert(!g.trySpecial())
    g.step()
    assert(g.background.offset != background && g.meteors[0].x == meteorX - 1)
    assert(g.items[1].x == itemX - 1 && !g.items[1].collected)
    assert(g.ship.phase == ShipPhase.Hidden && g.ship.explosionSteps == 30)
    for (var i = 0; i < 15; i++) { g.step() }
    assert(g.weapons.lasers.shots[0].active)
    assert(g.ship.lives == 4 && g.ship.x == 0 && g.steps == 1710 && g.stagePosition() == 176)
    assert(g.score == 37 && g.displayedScore == 37 && g.weapons.level == 3 && g.weapons.charges == 2)
    assert(g.screen == Screen.Result && g.ship.explosionSteps == 30)
}


test "vertical contacts preserve ship laser blaster special priority and one reward" {
    for (var mode = 0; mode < 4; mode++) {
        var g = Game()
        g.start(908)
        g.steps = 260
        g.stageSteps = 260
        g.ship.phase = ShipPhase.Normal
        for (var m in g.meteors) { m.x = 10000; m.y = -100 }
        g.weapons.lasers.shots[0].fire(0, 100)
        g.weapons.blaster.fire(g.ship)
        for (var i = 0; i < 4; i++) { g.weapons.evolve() }
        assert(g.trySpecial())
        g.weapons.beams[1].x = 0
        if (mode > 0) { g.ship.y = 200 }
        if (mode > 1) { g.weapons.lasers.shots[0].active = false }
        if (mode > 2) { g.weapons.blaster.active = false }
        g.meteors[6].active = true
        g.meteors[6].x = 36
        g.meteors[6].y = 107
        g.step()
        assert(g.score == 5 && g.meteors[6].collided)
        if (mode == 0) { assert(g.ship.phase == ShipPhase.Explosion && !g.weapons.lasers.shots[0].impact) }
        if (mode == 1) { assert(g.weapons.lasers.shots[0].impact && g.weapons.blaster.lives == 2) }
        if (mode == 2) { assert(g.weapons.blaster.lives == 1 && g.weapons.beams[1].lives == 10) }
        if (mode == 3) { assert(g.weapons.beams[1].lives == 9) }
        for (var i = 0; i < 3; i++) { g.step() }
        assert(g.score == 5 && !g.meteors[6].active)
    }
}

test "same seed replays the entire stage including vertical relaunch and result" {
    var g = Game()
    g.start(909)
    g.ship.lives = 100
    for (var i = 0; i < 10000 && g.screen == Screen.Play; i++) { g.step() }
    var steps = g.steps
    assert(g.screen == Screen.Result && g.stagePosition() == 176)
    var positionsX = listOf<Int>()
    var positionsY = listOf<Int>()
    for (var m in g.meteors) { positionsX.add(m.x); positionsY.add(m.y) }
    var itemX = g.items[0].x
    var score = g.score
    var lives = g.ship.lives
    g.start(909)
    g.ship.lives = 100
    for (var i = 0; i < steps; i++) { g.step() }
    assert(g.screen == Screen.Result && g.displayedScore == 0 && g.steps == steps)
    for (var i = 0; i < 8; i++) { assert(g.meteors[i].x == positionsX[i] && g.meteors[i].y == positionsY[i]) }
    assert(g.items[0].x == itemX && g.score == score && g.ship.lives == lives)
}

test "defeat ends the explosion and visual result never consumes another life or weapon" {
    var g = Game()
    g.start(910)
    g.ship.lives = 1
    g.ship.explode()
    g.ship.explosionSteps = 29
    g.weapons.level = 3
    g.weapons.charges = 1
    g.score = 5
    g.step()
    assert(g.screen == Screen.Result && g.ship.phase == ShipPhase.Hidden && g.ship.explosionSteps == 30)
    assert(g.ship.lives == 0 && g.weapons.charges == 0 && g.weapons.level == 3)
    var steps = g.steps
    for (var i = 0; i < 100; i++) { g.step() }
    assert(g.ship.lives == 0 && g.ship.explosionSteps == 30 && g.steps == steps && g.score == 5)
    assert(g.weapons.level == 3 && g.displayedScore == 5 && g.screen == Screen.Result)
}


test "midpoint enters once and freezes track while match and scenery continue" {
    var g = Game()
    g.start(920)
    g.ship.lives = 100
    for (var i = 0; i < 829; i++) { g.step() }
    assert(g.stagePosition() == 87 && g.subchief.phase == SubchiefPhase.Inactive)

    g.step()
    assert(g.stagePosition() == 89 && g.subchief.phase == SubchiefPhase.Normal)
    var background = g.background.offset
    var itemX = g.items[0].x
    for (var i = 0; i < 10; i++) { g.step() }
    assert(g.stagePosition() == 89 && g.steps == 840)
    assert(g.background.offset != background && g.items[0].x == itemX - 10)
    g.pause()
    g.step()
    assert(g.steps == 840 && g.stagePosition() == 89)
}


test "subchief seeded destinations movement and three shot slots use normal step clocks" {
    var g = Game()
    g.start(921)
    var chief = g.subchief
    assert(chief.x >= 220 && chief.x <= 419 && chief.y >= 30 && chief.y <= 193)
    assert(chief.endX >= 88 && chief.endX <= 147 && chief.endY >= 30 && chief.endY <= 193)
    var x = chief.x
    var y = chief.y
    var endX = chief.endX
    var endY = chief.endY
    g.start(921)
    assert(chief.x == x && chief.y == y && chief.endX == endX && chief.endY == endY)
    g.stageSteps = 829
    g.ship.lives = 100
    g.step()
    assert(chief.x == x - 1 && chief.lifeTime == 0 && chief.normalSteps == 1)
    for (var i = 0; i < 10; i++) { g.step() }
    assert(!chief.shots[0].active)
    g.step()
    assert(chief.shots[0].active && !chief.shots[1].active)
    assert(chief.shots[0].x == chief.x - 7 - 4 && chief.shots[0].y == chief.y + 13)
    for (var i = 0; i < 12; i++) { g.step() }
    assert(chief.shots[1].active && !chief.shots[2].active)
    for (var i = 0; i < 12; i++) { g.step() }
    assert(chief.shots[2].active && chief.lifeTime == 1 && chief.normalSteps == 0)
    var shotX = chief.shots[2].x
    var firstShotX = chief.shots[0].x
    for (var i = 0; i < 12; i++) { g.step() }
    assert(chief.shots[2].x == shotX - 48 && chief.shots.size == 3)
    assert(chief.shots[0].x == firstShotX - 48)
    chief.shots[0].active = false
    for (var i = 0; i < 12; i++) { g.step() }
    assert(chief.shots[0].active && chief.shots[0].x == chief.x - 11)
    g.pause()
    var normalSteps = chief.normalSteps
    var shotPosition = chief.shots[0].x
    g.step()
    assert(chief.normalSteps == normalSteps && chief.shots[0].x == shotPosition)
    g.start(921)
    assert(chief.phase == SubchiefPhase.Inactive && chief.lifeTime == 0 && chief.normalSteps == 0)
    for (var shot in chief.shots) { assert(!shot.active) }
}

prepareSubchief(Game g) {
    g.start(922)
    g.stageSteps = 840
    g.subchief.phase = SubchiefPhase.Normal
    g.subchief.x = 120
    g.subchief.y = 100
    g.subchief.endX = 147
    g.subchief.endY = 100
    g.ship.phase = ShipPhase.Normal
    for (var m in g.meteors) { m.x = 10000; m.y = -100 }
    for (var item in g.items) { item.x = 10000 }
}

test "subchief laser and body damage precede meteor weapons and restart is invulnerable" {
    var g = Game()
    prepareSubchief(g)
    var laser = g.weapons.lasers.shots[0]
    laser.fire(0, 100)
    laser.x = 86
    g.meteors[0].x = 122
    g.meteors[0].y = 100

    g.step()
    assert(g.subchief.lives == 29 && laser.impact && laser.x == 120 && laser.y == 100)
    assert(!g.meteors[0].collided && g.score == 0)
    g.step()
    assert(g.subchief.lives == 29 && !laser.active)

    prepareSubchief(g)
    g.ship.x = 100
    g.step()
    assert(g.ship.phase == ShipPhase.Explosion && g.subchief.lives == 29)
    g.step()
    assert(g.subchief.lives == 29 && g.ship.explosionSteps == 1)

    prepareSubchief(g)
    g.ship.x = 100
    g.ship.phase = ShipPhase.Restart
    g.step()
    assert(g.ship.phase == ShipPhase.Restart && g.subchief.lives == 30)
}

test "subchief blaster spends remaining resistance before meteor contacts" {
    var g = Game()
    for (var remaining = 1; remaining <= 2; remaining++) {
        prepareSubchief(g)
        g.weapons.blaster.fire(g.ship)
        g.weapons.blaster.x = 60
        g.weapons.blaster.lives = remaining
        g.meteors[0].x = 125
        g.meteors[0].y = 100

        g.step()
        assert(g.subchief.lives == 30 - remaining && g.weapons.blaster.lives == 0)
        assert(g.weapons.blaster.active && !g.meteors[0].collided && g.score == 0)
        g.step()
        assert(g.subchief.lives == 30 - remaining)
    }
}

test "special subchief markers reapply in color order and expire after six steps" {
    var g = Game()
    prepareSubchief(g)
    for (var beam in g.weapons.beams) { beam.active = true; beam.x = 0; beam.y = 100 }

    g.step()
    assert(g.subchief.lives == 29 && g.weapons.beams[0].lives == 9)
    assert(g.weapons.beams[1].lives == 10 && g.weapons.beams[2].lives == 10)
    g.step()
    assert(g.subchief.lives == 27 && g.weapons.beams[0].lives == 8 && g.weapons.beams[1].lives == 9)
    g.step()
    assert(g.subchief.lives == 24 && g.weapons.beams[0].lives == 7 && g.weapons.beams[1].lives == 8 && g.weapons.beams[2].lives == 9)
    for (var i = 0; i < 3; i++) { g.step() }
    assert(g.subchief.lives == 24)
    g.step()
    assert(g.subchief.lives == 21 && g.weapons.beams[0].lives == 6)

    prepareSubchief(g)
    var beam = g.weapons.beams[0]
    beam.active = true
    beam.x = 0
    beam.y = 100
    beam.lives = 1
    g.step()
    assert(g.subchief.lives == 29 && beam.lives == 0 && beam.active)
    for (var i = 0; i < 5; i++) { g.step() }
    assert(beam.active && g.subchief.lives == 29)
    g.step()
    assert(!beam.active && beam.contactSteps == 0 && g.subchief.lives == 29)

    prepareSubchief(g)
    beam.active = true
    beam.x = 176
    beam.y = 100
    beam.contactSteps = 5
    g.step()
    assert(!beam.active && beam.contactSteps == 0 && g.subchief.lives == 30)
}

test "fatal subchief hit rewards once at lifetime boundaries and leaves recurring items in place" {
    var g = Game()
    var lifetimes = listOf(30, 31, 60, 61)
    var rewards = listOf(600, 300, 300, 150)
    for (var i = 0; i < 4; i++) {
        for (var weapon = 0; weapon < 4; weapon++) {
            prepareSubchief(g)
            g.subchief.lifeTime = lifetimes[i]
            g.subchief.lives = 1
            if (weapon == 0) { g.ship.x = 100 }
            if (weapon == 1) {
                g.weapons.lasers.shots[0].fire(0, 100)
                g.weapons.lasers.shots[0].x = 86
            }
            if (weapon == 2) { g.weapons.blaster.fire(g.ship); g.weapons.blaster.x = 60 }
            if (weapon == 3) {
                for (var beam in g.weapons.beams) { beam.active = true; beam.x = 0; beam.y = 100 }
                g.weapons.beams[1].contactSteps = 5
            }

            g.step()
            assert(g.subchief.phase == SubchiefPhase.Explosion && g.score == rewards[i])
            assert(g.items.size == 2 && g.items[0].x == 9999 && g.items[1].x == 9999)
            assert(g.weapons.level == 0 && g.weapons.charges == 0 && g.ship.lives == 3)
            if (weapon == 3) { assert(g.weapons.beams[0].lives == 9 && g.weapons.beams[1].lives == 9) }
            for (var step = 0; step < 29; step++) { g.step() }
            assert(g.score == rewards[i] && g.stagePosition() == 89 && g.subchief.phase == SubchiefPhase.Explosion)
            g.step()
            assert(g.score == rewards[i] && g.subchief.phase == SubchiefPhase.Inactive)
            for (var step = 0; step < 20; step++) { g.step() }
            assert(g.stagePosition() == 91 && g.subchief.phase == SubchiefPhase.Inactive && g.score == rewards[i])
        }
    }
}

test "enemy shot historical corner geometry explodes normal ship and ignores restart" {
    var g = Game()
    prepareSubchief(g)
    g.subchief.x = 400
    g.subchief.endX = 400
    var shot = g.subchief.shots[0]
    shot.active = true
    shot.x = 24
    shot.y = 100

    g.step()
    assert(g.ship.phase == ShipPhase.Explosion && !shot.active && g.subchief.lives == 30 && g.score == 0)
    prepareSubchief(g)
    g.ship.phase = ShipPhase.Restart
    shot.active = true
    shot.x = 24
    shot.y = 100
    g.step()
    assert(g.ship.phase == ShipPhase.Restart && shot.active && shot.x == 20)
    prepareSubchief(g)
    shot.active = true
    shot.x = -1
    shot.y = 100
    g.step()
    assert(g.ship.phase == ShipPhase.Normal && shot.active && shot.x == -5)
    shot.x = -28
    g.step()
    assert(!shot.active)
}

test "subchief explosion freezes track for thirty steps with historical displacement and pause" {
    var g = Game()
    prepareSubchief(g)
    g.subchief.lives = 1
    g.weapons.lasers.shots[0].fire(0, 100)
    g.weapons.lasers.shots[0].x = 86
    g.meteors[6].active = true
    g.meteors[6].x = 10
    g.meteors[6].y = 219
    g.meteors[7].active = true
    g.meteors[7].x = 10
    g.meteors[7].y = 219
    g.step()
    assert(g.subchief.explosionSteps == 0 && g.subchief.explosionX == 120)
    g.step()
    assert(!g.meteors[6].active && !g.meteors[7].active)
    g.step()
    assert(g.subchief.explosionSteps == 2 && g.subchief.explosionX == 120 && !g.meteors[6].active)
    g.step()
    assert(g.subchief.explosionSteps == 3 && g.subchief.explosionX == 119)
    g.pause()
    var shotX = g.subchief.shots[0].x
    for (var i = 0; i < 12; i++) { g.step() }
    assert(g.subchief.explosionSteps == 3 && g.subchief.explosionX == 119 && g.stagePosition() == 89)
    assert(g.subchief.shots[0].x == shotX && g.subchief.lifeTime == 0)
    g.resume()
    var offsets = listOf(1, 4, 7, 10, 16, 22, 31, 40)
    for (var frame = 1; frame < 9; frame++) {
        if (frame > 1) { for (var i = 0; i < 3; i++) { g.step() } }
        assert(g.subchief.explosionSteps == frame * 3 && g.subchief.explosionX == 120 - offsets[frame - 1])
    }
    for (var i = 0; i < 3; i++) { g.step() }
    assert(g.subchief.explosionSteps == 27 && g.subchief.explosionX == 65)
    for (var i = 0; i < 3; i++) { g.step() }
    assert(g.subchief.phase == SubchiefPhase.Inactive && g.stagePosition() == 89)
    assert(g.meteors[6].active && g.meteors[7].active)
    for (var i = 0; i < 10; i++) { g.step() }
    assert(g.stagePosition() == 90 && g.score == 600)
}

test "defeat during subchief encounter animates without contacts rewards or life changes and restart clears it" {
    var g = Game()
    prepareSubchief(g)
    g.subchief.lives = 1
    g.ship.lives = 1
    g.ship.explode()
    g.ship.explosionSteps = 29
    g.weapons.level = 3
    g.weapons.charges = 1
    g.score = 17
    g.step()
    assert(g.screen == Screen.Result && g.ship.lives == 0 && g.score == 17)
    var x = g.subchief.x
    var steps = g.steps
    for (var i = 0; i < 20; i++) { g.step() }
    assert(g.subchief.x != x && g.subchief.shots[0].active)
    assert(g.subchief.lives == 1 && g.score == 17 && g.ship.lives == 0 && g.stagePosition() == 89)
    assert(g.steps == steps && g.weapons.level == 3 && g.weapons.charges == 0 && g.displayedScore == 17)

    g.subchief.damage(1)
    var explosionX = g.subchief.explosionX
    for (var i = 0; i < 6; i++) { g.step() }
    assert(g.subchief.explosionSteps == 6 && g.subchief.explosionX < explosionX)
    assert(g.score == 17 && g.ship.lives == 0 && g.stagePosition() == 89)
    g.start(922)
    assert(g.subchief.phase == SubchiefPhase.Inactive && g.subchief.lives == 30 && g.subchief.lifeTime == 0)
    assert(g.subchief.explosionSteps == 0 && g.stagePosition() == 5 && g.steps == 0)
    for (var shot in g.subchief.shots) { assert(!shot.active) }
    assert(g.score == 0 && g.ship.lives == 3 && g.weapons.level == 0)
}

test "subchief corner geometry retains inclusive edges and rejects mere rectangle overlap" {
    var g = Game()
    var laserX = listOf(84, 85, 113, 114)
    var expected = listOf(30, 29, 29, 30)
    for (var i = 0; i < 4; i++) {
        prepareSubchief(g)
        g.weapons.lasers.shots[0].active = true
        g.weapons.lasers.shots[0].x = laserX[i]
        g.weapons.lasers.shots[0].y = 100
        g.step()
        assert(g.subchief.lives == expected[i])
    }
    prepareSubchief(g)
    g.weapons.blaster.fire(g.ship)
    g.weapons.blaster.x = 60
    g.weapons.blaster.y = 102
    g.step()
