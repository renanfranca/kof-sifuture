    var destinationX = g.subchief.endX
    var destinationY = g.subchief.endY
    assert(destinationX >= 88 && destinationX <= 147 && destinationY >= 30 && destinationY <= 193)
    prepareSubchief(g)
    g.subchief.x = 100
    g.subchief.y = 80
    g.subchief.endX = 101
    g.subchief.endY = 81
    rng.seed(71)
    g.step()
    assert(g.subchief.endX == destinationX && g.subchief.endY == destinationY)
}


test "simultaneous fatal contacts preserve ship laser blaster special precedence" {
    var g = Game()
    for (var resistance = 1; resistance <= 5; resistance++) {
        prepareSubchief(g)
        g.subchief.lives = resistance
        g.ship.x = 100
        g.weapons.lasers.shots[0].active = true
        g.weapons.lasers.shots[0].x = 86
        g.weapons.lasers.shots[0].y = 100
        g.weapons.blaster.active = true
        g.weapons.blaster.x = 60
        g.weapons.blaster.y = 100
        for (var beam in g.weapons.beams) { beam.active = true; beam.x = 0; beam.y = 100 }

        g.step()
        assert(g.ship.phase == ShipPhase.Explosion && g.subchief.phase == SubchiefPhase.Explosion)
        assert(g.score == 600)
        if (resistance == 1) { assert(!g.weapons.lasers.shots[0].impact) }
        else { assert(g.weapons.lasers.shots[0].impact) }
        if (resistance <= 2) { assert(g.weapons.blaster.lives == 2) }
        else { assert(g.weapons.blaster.lives == 0) }
        if (resistance <= 4) { assert(g.weapons.beams[0].lives == 10) }
        else { assert(g.weapons.beams[0].lives == 9) }
    }
}

prepareAudit(Game g) {
    g.start(922)
    g.stageSteps = 840
    g.subchief.phase = SubchiefPhase.Normal
    g.subchief.x = 120
    g.subchief.y = 100
    g.subchief.endX = 120
    g.subchief.endY = 100
    g.ship.phase = ShipPhase.Normal
    g.ship.y = 100
    for (var m in g.meteors) { m.x = 10000; m.y = -100 }
    for (var item in g.items) { item.x = 10000 }
}

prepareFatalContact(Game g, Int weapon) {
    if (weapon == 0) { g.ship.x = 100 }
    if (weapon == 1) {
        g.weapons.lasers.shots[0].fire(0, 100)
        g.weapons.lasers.shots[0].x = 86
    }
    if (weapon == 2) { g.weapons.blaster.fire(g.ship); g.weapons.blaster.x = 60 }
    if (weapon == 3) {
        for (var beam in g.weapons.beams) { beam.active = true; beam.x = 0; beam.y = 100 }
    }
}

test "fatal contact at historical lifetime thirty keeps six hundred reward before movement or fire" {
    var g = Game()
    for (var weapon = 0; weapon < 4; weapon++) {
        prepareAudit(g)
        g.subchief.endX = 147
        g.subchief.endY = 110
        g.subchief.lives = 1
        g.subchief.lifeTime = 30
        g.subchief.normalSteps = 35
        prepareFatalContact(g, weapon)

        g.step()

        assert(g.score == 600 && g.subchief.lifeTime == 30 && g.subchief.normalSteps == 35)
        assert(g.subchief.x == 120 && g.subchief.y == 100 && g.subchief.explosionSteps == 0)
        for (var shot in g.subchief.shots) { assert(!shot.active) }
        g.step()
        assert(g.score == 600 && g.subchief.explosionSteps == 1)
    }
}

test "fatal contact at historical lifetime sixty keeps three hundred reward before movement or fire" {
    var g = Game()
    for (var weapon = 0; weapon < 4; weapon++) {
        prepareAudit(g)
        g.subchief.endX = 147
        g.subchief.endY = 110
        g.subchief.lives = 1
        g.subchief.lifeTime = 60
        g.subchief.normalSteps = 35
        prepareFatalContact(g, weapon)

        g.step()

        assert(g.score == 300 && g.subchief.lifeTime == 60 && g.subchief.normalSteps == 35)
        assert(g.subchief.x == 120 && g.subchief.y == 100 && g.subchief.explosionSteps == 0)
        for (var shot in g.subchief.shots) { assert(!shot.active) }
    }
}

test "new enemy shot cannot collide before its historical first update" {
    var g = Game()
    prepareAudit(g)
    g.ship.x = 40
    g.subchief.x = 101
    g.subchief.endX = 101
    g.subchief.normalSteps = 11
    g.step()
    println("newShot shipNormal=" + (g.ship.phase == ShipPhase.Normal) + " shotActive=" + g.subchief.shots[0].active)
    assert(g.ship.phase == ShipPhase.Normal && g.subchief.shots[0].active && g.subchief.shots[0].x == 90, "historical enemy collisions precede fire and projectile movement")
    g.step()
    assert(g.ship.phase == ShipPhase.Explosion && !g.subchief.shots[0].active)
}

test "existing enemy shot outside ship cannot hit until next historical step" {
    var g = Game()
    prepareAudit(g)
    g.subchief.shots[0].active = true
    g.subchief.shots[0].x = 51
    g.subchief.shots[0].y = 113
    g.step()
    println("movingShot shipNormal=" + (g.ship.phase == ShipPhase.Normal) + " shotX=" + g.subchief.shots[0].x)
    assert(g.ship.phase == ShipPhase.Normal && g.subchief.shots[0].active && g.subchief.shots[0].x == 47, "historical enemy collisions use the pre-movement shot position")
    g.step()
    assert(g.ship.phase == ShipPhase.Explosion && !g.subchief.shots[0].active)
}

test "nonfatal contacts still move fire and increment the lifetime clock at thirty and sixty" {
    var g = Game()
    for (var lifetime in listOf(30, 60)) {
        for (var weapon = 0; weapon < 4; weapon++) {
            prepareAudit(g)
            g.subchief.endX = 147
            g.subchief.endY = 110
            g.subchief.lifeTime = lifetime
            g.subchief.normalSteps = 35
            prepareFatalContact(g, weapon)

            g.step()

            assert(g.score == 0 && g.subchief.phase == SubchiefPhase.Normal && g.subchief.lives < 30)
            assert(g.subchief.lifeTime == lifetime + 1 && g.subchief.normalSteps == 0)
            assert(g.subchief.x == 121 && g.subchief.y == 101)
            assert(g.subchief.shots[0].active && g.subchief.shots[0].x == 110)
        }
    }
}

test "enemy contact frees first slot for one update without colliding with its replacement" {
    var g = Game()
    prepareAudit(g)
    g.ship.x = 40
    g.subchief.x = 101
    g.subchief.endX = 101
    g.subchief.normalSteps = 11
    for (var shot in g.subchief.shots) { shot.active = true; shot.y = 113 }
    g.subchief.shots[0].x = 40
    g.subchief.shots[1].x = 150
    g.subchief.shots[2].x = 160

    g.step()

    assert(g.ship.phase == ShipPhase.Explosion && g.ship.explosionSteps == 0)
    assert(g.subchief.shots[0].active && g.subchief.shots[0].x == 90)
    assert(g.subchief.shots[1].x == 146 && g.subchief.shots[2].x == 156)
    g.ship.phase = ShipPhase.Normal
    g.step()
    assert(g.ship.phase == ShipPhase.Explosion && !g.subchief.shots[0].active)
}


test "independent pad arrows combine axes and release only their own direction" {
    var g = Game()
    g.start(77)
    g.ship.x = 60
    g.ship.y = 100
    for (var meteor in g.meteors) { meteor.y = 30 }

    g.movement(Direction.Right, true)
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 100)
    g.movement(Direction.Up, true)
    g.step()
    assert(g.ship.x == 70 && g.ship.y == 95, "two held arrows must combine axes")
    g.movement(Direction.Up, false)
    g.step()
    assert(g.ship.x == 75 && g.ship.y == 95)
    g.movement(Direction.Right, false)
    g.step()
    assert(g.ship.x == 75 && g.ship.y == 95)
}


test "duplicate pad events preserve opposite priority and ignore unheld releases" {
    var g = Game()
    g.start(77)
    g.ship.x = 60
    g.ship.phase = ShipPhase.Normal
    for (var meteor in g.meteors) { meteor.y = 30 }

    g.movement(Direction.Right, true)
    g.step()
    assert(g.ship.x == 65 && g.ship.rightFrame)
    g.movement(Direction.Left, true)
    g.movement(Direction.Right, true)
    g.step()
    assert(g.ship.x == 60 && !g.ship.rightFrame, "repeated press must not steal opposite priority")
    g.movement(Direction.Left, false)
    g.movement(Direction.Left, false)
    g.step()
    assert(g.ship.x == 65 && g.ship.rightFrame)
    g.movement(Direction.Right, false)
    g.keyboard(Direction.Up, true)
    g.movement(Direction.Up, false)
    g.movement(Direction.Right, false)
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 95, "unheld pad release must not clear keyboard movement")
}


test "four diagonals preserve either held axis in both press and release orders" {
    var horizontal = listOf(Direction.Right, Direction.Left)
    var vertical = listOf(Direction.Up, Direction.Down)
    var dx = listOf(5, -5)
    var dy = listOf(-5, 5)
    for (var x = 0; x < 2; x++) {
        for (var y = 0; y < 2; y++) {
            for (var order = 0; order < 2; order++) {
                for (var release = 0; release < 2; release++) {
                    var g = Game()
                    g.start(77)
                    g.ship.x = 60
                    g.ship.y = 100
                    g.ship.phase = ShipPhase.Normal
                    for (var meteor in g.meteors) { meteor.y = 30 }
                    if (order == 0) { g.movement(horizontal[x], true); g.movement(vertical[y], true) }
                    else { g.movement(vertical[y], true); g.movement(horizontal[x], true) }
                    g.step()
                    assert(g.ship.x == 60 + dx[x] && g.ship.y == 100 + dy[y])
                    assert(g.ship.rightFrame == (x == 0))
                    if (release == 0) {
                        g.movement(horizontal[x], false)
                        g.step()
                        assert(g.ship.x == 60 + dx[x] && g.ship.y == 100 + 2 * dy[y])
                        assert(!g.ship.rightFrame)
                        g.movement(vertical[y], false)
                    } else {
                        g.movement(vertical[y], false)
                        g.step()
                        assert(g.ship.x == 60 + 2 * dx[x] && g.ship.y == 100 + dy[y])
                        assert(g.ship.rightFrame == (x == 0))
                        g.movement(horizontal[x], false)
                    }
                    var stoppedX = g.ship.x
                    var stoppedY = g.ship.y
                    g.step()
                    assert(g.ship.x == stoppedX && g.ship.y == stoppedY && !g.padPressed() && !g.ship.rightFrame)
                }
            }
        }
    }
}

test "last opposite pad press wins in either axis until its own release" {
    var first = listOf(Direction.Right, Direction.Left, Direction.Up, Direction.Down)
    var second = listOf(Direction.Left, Direction.Right, Direction.Down, Direction.Up)
    var dx = listOf(5, -5, 0, 0)
    var dy = listOf(0, 0, -5, 5)
    for (var i = 0; i < 4; i++) {
        for (var releaseWinner = 0; releaseWinner < 2; releaseWinner++) {
            var g = Game()
            g.start(77)
            g.ship.x = 60
            g.ship.y = 100
            g.ship.phase = ShipPhase.Normal
            for (var meteor in g.meteors) { meteor.y = 30 }
            g.movement(first[i], true)
            g.step()
            assert(g.ship.x == 60 + dx[i] && g.ship.y == 100 + dy[i])
            g.movement(second[i], true)
            g.step()
            assert(g.ship.x == 60 && g.ship.y == 100)
            assert(g.ship.rightFrame == (i == 1))
            if (releaseWinner == 1) {
                g.movement(second[i], false)
                g.step()
                assert(g.ship.x == 60 + dx[i] && g.ship.y == 100 + dy[i])
                assert(g.ship.rightFrame == (i == 0))
                g.movement(first[i], false)
            } else {
                g.movement(first[i], false)
                g.step()
                assert(g.ship.x == 60 - dx[i] && g.ship.y == 100 - dy[i])
                assert(g.ship.rightFrame == (i == 1))
                g.movement(second[i], false)
            }
            var stoppedX = g.ship.x
            var stoppedY = g.ship.y
            g.step()
            assert(g.ship.x == stoppedX && g.ship.y == stoppedY)
        }
    }
}

test "pausing a diagonal clears every pad arrow and requires a new press" {
    var g = Game()
    g.start(77)
    g.ship.x = 60
    g.ship.y = 100
    for (var meteor in g.meteors) { meteor.y = 30 }
    g.movement(Direction.Right, true)
    g.movement(Direction.Up, true)
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 95)
    g.pause()
    g.movement(Direction.Left, true)
    g.movement(Direction.Down, true)
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 95 && !g.padPressed())
    g.resume()
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 95)
    g.movement(Direction.Right, false)
    g.movement(Direction.Up, false)
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 95)
    g.movement(Direction.Down, true)
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 100)
}

test "keyboard memory stays separate while both pad axes own movement" {
    var g = Game()
    g.start(77)
    g.ship.x = 60
    g.ship.y = 100
    for (var meteor in g.meteors) { meteor.y = 30 }
    g.keyboard(Direction.Left, true)
    g.keyboard(Direction.Down, true)
    g.movement(Direction.Right, true)
    g.movement(Direction.Up, true)
    g.clearKeyboard()
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 95)
    g.movement(Direction.Up, false)
    g.keyboard(Direction.Down, false)
    g.keyboard(Direction.Down, true)
    g.step()
    assert(g.ship.x == 70 && g.ship.y == 95)
    g.movement(Direction.Right, false)
    g.keyboard(Direction.Left, true)
    g.keyboard(Direction.Down, true)
    g.step()
    assert(g.ship.x == 70 && g.ship.y == 95)
    g.keyboard(Direction.Left, false)
    g.keyboard(Direction.Left, true)
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 95)
}
