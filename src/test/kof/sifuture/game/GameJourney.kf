    g.step()
    assert(g.weapons.blaster.active && g.weapons.blaster.x == 5)
    assert(g.weapons.blaster.y == 100 && g.weapons.blaster.spriteFrame() == 0)

    g.start(207)
    g.ship.phase = ShipPhase.Normal
    for (var i = 0; i < 3; i++) { g.weapons.evolve() }
    for (var i = 0; i < 5; i++) { g.step() }
    assert(!g.weapons.blaster.active)
    g.step()
    assert(g.weapons.blaster.active && g.weapons.blaster.x == 5)
}

test "blaster destroys two meteors scores once each and finishes four impact frames" {
    var g = Game()
    g.start(208)
    g.ship.phase = ShipPhase.Normal
    g.weapons.blaster.fire(g.ship)
    g.ship.y = 30
