package sifuture.game
import sifuture.game.*

test "finishing with right held restores normal ship while score counts and position freezes" {
    var g = Game()
    g.start(908)
    g.ship.phase = ShipPhase.Normal
    g.ship.x = 40
    g.ship.y = 150
    for (var m in g.meteors) { m.x = 10000; m.y = -100 }
    g.score = 17
    g.steps = 1708
    g.keyboard(Direction.Right, true)
    g.step()
    assert(g.ship.rightFrame && g.ship.x == 45)

    g.step()
    assert(g.screen == Screen.Result && !g.ship.rightFrame)
    assert(!g.ship.right && g.ship.x == 50 && g.ship.y == 150)
    g.keyboard(Direction.Right, false)
    for (var i = 0; i < 4; i++) { g.step() }
    assert(!g.ship.rightFrame && g.ship.x == 50 && g.ship.y == 150)
    assert(g.displayedScore == 17 && g.score == 17 && g.steps == 1710)
}

test "vertical bottom exit uses full historical range and waits inactive with clean animation" {
    var g = Game()
    g.start(904)
    g.steps = 260
    g.step()
    var first = g.meteors[6]
    var second = g.meteors[7]
    first.x = 80
    first.y = 220
    first.frame = 2
    first.frameDirection = -1
    first.frameSteps = 1
    first.collide()
    first.collisionSteps = 1
    second.x = 120
    second.y = -100
    rng.seed(71)

    g.step()
    assert(first.x == 70 && first.y == -171)
    assert(!first.active && !first.collided && first.collisionSteps == 0)
    assert(first.frame == 0 && first.frameDirection == 1 && first.frameSteps == 0)
    var nextDraw = rng.int(1000)
    g.step()
    assert(!first.active && first.y == -171 && second.active)
    second.y = 220
    g.step()
    assert(!first.active && !second.active)
    g.step()
    assert(first.active && second.active && first.y == -170)

    g.start(904)
    g.steps = 260
    g.step()
    g.meteors[6].y = 220
    g.meteors[7].y = -100
    rng.seed(71)
    g.step()
    assert(g.meteors[6].x == 70 && g.meteors[6].y == -171)
    assert(rng.int(1000) == nextDraw)
    rng.seed(71)
    assert(rng.int(176) == 70 && rng.int(172) == 171)
    assert(rng.int(1000) == nextDraw)
}

test "pause and lost keyboard focus clear right image without changing opposing direction priority" {
    for (var pause = 0; pause < 2; pause++) {
        var g = Game()
        g.start(909)
        g.ship.phase = ShipPhase.Normal
        g.ship.x = 60
        for (var m in g.meteors) { m.x = 10000; m.y = -100 }
        g.keyboard(Direction.Left, true)
        g.keyboard(Direction.Right, true)
        g.step()
        assert(g.ship.x == 65 && g.ship.rightFrame)

        if (pause == 1) { g.pause() }
        else { g.clearKeyboard() }
        assert(!g.ship.rightFrame && !g.ship.left && !g.ship.right)
        g.step()
        assert(g.ship.x == 65 && !g.ship.rightFrame)
        if (pause == 1) { g.resume() }
        g.keyboard(Direction.Left, false)
        g.keyboard(Direction.Right, false)
        g.keyboard(Direction.Right, true)
        g.keyboard(Direction.Left, true)
        g.step()
        assert(g.ship.x == 60 && !g.ship.rightFrame)
        g.keyboard(Direction.Left, false)
        g.step()
        assert(g.ship.x == 65 && g.ship.rightFrame)
    }
}

test "vertical initial and impact resets keep reduced range while bottom exits include both full endpoints" {
    var g = Game()
    g.start(910)
    for (var i = 6; i < 8; i++) {
        assert(!g.meteors[i].active && g.meteors[i].x >= 0 && g.meteors[i].x < 176)
        assert(g.meteors[i].y >= -153 && g.meteors[i].y <= 0)
    }
    var m = g.meteors[6]
    var seeds = listOf(71, 142, 276, 303)
    var expectedX = listOf(70, 143, 8, 145)
    var resetY = listOf(-103, -100, -153, 0)
    var bottomY = listOf(-171, 0, -145, -84)
    for (var i = 0; i < seeds.size; i++) {
        rng.seed(seeds[i])
        m.reset()
        assert(m.x == expectedX[i] && m.y == resetY[i] && !m.active)
        var afterReset = rng.int(1000)

        m.active = true
        m.x = 80
        m.y = 50
        m.frame = 2
        m.frameDirection = -1
        m.collide()
        rng.seed(seeds[i])
        for (var j = 0; j < 3; j++) { m.advance() }
        assert(m.x == expectedX[i] && m.y == resetY[i] && !m.active)
        assert(!m.collided && m.collisionSteps == 0)
        assert(m.frame == 0 && m.frameDirection == 1 && m.frameSteps == 0)
        assert(rng.int(1000) == afterReset)

        m.active = true
        m.y = 220
        rng.seed(seeds[i])
        m.advance()
        assert(m.x == expectedX[i] && m.y == bottomY[i] && !m.active)
        assert(rng.int(1000) == afterReset)
    }
    for (var seed = 0; seed < 500; seed++) {
        rng.seed(seed)
        m.reset()
        assert(m.x >= 0 && m.x < 176 && m.y >= -153 && m.y <= 0)
        m.active = true
        m.y = 220
        rng.seed(seed)
        m.advance()
        assert(m.x >= 0 && m.x < 176 && m.y >= -171 && m.y <= 0)
    }
}

test "eight pad zones move by axis and stop on release" {
    var zones = listOf(Zone.NorthWest, Zone.North, Zone.NorthEast, Zone.West, Zone.East, Zone.SouthWest, Zone.South, Zone.SouthEast)
    var dx = listOf(-5, 0, 5, -5, 5, -5, 0, 5)
    var dy = listOf(-5, -5, -5, 0, 0, 5, 5, 5)
    for (var i = 0; i < 8; i++) {
        var g = Game()
        g.start(100 + i)
        g.ship.x = 60
        g.ship.y = 100
        g.movement(zones[i], true)
        g.step()
        assert(g.ship.x == 60 + dx[i] && g.ship.y == 100 + dy[i])
        g.movement(zones[i], false)
        g.step()
        assert(g.ship.x == 60 + dx[i] && g.ship.y == 100 + dy[i])
    }
}

test "pad owns movement until held keyboard keys are released and pressed again" {
    var g = Game()
    g.start(101)
    g.ship.x = 60
    g.keyboard(Direction.Right, true)
    g.movement(Zone.West, true)
    g.keyboard(Direction.Up, true)
    g.movement(Zone.East, true)
    g.step()
    assert(g.ship.x == 55 && g.ship.y == 100)
    g.movement(Zone.East, false)
    g.step()
    assert(g.ship.x == 50 && g.activeZone == Zone.West)
    g.movement(Zone.West, false)
    g.keyboard(Direction.Right, true)
    g.keyboard(Direction.Up, true)
    g.step()
    assert(g.ship.x == 50 && g.ship.y == 100)
    g.keyboard(Direction.Right, false)
    g.keyboard(Direction.Right, true)
    g.step()
    assert(g.ship.x == 55 && g.ship.y == 100)
}

test "pause freezes ship lasers meteors and counters then resumes without movement" {
    var g = Game()
    g.start(102)
    g.ship.phase = ShipPhase.Normal
    g.keyboard(Direction.Right, true)
    g.step()
    g.pause()
    var x = g.ship.x
    var meteorX = g.meteors[0].x
    var steps = g.steps
    var fireSteps = g.weapons.fireSteps
    var score = g.score
    var lives = g.ship.lives
    for (var i = 0; i < 50; i++) { g.step() }
    assert(g.screen == Screen.Pause && g.ship.x == x)
    assert(g.meteors[0].x == meteorX && g.steps == steps)
    assert(g.weapons.fireSteps == fireSteps && g.score == score && g.ship.lives == lives)
    g.confirm()
    g.step()
    assert(g.screen == Screen.Play && g.ship.x == x && g.steps == steps + 1)
}

test "held arrow cannot restart movement after resume without a release" {
    var g = Game()
    g.start(103)
    g.ship.x = 60
    g.keyboard(Direction.Right, true)
    g.step()
    g.pause()
    g.resume()
    g.keyboard(Direction.Right, true)
    g.step()
    assert(g.ship.x == 65)
    g.keyboard(Direction.Right, false)
    g.keyboard(Direction.Right, true)
    g.step()
    assert(g.ship.x == 70)
}

test "arrow observed outside canvas waits for release before moving" {
    var g = Game()
    g.start(107)
    g.ship.x = 60

    g.keyboard(Direction.Right, true, false)
    g.keyboard(Direction.Right, true, true)
    g.step()
    assert(g.ship.x == 60)

    g.keyboard(Direction.Right, false, false)
    g.keyboard(Direction.Right, true, true)
    g.step()
    assert(g.ship.x == 65)
}

test "canvas click rearms arrows after lost release and next press moves" {
    var g = Game()
    g.start(108)
    g.ship.x = 60

    g.keyboard(Direction.Right, true)
    g.step()
    g.clearKeyboard()
    g.rearmKeyboard()
    g.step()
    assert(g.ship.x == 65)

    g.keyboard(Direction.Right, true)
    g.step()
    assert(g.ship.x == 70)
}

test "canvas click preserves active pad movement and rearms keyboard" {
    var g = Game()
    g.start(109)
    g.ship.x = 60
    g.keyboard(Direction.Right, true)
    g.movement(Zone.West, true)

    g.rearmKeyboard()
    g.step()
    assert(g.activeZone == Zone.West && g.ship.x == 55)

    g.movement(Zone.West, false)
    g.keyboard(Direction.Right, true)
    g.step()
    assert(g.ship.x == 60)
}

test "pause holds explosion and restart frames without consuming a life" {
    var phases = listOf(ShipPhase.Explosion, ShipPhase.Restart)
    for (var i = 0; i < 2; i++) {
        var g = Game()
        g.start(104 + i)
        g.ship.phase = phases[i]
        g.ship.explosionSteps = 12
        g.ship.restartFrame = 20
        g.meteors[0].collided = true
        g.meteors[0].collisionSteps = 2
        g.weapons.lasers.shots[0].active = true
        g.weapons.lasers.shots[0].x = 44
        g.pause()
        for (var j = 0; j < 50; j++) { g.step() }
        assert(g.ship.phase == phases[i] && g.ship.lives == 3)
        assert(g.ship.explosionSteps == 12 && g.ship.restartFrame == 20)
        assert(g.meteors[0].collisionSteps == 2 && g.weapons.lasers.shots[0].x == 44)
        assert(g.steps == 0)
    }
}

test "pausing and returning from result leave no directional movement" {
    var g = Game()
    g.start(106)
    g.ship.x = 60
    g.movement(Zone.East, true)
    g.pause()
    assert(g.activeZone == Zone.Neutral && !g.ship.right)
    g.resume()
    g.step()
    assert(g.ship.x == 60)
    g.ship.lives = 0
    g.step()
    assert(g.screen == Screen.Result && g.activeZone == Zone.Neutral)
    g.confirm()
    g.confirm()
    g.step()
    assert(g.screen == Screen.Play && g.activeZone == Zone.Neutral && !g.ship.right)
}


test "same seed produces the same meteors" {
    var a = Game()
    a.start(42)
    var x = a.meteors[0].x
    var y = a.meteors[0].y
    a.start(42)
    assert(a.meteors[0].x == x && a.meteors[0].y == y)
}

test "ship moves five units and stops at bounds and release" {
    var g = Game()
    g.start(1)
    g.ship.direction(Direction.Right, true)
    g.step()
    assert(g.ship.x == 5)
    g.ship.direction(Direction.Right, false)
    g.step()
    assert(g.ship.x == 5)
    g.ship.x = 125
    g.ship.direction(Direction.Right, true)
    g.step()
    assert(g.ship.x == 126)
    g.ship.y = 31
    g.ship.direction(Direction.Up, true)
    g.step()
    assert(g.ship.y == 30)
    g.ship.direction(Direction.Up, false)
    g.ship.y = 199
    g.ship.direction(Direction.Down, true)
    g.step()
    assert(g.ship.y == 200)
}

test "normal fire starts on thirteenth step and earns five points" {
    var g = Game()
    g.start(2)
    g.ship.phase = ShipPhase.Normal
    for (var i = 0; i < 12; i++) { g.step() }
    assert(!g.weapons.lasers.shots[0].active)
    g.step()
    assert(g.weapons.lasers.shots[0].active)
    g.ship.y = 50
    g.meteors[0].x = g.weapons.lasers.shots[0].x + 4
    g.meteors[0].y = g.weapons.lasers.shots[0].y
    g.step()
    assert(g.score == 5)
    assert(g.weapons.lasers.shots[0].active && g.weapons.lasers.shots[0].impact)
}

test "three meteor hits end the attempt and result persists" {
    var g = Game()
    g.start(3)
    for (var i = 0; i < 3; i++) {
        g.ship.phase = ShipPhase.Normal
        g.meteors[0].x = g.ship.x + 10
        g.meteors[0].y = g.ship.y
        g.step()
        assert(g.ship.phase == ShipPhase.Explosion && g.ship.lives == 3 - i)
        for (var j = 0; j < 30; j++) { g.step() }
    }
    assert(g.ship.lives == 0 && g.screen == Screen.Result)
    g.step()
    assert(g.screen == Screen.Result)
    g.confirm()
    assert(g.screen == Screen.Result && g.countComplete())
    g.confirm()
    assert(g.screen == Screen.Menu)
    g.start(3)
    assert(g.ship.lives == 3 && g.score == 0 && g.steps == 0)
}

test "all result boundaries select a message" {
    var g = Game()
    g.score = 1499
    assert(g.resultIndex() == 0)
    g.score = 1500
    assert(g.resultIndex() == 1)
    g.score = 2199
    assert(g.resultIndex() == 1)
    g.score = 2200
    assert(g.resultIndex() == 2)
    g.score = 3299
    assert(g.resultIndex() == 2)
    g.score = 3300
    assert(g.resultIndex() == 3)
}

test "initial restart is invulnerable for fifteen three-step alternations" {
    var g = Game()
    g.start(11)
    assert(g.ship.phase == ShipPhase.Restart && g.ship.restartFrame == 0)
    for (var i = 0; i < 44; i++) {
        g.meteors[0].x = g.ship.x + 10
        g.meteors[0].y = g.ship.y
        g.step()
        assert(g.ship.lives == 3 && g.ship.phase == ShipPhase.Restart)
    }
    assert(g.ship.restartFrame == 44)
    g.meteors[0].x = 400
    g.step()
    assert(g.ship.phase == ShipPhase.Normal && g.ship.lives == 3)
}

test "restart ends before collision on step forty five but fire waits" {
    var g = Game()
    g.start(71)
    g.ship.restartFrame = 43
    g.weapons.fireSteps = 12
    for (var m in g.meteors) { m.x = 400; m.y = 30 }
    g.meteors[0].x = 11
    g.meteors[0].y = 100
    g.step()
    assert(g.ship.phase == ShipPhase.Restart && g.score == 0 && g.weapons.fireSteps == 12)
    g.meteors[0].x = 11
    g.step()
    assert(g.ship.phase == ShipPhase.Explosion && g.score == 5)
    assert(g.weapons.fireSteps == 12 && !g.weapons.lasers.shots[0].active)
}

test "one ship collision marks every overlapping meteor and scores once" {
    var g = Game()
    g.start(73)
    g.ship.phase = ShipPhase.Normal
    for (var m in g.meteors) { m.x = 400; m.y = 30 }
    g.meteors[0].x = 20
    g.meteors[0].y = 100
    g.meteors[1].x = 30
    g.meteors[1].y = 100
    g.step()
    assert(g.ship.phase == ShipPhase.Explosion && g.score == 5)
    assert(g.meteors[0].collided && g.meteors[1].collided)
    for (var i = 0; i < 5; i++) { g.step() }
    assert(g.meteors[0].collided && g.meteors[1].collided && g.score == 5)
    g.step()
    assert(!g.meteors[0].collided && !g.meteors[1].collided)
    assert(g.meteors[0].x >= 176 && g.meteors[1].x >= 176 && g.score == 5)
}

test "last pressed opposite direction wins until released" {
    var g = Game()
    g.start(9)
    g.ship.x = 60
    g.ship.y = 100
    g.ship.direction(Direction.Left, true)
    g.ship.direction(Direction.Right, true)
    g.ship.direction(Direction.Up, true)
    g.ship.direction(Direction.Down, true)
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 105)
    g.ship.direction(Direction.Right, false)
    g.ship.direction(Direction.Down, false)
    g.step()
    assert(g.ship.x == 60 && g.ship.y == 100)
}

test "reversed opposing keys choose the latest and restore the held key on release" {
    var g = Game()
    g.start(91)
    g.ship.phase = ShipPhase.Normal
    g.ship.x = 60
    g.ship.y = 100
    for (var m in g.meteors) { m.x = 400; m.y = 30 }

    g.ship.direction(Direction.Right, true)
    g.ship.direction(Direction.Left, true)
    g.ship.direction(Direction.Down, true)
    g.ship.direction(Direction.Up, true)
    g.step()
    assert(g.ship.x == 55 && g.ship.y == 95 && !g.ship.rightFrame)

    g.ship.direction(Direction.Left, false)
    g.ship.direction(Direction.Up, false)
    g.step()
    assert(g.ship.x == 60 && g.ship.y == 100 && g.ship.rightFrame)
}

test "basic laser allows only one active shot and retries each thirteen normal steps" {
    var g = Game()
    g.start(7)
    g.ship.phase = ShipPhase.Normal
    for (var i = 0; i < 13; i++) { g.step() }
    assert(g.weapons.lasers.shots[0].active)
    var firstX = g.weapons.lasers.shots[0].x
    for (var i = 0; i < 13; i++) { g.step() }
    assert(g.weapons.lasers.shots[0].active && g.weapons.lasers.shots[0].x > firstX)
    assert(!g.weapons.lasers.shots[1].active && !g.weapons.lasers.shots[2].active)
    g.weapons.lasers.shots[0].active = false
    for (var i = 0; i < 13; i++) { g.step() }
    assert(g.weapons.lasers.shots[0].active)
}

test "ship collision scores once and explosion blocks movement and fire for thirty steps" {
    var g = Game()
    g.start(17)
    g.ship.phase = ShipPhase.Normal
    g.ship.direction(Direction.Right, true)
    g.meteors[0].x = 20
    g.meteors[0].y = 100
    g.step()
    assert(g.score == 5 && g.ship.lives == 3 && g.ship.phase == ShipPhase.Explosion)
    var x = g.ship.x
    for (var i = 0; i < 29; i++) {
        g.step()
        assert(g.ship.x == x && g.ship.lives == 3 && !g.weapons.lasers.shots[0].active)
    }
    assert(g.ship.explosionSteps == 29)
    g.step()
    assert(g.ship.lives == 2 && g.ship.phase == ShipPhase.Restart && g.ship.x == 5)
}

test "laser hit holds meteor collision images for three pairs of steps" {
    var g = Game()
    g.start(21)
    g.ship.phase = ShipPhase.Normal
    for (var i = 0; i < 13; i++) { g.step() }
    g.ship.y = 50
    g.meteors[0].x = g.weapons.lasers.shots[0].x + 4
    g.meteors[0].y = g.weapons.lasers.shots[0].y
    g.step()
    assert(g.score == 5 && g.meteors[0].collided)
    var x = g.meteors[0].x
    for (var i = 0; i < 5; i++) {
        g.step()
        assert(g.meteors[0].collided && g.meteors[0].x == x - i - 1 && g.score == 5)
        assert(g.meteors[0].collisionSteps / 2 == (i + 1) / 2)
    }
    g.step()
    assert(!g.meteors[0].collided && g.meteors[0].x >= 176)
}

test "ship image follows horizontal direction and last opposing key" {
    var g = Game()
    g.start(63)
    assert(!g.ship.rightFrame)
    g.ship.phase = ShipPhase.Normal
    g.ship.direction(Direction.Right, true)
    g.step()
    assert(g.ship.rightFrame)
    g.ship.direction(Direction.Left, true)
    g.step()
    assert(!g.ship.rightFrame)
    g.ship.direction(Direction.Left, false)
    g.step()
    assert(g.ship.rightFrame)
    g.ship.direction(Direction.Right, false)
    g.step()
    assert(!g.ship.rightFrame)
    g.ship.direction(Direction.Up, true)
    g.step()
    assert(!g.ship.rightFrame)
    g.ship.direction(Direction.Left, true)
    g.step()
    assert(!g.ship.rightFrame)
}

test "meteor sprite advances every two steps and returns through the historical frames" {
    var g = Game()
    g.start(31)
    var m = g.meteors[0]
    assert(m.frame == 0)
    g.step()
    assert(m.frame == 0)
    g.step()
    assert(m.frame == 1)
    for (var i = 0; i < 8; i++) { g.step() }
    assert(m.frame == 5)
    g.step()
    g.step()
    assert(m.frame == 4)
}

test "ship collision takes priority when its laser reaches the same meteor" {
    var g = Game()
    g.start(33)
    g.ship.phase = ShipPhase.Normal
    g.meteors[0].x = 20
    g.meteors[0].y = 100
    g.weapons.lasers.shots[0].x = 20
    g.weapons.lasers.shots[0].y = 100
    g.weapons.lasers.shots[0].active = true
    g.step()
    assert(g.ship.phase == ShipPhase.Explosion && g.score == 5 && g.weapons.lasers.shots[0].active)
}

test "ship meteor collision uses meteor left edge and inclusive ship bounds" {
    var g = Game()
    g.start(51)
    g.ship.phase = ShipPhase.Normal
    g.meteors[0].x = -5
    g.meteors[0].y = 100
    g.step()
    assert(g.score == 0 && g.ship.phase == ShipPhase.Normal)
    g.meteors[0].x = 51
    g.meteors[0].y = 100
    g.step()
    assert(g.score == 5 && g.ship.phase == ShipPhase.Explosion)
}

test "laser meteor collision uses historical tip and bottom conditions" {
    var g = Game()
    g.start(53)
    g.ship.phase = ShipPhase.Normal
    g.ship.y = 50
    g.weapons.lasers.shots[0].active = true
    g.weapons.lasers.shots[0].x = 0
    g.weapons.lasers.shots[0].y = 110
    g.meteors[0].x = 10
    g.meteors[0].y = 100
    g.step()
    assert(g.score == 0 && !g.meteors[0].collided)
    g.weapons.lasers.shots[0].x = 0
    g.weapons.lasers.shots[0].y = 100
    g.meteors[0].x = 36
    g.step()
    assert(g.score == 5 && g.meteors[0].collided)
}

test "laser impact remains at meteor for one rendered step without scoring twice" {
    var g = Game()
    g.start(55)
    g.ship.phase = ShipPhase.Normal
    g.ship.y = 50
    g.weapons.lasers.shots[0].active = true
    g.weapons.lasers.shots[0].x = 0
    g.weapons.lasers.shots[0].y = 100
    g.meteors[0].x = 36
    g.meteors[0].y = 100
    g.step()
    assert(g.score == 5 && g.weapons.lasers.shots[0].active && g.weapons.lasers.shots[0].impact)
    assert(g.weapons.lasers.shots[0].x == g.meteors[0].x && g.weapons.lasers.shots[0].y == g.meteors[0].y)
    g.step()
    assert(g.score == 5 && !g.weapons.lasers.shots[0].active && !g.weapons.lasers.shots[0].impact)
    assert(g.meteors[0].collided)
}

test "background moves five units wraps at sixty and pauses" {
    var g = Game()
    g.start(201)
    assert(g.background.offset == 0)
    g.step()
    assert(g.background.offset == 5)
    g.pause()
    g.step()
    assert(g.background.offset == 5)
    g.resume()
    for (var i = 0; i < 11; i++) { g.step() }
    assert(g.background.offset == 0)
    g.start(201)
    assert(g.background.offset == 0)
}

test "both items start offscreen reproduce their seed and relaunch after exit" {
    var g = Game()
    g.start(202)
    var x = g.items[0].x
    var y = g.items[0].y
    assert(x >= 220 && x < 420 && y >= 30 && y < 204)
    assert(g.items[1].x >= 220 && g.items[1].x < 420)
    g.step()
    assert(g.items[0].x == x - 1)
    g.start(202)
    assert(g.items[0].x == x && g.items[0].y == y)
    g.items[0].x = -20
    g.step()
    assert(g.items[0].x >= 220 && g.items[0].frame == 0)
}

test "life collection adds one life above three and ten points exactly once" {
    var g = Game()
    g.start(203)
    g.ship.phase = ShipPhase.Normal
    var item = g.items[1]
    item.x = 11
    item.y = 100

    g.step()
    assert(g.ship.lives == 4 && g.score == 10 && item.collected)
    assert(item.effectSteps == 0)
    for (var i = 0; i < 5; i++) { g.step() }
    assert(g.ship.lives == 4 && g.score == 10 && item.effectSteps == 5)
    g.step()
    assert(!item.collected && item.x >= 220 && g.score == 10)
}

test "evolution collections reach level three then add special charges" {
    var g = Game()
    g.start(204)
    g.ship.phase = ShipPhase.Normal
    for (var m in g.meteors) { m.y = 30 }
    for (var i = 0; i < 5; i++) {
        var item = g.items[0]
        item.x = 11
        item.y = 100
        item.collected = false
        g.step()
        if (i < 3) { assert(g.weapons.level == i + 1 && g.weapons.charges == 0) }
        else { assert(g.weapons.level == 3 && g.weapons.charges == i - 2) }
    }
    assert(g.score == 50)
}

test "evolution cycles five frames and life travels eleven frames forward and back" {
    var g = Game()
    g.start(205)
    for (var i = 0; i < 8; i++) { g.step() }
    assert(g.items[0].frame == 4 && g.items[1].frame == 4)
    g.step()
    g.step()
    assert(g.items[0].frame == 0 && g.items[1].frame == 5)
    for (var i = 0; i < 10; i++) { g.step() }
    assert(g.items[1].frame == 10)
    g.step()
    g.step()
    assert(g.items[1].frame == 9)
    for (var i = 0; i < 18; i++) { g.step() }
    assert(g.items[1].frame == 0)
}

test "evolved laser launches one per attempt into first free slot and animates" {
    var g = Game()
    g.start(206)
    g.ship.phase = ShipPhase.Normal
    g.weapons.evolve()
    for (var m in g.meteors) { m.y = 30 }
    for (var i = 0; i < 13; i++) { g.step() }
    assert(g.weapons.lasers.shots[0].active && !g.weapons.lasers.shots[1].active)
    for (var i = 0; i < 13; i++) { g.step() }
    assert(g.weapons.lasers.shots[0].active && g.weapons.lasers.shots[1].active)
    assert(!g.weapons.lasers.shots[2].active)
    assert(g.weapons.lasers.shots[0].spriteFrame() == 2)
    g.weapons.lasers.shots[0].active = false
    for (var i = 0; i < 13; i++) { g.step() }
    assert(g.weapons.lasers.shots[0].active && !g.weapons.lasers.shots[2].active)
}

test "second evolution blaster begins after six laser cycles and third begins on step six" {
    var g = Game()
