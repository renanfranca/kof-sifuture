    prepareSubchief(g)
    g.ship.x = 100
    g.subchief.y = 80
    g.subchief.endY = 80
    g.step()
    assert(g.ship.phase == ShipPhase.Explosion && g.subchief.lives == 29)
    prepareSubchief(g)
    g.ship.x = 100
    g.subchief.x = 80
    g.subchief.endX = 80
    g.step()
    assert(g.ship.phase == ShipPhase.Explosion && g.subchief.lives == 29)
}

test "marked exhausted special beam still reapplies when next color enters contact" {
    var g = Game()
    prepareSubchief(g)
    for (var beam in g.weapons.beams) { beam.active = true; beam.x = 0; beam.y = 100 }
    g.weapons.beams[0].lives = 1
    g.step()
    assert(g.subchief.lives == 29 && g.weapons.beams[0].lives == 0)
    g.step()
    assert(g.subchief.lives == 27 && g.weapons.beams[0].lives == -1 && g.weapons.beams[1].lives == 9)
    g.step()
    assert(g.subchief.lives == 24 && g.weapons.beams[0].lives == -2 && g.weapons.beams[2].lives == 9)
    assert(g.weapons.beams[0].deathSteps == 0, "each nonpositive hit restarts the historical death animation")
    for (var i = 0; i < 4; i++) { g.step() }
    assert(g.weapons.beams[0].active && g.weapons.beams[0].contactSteps == 6 && g.weapons.beams[0].deathSteps == 4)
    g.step()
    assert(g.weapons.beams[0].lives == -3 && g.weapons.beams[0].deathSteps == 0)
    g.step()
    assert(g.weapons.beams[0].lives == -4 && g.weapons.beams[0].deathSteps == 0)
    g.subchief.phase = SubchiefPhase.Explosion
    for (var i = 0; i < 5; i++) { g.step() }
    assert(g.weapons.beams[0].active && g.weapons.beams[0].deathSteps == 5 && g.weapons.beams[0].contactSteps == 6)
    g.step()
    assert(!g.weapons.beams[0].active && g.weapons.beams[0].contactSteps == 0)
}

test "subchief moves one unit on both axes and arrival selects reproducible new destination" {
    var g = Game()
    prepareSubchief(g)
