import sifuture.game.Weapons

test "a normal ship with lives keeps firing lasers on the result screen" {
    var g = givenNormalShipOnResult(331)

    advanceSteps(g, 15)

    assert(g.screen == Screen.Result)
    assert(!noProjectileActive(g))
}

test "the result screen releases a dormant vertical meteor pair" {
    var g = givenNormalShipOnResult(332)
    g.meteors[6].active = false
    g.meteors[7].active = false

    g.step()

    assert(g.screen == Screen.Result)
    assert(g.meteors[6].active && g.meteors[7].active)
}

Game givenNormalShipOnResult(Int seed) {
    var g = givenNormalShip(seed)
    g.ship.x = 40
    g.ship.y = 150
    givenMeteorsAway(g)
    givenItemsAway(g)
    g.stageSteps = 1709
    g.step()
    for (var shot in g.weapons.lasers.shots) { shot.active = false }
    return g
}
