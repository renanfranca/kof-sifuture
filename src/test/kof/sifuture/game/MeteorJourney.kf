test "vertical bottom exit uses full historical range and waits inactive with clean animation" {
    var g = givenCollidedVerticalMeteorLeavingAtBottom(904, 71)
    var first = g.meteors[6]
    var second = g.meteors[7]

    g.step()
    assert(first.x == 70)
    assert(first.y == -171)
    assert(!first.active)
    assert(!first.collided)
    assert(first.collisionSteps == 0)
    assert(first.frame == 0)
    assert(first.frameDirection == 1)
    assert(first.frameSteps == 0)
    var nextDraw = rng.int(1000)
    g.step()
    assert(!first.active)
    assert(first.y == -171)
    assert(second.active)
    second.y = 220
    g.step()
    assert(!first.active)
    assert(!second.active)
    g.step()
    assert(first.active)
    assert(second.active)
    assert(first.y == -170)

    startVerticalPairInPlay(g, 904)
    g.meteors[6].y = 220
    g.meteors[7].y = -100
    rng.seed(71)
    g.step()
    assert(g.meteors[6].x == 70)
    assert(g.meteors[6].y == -171)
    assert(rng.int(1000) == nextDraw)
    rng.seed(71)
    assert(rng.int(176) == 70)
    assert(rng.int(172) == 171)
    assert(rng.int(1000) == nextDraw)
}

test "vertical meteors start waiting inside the reduced range" {
    var g = Game()
    g.start(910)
    assert(!g.meteors[6].active && g.meteors[6].x >= 0 && g.meteors[6].x < 176)
    assert(g.meteors[6].y >= -153 && g.meteors[6].y <= 0)
    assert(!g.meteors[7].active && g.meteors[7].x >= 0 && g.meteors[7].x < 176)
    assert(g.meteors[7].y >= -153 && g.meteors[7].y <= 0)
}

test "vertical seed 71 resets to x 70 y -103 after impact and exits the bottom to y -171" {
    var m = givenVerticalMeteor(910)
    rng.seed(71)
    m.reset()
    assert(m.x == 70 && m.y == -103 && !m.active)
    var afterReset = rng.int(1000)
    givenCollidedInFlight(m)
    rng.seed(71)
    advanceMeteor(m, 3)
    assert(m.x == 70 && m.y == -103 && !m.active)
    assert(!m.collided && m.collisionSteps == 0)
    assert(m.frame == 0 && m.frameDirection == 1 && m.frameSteps == 0)
    assert(rng.int(1000) == afterReset)
    m.active = true
    m.y = 220
    rng.seed(71)
    m.advance()
    assert(m.x == 70 && m.y == -171 && !m.active)
    assert(rng.int(1000) == afterReset)
}

