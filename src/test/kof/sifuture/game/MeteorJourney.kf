test "laser meteor collision uses historical tip and bottom conditions" {
    var g = givenNormalShipWithLaserFlyingAt(53, 0, 110)
    g.meteors[0].x = 10
    g.meteors[0].y = 100
    g.step()
    assert(g.score == 0 && !g.meteors[0].collided)
    g.weapons.lasers.shots[0].x = 0
    g.weapons.lasers.shots[0].y = 100
    g.meteors[0].x = 36
    g.step()
    assert(g.score == 5 && g.meteors[0].collided)
}

test "laser impact remains at meteor for one rendered step without scoring twice" {
    var g = givenNormalShipWithLaserFlyingAt(55, 0, 100)
    g.meteors[0].x = 36
    g.meteors[0].y = 100
    g.step()
    assert(g.score == 5 && g.weapons.lasers.shots[0].active && g.weapons.lasers.shots[0].impact)
    assert(g.weapons.lasers.shots[0].x == g.meteors[0].x && g.weapons.lasers.shots[0].y == g.meteors[0].y)
    g.step()
    assert(g.score == 5 && !g.weapons.lasers.shots[0].active && !g.weapons.lasers.shots[0].impact)
    assert(g.meteors[0].collided)
}

Game givenCollidedVerticalMeteorLeavingAtBottom(Int seed, Int rngSeed) {
    var g = givenVerticalPairInPlay(seed)
    var first = g.meteors[6]
    first.x = 80
    first.y = 220
    first.frame = 2
    first.frameDirection = -1
    first.frameSteps = 1
    first.collide()
    first.collisionSteps = 1
    g.meteors[7].x = 120
    g.meteors[7].y = -100
    rng.seed(rngSeed)
    return g
}

Meteor givenVerticalMeteor(Int seed) {
    var g = Game()
    g.start(seed)
    return g.meteors[6]
}

givenCollidedInFlight(Meteor m) {
    m.active = true
    m.x = 80
    m.y = 50
    m.frame = 2
    m.frameDirection = -1
    m.collide()
}

advanceMeteor(Meteor m, Int steps) {
    for (var i = 0; i < steps; i++) { m.advance() }
}

Bool verticalResetsAndBottomExitsStayInRange(Meteor m, Int seeds) {
    var inRange = true
    for (var seed = 0; seed < seeds; seed++) {
        rng.seed(seed)
        m.reset()
        inRange = inRange && m.x >= 0 && m.x < 176 && m.y >= -153 && m.y <= 0
        m.active = true
        m.y = 220
        rng.seed(seed)
        m.advance()
        inRange = inRange && m.x >= 0 && m.x < 176 && m.y >= -171 && m.y <= 0
    }
    return inRange
}

Bool horizontalResetsStayBelowTheHeader(Meteor meteor, Int resets) {
    var inRange = true
    for (var i = 0; i < resets; i++) {
        meteor.reset()
        inRange = inRange && meteor.x >= 176 && meteor.x <= 375 && meteor.y >= 30 && meteor.y <= 201
    }
    return inRange
}

hitNormalShipWithMeteor(Game g) {
    g.ship.phase = ShipPhase.Normal
    g.meteors[0].x = g.ship.x + 10
    g.meteors[0].y = g.ship.y
    g.step()
}

Bool laserStaysIdleDuring(Game g, Int steps) {
    var idle = true
    for (var i = 0; i < steps; i++) {
        g.step()
        idle = idle && !g.weapons.lasers.shots[0].active
    }
    return idle
}

Bool restartingShipIgnoresMeteorContactDuring(Game g, Int steps) {
    var ignored = true
    for (var i = 0; i < steps; i++) {
        g.meteors[0].x = g.ship.x + 10
        g.meteors[0].y = g.ship.y
        g.step()
        ignored = ignored && g.ship.lives == 3 && g.ship.phase == ShipPhase.Restart
    }
    return ignored
}

Bool explodingShipStaysStillWithoutFireDuring(Game g, Int steps) {
    var x = g.ship.x
    var still = true
    for (var i = 0; i < steps; i++) {
        g.step()
        still = still && g.ship.x == x && g.ship.lives == 3 && !g.weapons.lasers.shots[0].active
    }
    return still
}

Game givenMeteorApproachingNormalShip(Int x, Int y) {
    var g = Game()
    g.start(51)
    g.ship.phase = ShipPhase.Normal
    g.ship.x = 60
    g.ship.y = 100
    for (var m in g.meteors) { m.active = false }
    g.meteors[0].active = true
    g.meteors[0].x = x
    g.meteors[0].y = y
    return g
}

Game givenNormalShipWithLaserFlyingAt(Int seed, Int x, Int y) {
    var g = givenNormalShip(seed)
    g.ship.y = 50
    g.weapons.lasers.shots[0].active = true
    g.weapons.lasers.shots[0].x = x
    g.weapons.lasers.shots[0].y = y
    return g
}
