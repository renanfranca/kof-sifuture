test "vertical resets keep the reduced range while bottom exits include both full endpoints for five hundred seeds" {
    var m = givenVerticalMeteor(910)
    assert(verticalResetsAndBottomExitsStayInRange(m, 500))
}

test "same seed reproduces meteors and horizontal resets stay below the header" {
    var a = Game()
    a.start(42)
    var x = a.meteors[0].x
    var y = a.meteors[0].y
    a.start(42)
    assert(a.meteors[0].x == x && a.meteors[0].y == y)
    var meteor = Meteor()
    rng.seed(71)
    meteor.reset()
    assert(meteor.y == 201)
    assert(horizontalResetsStayBelowTheHeader(meteor, 100))
}

test "ship moves five units and stops at bounds and release" {
    var g = Game()
    g.start(1)
    g.ship.direction(Direction.Right, true)
    g.step()
    assert(g.ship.x == 5)
    g.ship.direction(Direction.Right, false)
    g.step()
    assert(g.ship.x == 5)
    g.ship.x = 125
    g.ship.direction(Direction.Right, true)
    g.step()
    assert(g.ship.x == 126)
    g.ship.y = 31
    g.ship.direction(Direction.Up, true)
    g.step()
    assert(g.ship.y == 30)
    g.ship.direction(Direction.Up, false)
    g.ship.y = 199
    g.ship.direction(Direction.Down, true)
    g.step()
    assert(g.ship.y == 200)
}

test "three meteor hits end the attempt and result persists" {
    var g = Game()
    g.start(3)
    hitNormalShipWithMeteor(g)
    assert(g.ship.phase == ShipPhase.Explosion && g.ship.lives == 3)
    advanceSteps(g, 30)
    hitNormalShipWithMeteor(g)
    assert(g.ship.phase == ShipPhase.Explosion && g.ship.lives == 2)
    advanceSteps(g, 30)
    hitNormalShipWithMeteor(g)
    assert(g.ship.phase == ShipPhase.Explosion && g.ship.lives == 1)
    advanceSteps(g, 30)
    assert(g.ship.lives == 0 && g.screen == Screen.Result)
    g.step()
    assert(g.screen == Screen.Result)
    g.confirm()
    assert(g.screen == Screen.Result && g.countComplete())
    g.confirm()
    assert(g.screen == Screen.Menu)
    g.start(3)
    assert(g.ship.lives == 3 && g.score == 0 && g.steps == 0)
    givenMeteorsAway(g)
    givenItemsAway(g)
    advanceSteps(g, 45)
    assert(g.ship.phase == ShipPhase.Normal && !g.weapons.lasers.shots[0].active)
    assert(laserStaysIdleDuring(g, 12))
    g.step()
    assert(g.weapons.lasers.shots[0].active && g.weapons.fireSteps == 0)
}

test "initial restart is invulnerable for fifteen three-step alternations" {
    var g = Game()
    g.start(11)
    assert(g.ship.phase == ShipPhase.Restart && g.ship.restartFrame == 0)
    assert(restartingShipIgnoresMeteorContactDuring(g, 44))
    assert(g.ship.restartFrame == 44)
    g.meteors[0].x = 400
    g.step()
    assert(g.ship.phase == ShipPhase.Normal && g.ship.lives == 3)
}

test "restart ends before collision on step forty five but fire waits" {
    var g = Game()
    g.start(71)
    g.ship.restartFrame = 43
    g.weapons.fireSteps = 12
    givenMeteorsAt(g, 400, 30)
    g.meteors[0].x = 11
    g.meteors[0].y = 100
    g.step()
    assert(g.ship.phase == ShipPhase.Restart && g.score == 0 && g.weapons.fireSteps == 12)
    g.meteors[0].x = 11
    g.step()
    assert(g.ship.phase == ShipPhase.Explosion && g.score == 5)
    assert(g.weapons.fireSteps == 12 && !g.weapons.lasers.shots[0].active)
}

test "one ship collision marks every overlapping meteor and scores once" {
    var g = givenNormalShipWithMeteorsAt(73, 400, 30)
    g.meteors[0].x = 20
    g.meteors[0].y = 100
    g.meteors[1].x = 30
    g.meteors[1].y = 100
    g.step()
    assert(g.ship.phase == ShipPhase.Explosion && g.score == 5)
    assert(g.meteors[0].collided && g.meteors[1].collided)
    advanceSteps(g, 5)
    assert(g.meteors[0].collided && g.meteors[1].collided && g.score == 5)
    g.step()
    assert(!g.meteors[0].collided && !g.meteors[1].collided)
    assert(g.meteors[0].x >= 176 && g.meteors[1].x >= 176 && g.score == 5)
}

test "ship collision scores once and explosion blocks movement and fire for thirty steps" {
    var g = Game()
    g.start(17)
    g.ship.phase = ShipPhase.Normal
    g.ship.direction(Direction.Right, true)
    g.meteors[0].x = 20
    g.meteors[0].y = 100
    g.step()
    assert(g.score == 5 && g.ship.lives == 3 && g.ship.phase == ShipPhase.Explosion)
    assert(explodingShipStaysStillWithoutFireDuring(g, 29))
    assert(g.ship.explosionSteps == 29)
    g.step()
    assert(g.ship.lives == 2 && g.ship.phase == ShipPhase.Restart && g.ship.x == 5)
}

test "laser hit holds meteor collision images for three pairs of steps" {
    var g = Game()
    g.start(21)
    g.ship.phase = ShipPhase.Normal
    advanceSteps(g, 13)
    g.ship.y = 50
    g.meteors[0].x = g.weapons.lasers.shots[0].x + 4
    g.meteors[0].y = g.weapons.lasers.shots[0].y
    g.step()
    assert(g.score == 5)
    assert(g.meteors[0].collided)
    assert(g.meteors[0].impactFrame() == 0)
    var x = g.meteors[0].x
    g.step()
    assert(g.meteors[0].collided)
    assert(g.meteors[0].x == x - 1)
    assert(g.score == 5)
    assert(g.meteors[0].impactFrame() == 0)
    g.step()
    assert(g.meteors[0].collided)
    assert(g.meteors[0].x == x - 2)
    assert(g.score == 5)
    assert(g.meteors[0].impactFrame() == 1)
    g.step()
    assert(g.meteors[0].collided)
    assert(g.meteors[0].x == x - 3)
    assert(g.score == 5)
    assert(g.meteors[0].impactFrame() == 1)
    g.step()
    assert(g.meteors[0].collided)
    assert(g.meteors[0].x == x - 4)
    assert(g.score == 5)
    assert(g.meteors[0].impactFrame() == 2)
    g.step()
    assert(g.meteors[0].collided)
    assert(g.meteors[0].x == x - 5)
    assert(g.score == 5)
    assert(g.meteors[0].impactFrame() == 2)
    g.step()
    assert(!g.meteors[0].collided)
    assert(g.meteors[0].x >= 176)
}

test "meteor sprite advances every two steps and returns through the historical frames" {
    var g = Game()
    g.start(31)
    var m = g.meteors[0]
    assert(m.frame == 0)
    g.step()
    assert(m.frame == 0)
    g.step()
    assert(m.frame == 1)
    advanceSteps(g, 8)
    assert(m.frame == 5)
    g.step()
    g.step()
    assert(m.frame == 4)
    m.x = -24
    m.y = 80
    m.advance()
    assert(m.x == -25 && m.y == 80)
    m.advance()
    assert(m.x >= 176 && m.x <= 375 && m.y >= 30 && m.y <= 201)
}

test "ship collision takes priority when its laser reaches the same meteor" {
    var g = givenNormalShip(33)
    g.meteors[0].x = 20
    g.meteors[0].y = 100
    g.weapons.lasers.shots[0].x = 20
    g.weapons.lasers.shots[0].y = 100
    g.weapons.lasers.shots[0].active = true
    g.step()
    assert(g.ship.phase == ShipPhase.Explosion && g.score == 5 && g.weapons.lasers.shots[0].active)
}

test "ship meteor contact includes the left and right boundaries" {
    var meteor = Meteor()
    meteor.y = 105
    meteor.x = 60
    assert(meteor.touchesShip(60, 100))
    var at60 = givenMeteorApproachingNormalShip(60 + 1, 105)
    at60.step()
    assert(at60.meteors[0].x == 60)
    assert(at60.meteors[0].collided)
    assert(at60.score == 5 && at60.ship.phase == ShipPhase.Explosion)
    at60.step()
    assert(at60.score == 5 && at60.ship.phase == ShipPhase.Explosion)
    meteor.x = 110
    assert(meteor.touchesShip(60, 100))
    var at110 = givenMeteorApproachingNormalShip(110 + 1, 105)
    at110.step()
    assert(at110.meteors[0].x == 110)
    assert(at110.meteors[0].collided)
    assert(at110.score == 5 && at110.ship.phase == ShipPhase.Explosion)
    at110.step()
    assert(at110.score == 5 && at110.ship.phase == ShipPhase.Explosion)
}

test "ship meteor contact excludes the positions beside the left and right boundaries" {
    var meteor = Meteor()
    meteor.y = 105
    meteor.x = 59
    assert(!meteor.touchesShip(60, 100))
    var at59 = givenMeteorApproachingNormalShip(59 + 1, 105)
    at59.step()
    assert(at59.meteors[0].x == 59)
    assert(!at59.meteors[0].collided)
    assert(at59.score == 0 && at59.ship.phase == ShipPhase.Normal)
    meteor.x = 111
    assert(!meteor.touchesShip(60, 100))
    var at111 = givenMeteorApproachingNormalShip(111 + 1, 105)
    at111.step()
    assert(at111.meteors[0].x == 111)
    assert(!at111.meteors[0].collided)
    assert(at111.score == 0 && at111.ship.phase == ShipPhase.Normal)
}

