test "pause and lost keyboard focus clear right image without changing opposing direction priority" {
    for (var pause = 0; pause < 2; pause++) {
        var g = Game()
        g.start(909)
        g.ship.phase = ShipPhase.Normal
        g.ship.x = 60
        for (var m in g.meteors) { m.x = 10000; m.y = -100 }
        g.keyboard(Direction.Left, true)
        g.keyboard(Direction.Right, true)
        g.step()
        assert(g.ship.x == 65 && g.ship.rightFrame)

        if (pause == 1) { g.pause() }
        else { g.clearKeyboard() }
        assert(!g.ship.rightFrame && !g.ship.left && !g.ship.right)
        g.step()
        assert(g.ship.x == 65 && !g.ship.rightFrame)
        if (pause == 1) { g.resume() }
        g.keyboard(Direction.Left, false)
        g.keyboard(Direction.Right, false)
        g.keyboard(Direction.Right, true)
        g.keyboard(Direction.Left, true)
        g.step()
        assert(g.ship.x == 60 && !g.ship.rightFrame)
        g.keyboard(Direction.Left, false)
        g.step()
        assert(g.ship.x == 65 && g.ship.rightFrame)
    }
}

test "four pad arrows move by axis and stop on release" {
    var directions = listOf(Direction.Up, Direction.Left, Direction.Right, Direction.Down)
    var dx = listOf(0, -5, 5, 0)
    var dy = listOf(-5, 0, 0, 5)
    for (var i = 0; i < 4; i++) {
        var g = Game()
        g.start(100 + i)
        g.ship.x = 60
        g.ship.y = 100
        g.movement(directions[i], true)
        g.step()
        assert(g.ship.x == 60 + dx[i] && g.ship.y == 100 + dy[i])
        g.movement(directions[i], false)
        g.step()
        assert(g.ship.x == 60 + dx[i] && g.ship.y == 100 + dy[i])
    }
}

test "pad owns movement until held keyboard keys are released and pressed again" {
    var g = Game()
    g.start(101)
    g.ship.x = 60
    g.keyboard(Direction.Right, true)
    g.movement(Direction.Left, true)
    g.keyboard(Direction.Up, true)
    g.movement(Direction.Right, true)
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 100)
    g.movement(Direction.Right, false)
    g.step()
    assert(g.ship.x == 60 && g.padPressed())
    g.movement(Direction.Left, false)
    g.keyboard(Direction.Right, true)
    g.keyboard(Direction.Up, true)
    g.step()
    assert(g.ship.x == 60 && g.ship.y == 100)
    g.keyboard(Direction.Right, false)
    g.keyboard(Direction.Right, true)
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 100)
}

test "pause freezes ship lasers meteors and counters then resumes without movement" {
    var g = Game()
    g.start(102)
    g.ship.phase = ShipPhase.Normal
    g.keyboard(Direction.Right, true)
    g.step()
    g.pause()
    var x = g.ship.x
    var meteorX = g.meteors[0].x
    var steps = g.steps
    var fireSteps = g.weapons.fireSteps
    var score = g.score
    var lives = g.ship.lives
    for (var i = 0; i < 50; i++) { g.step() }
    assert(g.screen == Screen.Pause && g.ship.x == x)
    assert(g.meteors[0].x == meteorX && g.steps == steps)
    assert(g.weapons.fireSteps == fireSteps && g.score == score && g.ship.lives == lives)
    g.confirm()
    g.step()
    assert(g.screen == Screen.Play && g.ship.x == x && g.steps == steps + 1)
}

test "held arrow cannot restart movement after resume without a release" {
    var g = Game()
    g.start(103)
    g.ship.x = 60
    g.keyboard(Direction.Right, true)
    g.step()
    g.pause()
    g.resume()
    g.keyboard(Direction.Right, true)
    g.step()
    assert(g.ship.x == 65)
    g.keyboard(Direction.Right, false)
    g.keyboard(Direction.Right, true)
    g.step()
    assert(g.ship.x == 70)
}

test "arrow observed outside canvas waits for release before moving" {
    var g = Game()
    g.start(107)
    g.ship.x = 60

    g.keyboard(Direction.Right, true, false)
    g.keyboard(Direction.Right, true, true)
    g.step()
    assert(g.ship.x == 60)

    g.keyboard(Direction.Right, false, false)
    g.keyboard(Direction.Right, true, true)
    g.step()
    assert(g.ship.x == 65)
}

test "canvas click rearms arrows after lost release and next press moves" {
    var g = Game()
    g.start(108)
    g.ship.x = 60

    g.keyboard(Direction.Right, true)
    g.step()
    g.clearKeyboard()
    g.rearmKeyboard()
    g.step()
    assert(g.ship.x == 65)

    g.keyboard(Direction.Right, true)
    g.step()
    assert(g.ship.x == 70)
}

test "canvas click preserves active pad movement and rearms keyboard" {
    var g = Game()
    g.start(109)
    g.ship.x = 60
    g.keyboard(Direction.Right, true)
    g.movement(Direction.Left, true)

    g.rearmKeyboard()
    g.step()
    assert(g.padPressed() && g.ship.x == 55)

    g.movement(Direction.Left, false)
    g.keyboard(Direction.Right, true)
    g.step()
    assert(g.ship.x == 60)
}

test "pause holds explosion and restart frames without consuming a life" {
    var phases = listOf(ShipPhase.Explosion, ShipPhase.Restart)
    for (var i = 0; i < 2; i++) {
        var g = Game()
        g.start(104 + i)
        g.ship.phase = phases[i]
        g.ship.explosionSteps = 12
        g.ship.restartFrame = 20
        g.meteors[0].collided = true
        g.meteors[0].collisionSteps = 2
        g.weapons.lasers.shots[0].active = true
        g.weapons.lasers.shots[0].x = 44
        g.pause()
        for (var j = 0; j < 50; j++) { g.step() }
        assert(g.ship.phase == phases[i] && g.ship.lives == 3)
        assert(g.ship.explosionSteps == 12 && g.ship.restartFrame == 20)
        assert(g.meteors[0].collisionSteps == 2 && g.weapons.lasers.shots[0].x == 44)
        assert(g.steps == 0)
    }
}

test "pausing and returning from result leave no directional movement" {
    var g = Game()
    g.start(106)
    g.ship.x = 60
    g.movement(Direction.Right, true)
    g.pause()
    assert(!g.padPressed() && !g.ship.right)
    g.resume()
    g.step()
    assert(g.ship.x == 60)
    g.ship.lives = 0
    g.step()
    assert(g.screen == Screen.Result && !g.padPressed())
    g.confirm()
    g.confirm()
    g.step()
    assert(g.screen == Screen.Play && !g.padPressed() && !g.ship.right)
}

test "last pressed opposite direction wins until released" {
    var g = Game()
    g.start(9)
    g.ship.x = 60
    g.ship.y = 100
    g.ship.direction(Direction.Left, true)
    g.ship.direction(Direction.Right, true)
    g.ship.direction(Direction.Up, true)
    g.ship.direction(Direction.Down, true)
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 105)
    g.ship.direction(Direction.Right, false)
    g.ship.direction(Direction.Down, false)
    g.step()
    assert(g.ship.x == 60 && g.ship.y == 100)
}

test "reversed opposing keys choose the latest and restore the held key on release" {
    var g = Game()
    g.start(91)
    g.ship.phase = ShipPhase.Normal
    g.ship.x = 60
    g.ship.y = 100
    for (var m in g.meteors) { m.x = 400; m.y = 30 }

    g.ship.direction(Direction.Right, true)
    g.ship.direction(Direction.Left, true)
    g.ship.direction(Direction.Down, true)
    g.ship.direction(Direction.Up, true)
    g.step()
    assert(g.ship.x == 55 && g.ship.y == 95 && !g.ship.rightFrame)

    g.ship.direction(Direction.Left, false)
    g.ship.direction(Direction.Up, false)
    g.step()
    assert(g.ship.x == 60 && g.ship.y == 100 && g.ship.rightFrame)
}

test "ship image follows horizontal direction and last opposing key" {
    var g = Game()
    g.start(63)
    assert(!g.ship.rightFrame)
    g.ship.phase = ShipPhase.Normal
    g.ship.direction(Direction.Right, true)
    g.step()
    assert(g.ship.rightFrame)
    g.ship.direction(Direction.Left, true)
    g.step()
    assert(!g.ship.rightFrame)
    g.ship.direction(Direction.Left, false)
    g.step()
    assert(g.ship.rightFrame)
    g.ship.direction(Direction.Right, false)
    g.step()
    assert(!g.ship.rightFrame)
    g.ship.direction(Direction.Up, true)
    g.step()
    assert(!g.ship.rightFrame)
    g.ship.direction(Direction.Left, true)
    g.step()
    assert(!g.ship.rightFrame)
}

test "independent pad arrows combine axes and release only their own direction" {
    var g = Game()
    g.start(77)
    g.ship.x = 60
    g.ship.y = 100
    for (var meteor in g.meteors) { meteor.y = 30 }

    g.movement(Direction.Right, true)
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 100)
    g.movement(Direction.Up, true)
    g.step()
    assert(g.ship.x == 70 && g.ship.y == 95, "two held arrows must combine axes")
    g.movement(Direction.Up, false)
    g.step()
    assert(g.ship.x == 75 && g.ship.y == 95)
    g.movement(Direction.Right, false)
    g.step()
    assert(g.ship.x == 75 && g.ship.y == 95)
}

test "duplicate pad events preserve opposite priority and ignore unheld releases" {
    var g = Game()
    g.start(77)
    g.ship.x = 60
    g.ship.phase = ShipPhase.Normal
    for (var meteor in g.meteors) { meteor.y = 30 }

    g.movement(Direction.Right, true)
    g.step()
    assert(g.ship.x == 65 && g.ship.rightFrame)
    g.movement(Direction.Left, true)
    g.movement(Direction.Right, true)
    g.step()
    assert(g.ship.x == 60 && !g.ship.rightFrame, "repeated press must not steal opposite priority")
    g.movement(Direction.Left, false)
    g.movement(Direction.Left, false)
    g.step()
    assert(g.ship.x == 65 && g.ship.rightFrame)
    g.movement(Direction.Right, false)
    g.keyboard(Direction.Up, true)
    g.movement(Direction.Up, false)
    g.movement(Direction.Right, false)
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 95, "unheld pad release must not clear keyboard movement")
}

test "four diagonals preserve either held axis in both press and release orders" {
    var horizontal = listOf(Direction.Right, Direction.Left)
    var vertical = listOf(Direction.Up, Direction.Down)
    var dx = listOf(5, -5)
    var dy = listOf(-5, 5)
    for (var x = 0; x < 2; x++) {
        for (var y = 0; y < 2; y++) {
            for (var order = 0; order < 2; order++) {
                for (var release = 0; release < 2; release++) {
                    var g = Game()
                    g.start(77)
                    g.ship.x = 60
                    g.ship.y = 100
                    g.ship.phase = ShipPhase.Normal
                    for (var meteor in g.meteors) { meteor.y = 30 }
                    if (order == 0) { g.movement(horizontal[x], true); g.movement(vertical[y], true) }
                    else { g.movement(vertical[y], true); g.movement(horizontal[x], true) }
                    g.step()
                    assert(g.ship.x == 60 + dx[x] && g.ship.y == 100 + dy[y])
                    assert(g.ship.rightFrame == (x == 0))
                    if (release == 0) {
                        g.movement(horizontal[x], false)
                        g.step()
                        assert(g.ship.x == 60 + dx[x] && g.ship.y == 100 + 2 * dy[y])
                        assert(!g.ship.rightFrame)
                        g.movement(vertical[y], false)
                    } else {
                        g.movement(vertical[y], false)
                        g.step()
                        assert(g.ship.x == 60 + 2 * dx[x] && g.ship.y == 100 + dy[y])
                        assert(g.ship.rightFrame == (x == 0))
                        g.movement(horizontal[x], false)
                    }
                    var stoppedX = g.ship.x
                    var stoppedY = g.ship.y
                    g.step()
                    assert(g.ship.x == stoppedX && g.ship.y == stoppedY && !g.padPressed() && !g.ship.rightFrame)
                }
            }
        }
    }
}

test "last opposite pad press wins in either axis until its own release" {
    var first = listOf(Direction.Right, Direction.Left, Direction.Up, Direction.Down)
    var second = listOf(Direction.Left, Direction.Right, Direction.Down, Direction.Up)
    var dx = listOf(5, -5, 0, 0)
    var dy = listOf(0, 0, -5, 5)
    for (var i = 0; i < 4; i++) {
        for (var releaseWinner = 0; releaseWinner < 2; releaseWinner++) {
            var g = Game()
            g.start(77)
            g.ship.x = 60
            g.ship.y = 100
            g.ship.phase = ShipPhase.Normal
            for (var meteor in g.meteors) { meteor.y = 30 }
            g.movement(first[i], true)
            g.step()
            assert(g.ship.x == 60 + dx[i] && g.ship.y == 100 + dy[i])
            g.movement(second[i], true)
            g.step()
            assert(g.ship.x == 60 && g.ship.y == 100)
            assert(g.ship.rightFrame == (i == 1))
            if (releaseWinner == 1) {
                g.movement(second[i], false)
                g.step()
                assert(g.ship.x == 60 + dx[i] && g.ship.y == 100 + dy[i])
                assert(g.ship.rightFrame == (i == 0))
                g.movement(first[i], false)
            } else {
                g.movement(first[i], false)
                g.step()
                assert(g.ship.x == 60 - dx[i] && g.ship.y == 100 - dy[i])
                assert(g.ship.rightFrame == (i == 1))
                g.movement(second[i], false)
            }
            var stoppedX = g.ship.x
            var stoppedY = g.ship.y
            g.step()
            assert(g.ship.x == stoppedX && g.ship.y == stoppedY)
        }
    }
}

test "pausing a diagonal clears every pad arrow and requires a new press" {
    var g = Game()
    g.start(77)
    g.ship.x = 60
    g.ship.y = 100
    for (var meteor in g.meteors) { meteor.y = 30 }
    g.movement(Direction.Right, true)
    g.movement(Direction.Up, true)
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 95)
    g.pause()
    g.movement(Direction.Left, true)
    g.movement(Direction.Down, true)
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 95 && !g.padPressed())
    g.resume()
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 95)
    g.movement(Direction.Right, false)
    g.movement(Direction.Up, false)
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 95)
    g.movement(Direction.Down, true)
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 100)
}

test "keyboard memory stays separate while both pad axes own movement" {
    var g = Game()
    g.start(77)
    g.ship.x = 60
    g.ship.y = 100
    for (var meteor in g.meteors) { meteor.y = 30 }
    g.keyboard(Direction.Left, true)
    g.keyboard(Direction.Down, true)
    g.movement(Direction.Right, true)
    g.movement(Direction.Up, true)
    g.clearKeyboard()
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 95)
    g.movement(Direction.Up, false)
    g.keyboard(Direction.Down, false)
    g.keyboard(Direction.Down, true)
    g.step()
    assert(g.ship.x == 70 && g.ship.y == 95)
    g.movement(Direction.Right, false)
    g.keyboard(Direction.Left, true)
    g.keyboard(Direction.Down, true)
    g.step()
    assert(g.ship.x == 70 && g.ship.y == 95)
    g.keyboard(Direction.Left, false)
    g.keyboard(Direction.Left, true)
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 95)
}
