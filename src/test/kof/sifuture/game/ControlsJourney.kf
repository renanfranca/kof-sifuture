test "releasing the last opposite pad arrow returns to the first arrow on either axis" {
    var rightThenLeft = givenNormalShipAtCenterWithMeteorsLowered(77)
    assert(pressingMovesShipTo(rightThenLeft, Direction.Right, 65, 100))
    assert(pressingMovesShipTo(rightThenLeft, Direction.Left, 60, 100))
    assert(!rightThenLeft.ship.rightFrame)
    assert(releasingMovesShipTo(rightThenLeft, Direction.Left, 65, 100))
    assert(rightThenLeft.ship.rightFrame)
    assert(releasingStopsShip(rightThenLeft, Direction.Right))
    var leftThenRight = givenNormalShipAtCenterWithMeteorsLowered(77)
    assert(pressingMovesShipTo(leftThenRight, Direction.Left, 55, 100))
    assert(pressingMovesShipTo(leftThenRight, Direction.Right, 60, 100))
    assert(leftThenRight.ship.rightFrame)
    assert(releasingMovesShipTo(leftThenRight, Direction.Right, 55, 100))
    assert(!leftThenRight.ship.rightFrame)
    assert(releasingStopsShip(leftThenRight, Direction.Left))
    var upThenDown = givenNormalShipAtCenterWithMeteorsLowered(77)
    assert(pressingMovesShipTo(upThenDown, Direction.Up, 60, 95))
    assert(pressingMovesShipTo(upThenDown, Direction.Down, 60, 100))
    assert(!upThenDown.ship.rightFrame)
    assert(releasingMovesShipTo(upThenDown, Direction.Down, 60, 95))
    assert(!upThenDown.ship.rightFrame)
    assert(releasingStopsShip(upThenDown, Direction.Up))
    var downThenUp = givenNormalShipAtCenterWithMeteorsLowered(77)
    assert(pressingMovesShipTo(downThenUp, Direction.Down, 60, 105))
    assert(pressingMovesShipTo(downThenUp, Direction.Up, 60, 100))
    assert(!downThenUp.ship.rightFrame)
    assert(releasingMovesShipTo(downThenUp, Direction.Up, 60, 105))
    assert(!downThenUp.ship.rightFrame)
    assert(releasingStopsShip(downThenUp, Direction.Down))
}

test "releasing the first opposite pad arrow keeps the last arrow on either axis" {
    var rightThenLeft = givenNormalShipAtCenterWithMeteorsLowered(77)
    assert(pressingMovesShipTo(rightThenLeft, Direction.Right, 65, 100))
    assert(pressingMovesShipTo(rightThenLeft, Direction.Left, 60, 100))
    assert(!rightThenLeft.ship.rightFrame)
    assert(releasingMovesShipTo(rightThenLeft, Direction.Right, 55, 100))
    assert(!rightThenLeft.ship.rightFrame)
    assert(releasingStopsShip(rightThenLeft, Direction.Left))
    var leftThenRight = givenNormalShipAtCenterWithMeteorsLowered(77)
    assert(pressingMovesShipTo(leftThenRight, Direction.Left, 55, 100))
    assert(pressingMovesShipTo(leftThenRight, Direction.Right, 60, 100))
    assert(leftThenRight.ship.rightFrame)
    assert(releasingMovesShipTo(leftThenRight, Direction.Left, 65, 100))
    assert(leftThenRight.ship.rightFrame)
    assert(releasingStopsShip(leftThenRight, Direction.Right))
    var upThenDown = givenNormalShipAtCenterWithMeteorsLowered(77)
    assert(pressingMovesShipTo(upThenDown, Direction.Up, 60, 95))
    assert(pressingMovesShipTo(upThenDown, Direction.Down, 60, 100))
    assert(!upThenDown.ship.rightFrame)
    assert(releasingMovesShipTo(upThenDown, Direction.Up, 60, 105))
    assert(!upThenDown.ship.rightFrame)
    assert(releasingStopsShip(upThenDown, Direction.Down))
    var downThenUp = givenNormalShipAtCenterWithMeteorsLowered(77)
    assert(pressingMovesShipTo(downThenUp, Direction.Down, 60, 105))
    assert(pressingMovesShipTo(downThenUp, Direction.Up, 60, 100))
    assert(!downThenUp.ship.rightFrame)
    assert(releasingMovesShipTo(downThenUp, Direction.Down, 60, 95))
    assert(!downThenUp.ship.rightFrame)
    assert(releasingStopsShip(downThenUp, Direction.Up))
}

test "pausing a diagonal clears every pad arrow and requires a new press" {
    var g = Game()
    g.start(77)
    g.ship.x = 60
    g.ship.y = 100
    givenMeteorsAtHeight(g, 30)
    g.movement(Direction.Right, true)
    g.movement(Direction.Up, true)
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 95)
    g.pause()
    g.movement(Direction.Left, true)
    g.movement(Direction.Down, true)
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 95 && !g.padPressed())
    g.resume()
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 95)
    g.movement(Direction.Right, false)
    g.movement(Direction.Up, false)
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 95)
    g.movement(Direction.Down, true)
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 100)
}

test "keyboard memory stays separate while both pad axes own movement" {
    var g = givenShipAt(77, 60, 100)
    givenMeteorsAtHeight(g, 30)
    g.keyboard(Direction.Left, true)
    g.keyboard(Direction.Down, true)
    g.movement(Direction.Right, true)
    g.movement(Direction.Up, true)
    g.clearKeyboard()
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 95)
    g.movement(Direction.Up, false)
    g.keyboard(Direction.Down, false)
    g.keyboard(Direction.Down, true)
    g.step()
    assert(g.ship.x == 70 && g.ship.y == 95)
    g.movement(Direction.Right, false)
    g.keyboard(Direction.Left, true)
    g.keyboard(Direction.Down, true)
    g.step()
    assert(g.ship.x == 70 && g.ship.y == 95)
    g.keyboard(Direction.Left, false)
    g.keyboard(Direction.Left, true)
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 95)
}

Game givenNormalShipMovingRightWithLeftAlsoHeld(Int seed) {
    var g = givenNormalShip(seed)
    g.ship.x = 60
    givenMeteorsAway(g)
    g.keyboard(Direction.Left, true)
    g.keyboard(Direction.Right, true)
    g.step()
    return g
}

Game givenPausedNormalShipAfterMovingRight(Int seed) {
    var g = givenNormalShip(seed)
    g.keyboard(Direction.Right, true)
    g.step()
    g.pause()
    return g
}

Game givenShipResumedWhileHoldingRight(Int seed) {
    var g = Game()
    g.start(seed)
    g.ship.x = 60
    g.keyboard(Direction.Right, true)
    g.step()
    g.pause()
    g.resume()
    return g
}

Game givenPausedShipWithPendingEffects(Int seed, ShipPhase phase) {
    var g = Game()
    g.start(seed)
    g.ship.phase = phase
    g.ship.explosionSteps = 12
    g.ship.restartFrame = 20
    g.meteors[0].collided = true
    g.meteors[0].collisionSteps = 2
    g.weapons.lasers.shots[0].active = true
    g.weapons.lasers.shots[0].x = 44
    g.pause()
    return g
}

Game givenNormalShipAtCenterWithMeteorsLowered(Int seed) {
    var g = givenShipAt(seed, 60, 100)
    g.ship.phase = ShipPhase.Normal
    givenMeteorsAtHeight(g, 30)
    return g
}

Bool pressingMovesShipTo(Game g, Direction direction, Int x, Int y) {
    g.movement(direction, true)
    g.step()
    return g.ship.x == x && g.ship.y == y
}

Bool releasingMovesShipTo(Game g, Direction direction, Int x, Int y) {
    g.movement(direction, false)
    g.step()
    return g.ship.x == x && g.ship.y == y
}

Bool releasingStopsShip(Game g, Direction direction) {
    g.movement(direction, false)
    var x = g.ship.x
    var y = g.ship.y
    g.step()
    return g.ship.x == x && g.ship.y == y
}
