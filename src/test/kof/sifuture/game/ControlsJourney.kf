test "lost keyboard focus clears right image without changing opposing direction priority" {
    var g = givenNormalShipMovingRightWithLeftAlsoHeld(909)
    assert(g.ship.x == 65 && g.ship.rightFrame)
    g.clearKeyboard()
    assert(!g.ship.rightFrame && !g.ship.left && !g.ship.right)
    g.step()
    assert(g.ship.x == 65 && !g.ship.rightFrame)
    g.keyboard(Direction.Left, false)
    g.keyboard(Direction.Right, false)
    g.keyboard(Direction.Right, true)
    g.keyboard(Direction.Left, true)
    g.step()
    assert(g.ship.x == 60 && !g.ship.rightFrame)
    g.keyboard(Direction.Left, false)
    g.step()
    assert(g.ship.x == 65 && g.ship.rightFrame)
}

test "pause clears right image without changing opposing direction priority" {
    var g = givenNormalShipMovingRightWithLeftAlsoHeld(909)
    assert(g.ship.x == 65 && g.ship.rightFrame)
    g.pause()
    assert(!g.ship.rightFrame && !g.ship.left && !g.ship.right)
    g.step()
    assert(g.ship.x == 65 && !g.ship.rightFrame)
    g.resume()
    g.keyboard(Direction.Left, false)
    g.keyboard(Direction.Right, false)
    g.keyboard(Direction.Right, true)
    g.keyboard(Direction.Left, true)
    g.step()
    assert(g.ship.x == 60 && !g.ship.rightFrame)
    g.keyboard(Direction.Left, false)
    g.step()
    assert(g.ship.x == 65 && g.ship.rightFrame)
}

test "pad up arrow moves five units up and stops on release" {
    var g = givenShipAt(100, 60, 100)
    g.movement(Direction.Up, true)
    g.step()
    assert(g.ship.x == 60 && g.ship.y == 95)
    g.movement(Direction.Up, false)
    g.step()
    assert(g.ship.x == 60 && g.ship.y == 95)
}

test "pad left arrow moves five units left and stops on release" {
    var g = givenShipAt(101, 60, 100)
    g.movement(Direction.Left, true)
    g.step()
    assert(g.ship.x == 55 && g.ship.y == 100)
    g.movement(Direction.Left, false)
    g.step()
    assert(g.ship.x == 55 && g.ship.y == 100)
}

test "pad right arrow moves five units right and stops on release" {
    var g = givenShipAt(102, 60, 100)
    g.movement(Direction.Right, true)
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 100)
    g.movement(Direction.Right, false)
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 100)
}

test "pad down arrow moves five units down and stops on release" {
    var g = givenShipAt(103, 60, 100)
    g.movement(Direction.Down, true)
    g.step()
    assert(g.ship.x == 60 && g.ship.y == 105)
    g.movement(Direction.Down, false)
    g.step()
    assert(g.ship.x == 60 && g.ship.y == 105)
}

test "pad owns movement until held keyboard keys are released and pressed again" {
    var g = Game()
    g.start(101)
    g.ship.x = 60
    g.keyboard(Direction.Right, true)
    g.movement(Direction.Left, true)
    g.keyboard(Direction.Up, true)
    g.movement(Direction.Right, true)
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 100)
    g.movement(Direction.Right, false)
    g.step()
    assert(g.ship.x == 60 && g.padPressed())
    g.movement(Direction.Left, false)
    g.keyboard(Direction.Right, true)
    g.keyboard(Direction.Up, true)
    g.step()
    assert(g.ship.x == 60 && g.ship.y == 100)
    g.keyboard(Direction.Right, false)
    g.keyboard(Direction.Right, true)
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 100)
}

test "pause freezes ship lasers meteors and counters then resumes without movement" {
    var g = givenPausedNormalShipAfterMovingRight(102)
    var x = g.ship.x
    var meteorX = g.meteors[0].x
    var steps = g.steps
    var fireSteps = g.weapons.fireSteps
    var score = g.score
    var lives = g.ship.lives
    advanceSteps(g, 50)
    assert(g.screen == Screen.Pause && g.ship.x == x)
    assert(g.meteors[0].x == meteorX && g.steps == steps)
    assert(g.weapons.fireSteps == fireSteps && g.score == score && g.ship.lives == lives)
    g.confirm()
    g.step()
    assert(g.screen == Screen.Play && g.ship.x == x && g.steps == steps + 1)
}

test "held arrow cannot restart movement after resume without a release" {
    var g = givenShipResumedWhileHoldingRight(103)
    g.keyboard(Direction.Right, true)
    g.step()
    assert(g.ship.x == 65)
    g.keyboard(Direction.Right, false)
    g.keyboard(Direction.Right, true)
    g.step()
    assert(g.ship.x == 70)
}

test "arrow observed outside canvas waits for release before moving" {
    var g = Game()
    g.start(107)
    g.ship.x = 60

    g.keyboard(Direction.Right, true, false)
    g.keyboard(Direction.Right, true, true)
    g.step()
    assert(g.ship.x == 60)

    g.keyboard(Direction.Right, false, false)
    g.keyboard(Direction.Right, true, true)
    g.step()
    assert(g.ship.x == 65)
}

test "canvas click rearms arrows after lost release and next press moves" {
    var g = Game()
    g.start(108)
    g.ship.x = 60

    g.keyboard(Direction.Right, true)
    g.step()
    g.clearKeyboard()
    g.rearmKeyboard()
    g.step()
    assert(g.ship.x == 65)

    g.keyboard(Direction.Right, true)
    g.step()
    assert(g.ship.x == 70)
}

test "canvas click preserves active pad movement and rearms keyboard" {
    var g = Game()
    g.start(109)
    g.ship.x = 60
    g.keyboard(Direction.Right, true)
    g.movement(Direction.Left, true)

    g.rearmKeyboard()
    g.step()
    assert(g.padPressed() && g.ship.x == 55)

    g.movement(Direction.Left, false)
    g.keyboard(Direction.Right, true)
    g.step()
    assert(g.ship.x == 60)
}

test "pause holds explosion frames without consuming a life" {
    var g = givenPausedShipWithPendingEffects(104, ShipPhase.Explosion)
    advanceSteps(g, 50)
    assert(g.ship.phase == ShipPhase.Explosion && g.ship.lives == 3)
    assert(g.ship.explosionSteps == 12 && g.ship.restartFrame == 20)
    assert(g.meteors[0].collisionSteps == 2 && g.weapons.lasers.shots[0].x == 44)
    assert(g.steps == 0)
}

test "pause holds restart frames without consuming a life" {
    var g = givenPausedShipWithPendingEffects(105, ShipPhase.Restart)
    advanceSteps(g, 50)
    assert(g.ship.phase == ShipPhase.Restart && g.ship.lives == 3)
    assert(g.ship.explosionSteps == 12 && g.ship.restartFrame == 20)
    assert(g.meteors[0].collisionSteps == 2 && g.weapons.lasers.shots[0].x == 44)
    assert(g.steps == 0)
}

test "pausing and returning from result leave no directional movement" {
    var g = Game()
    g.start(106)
    g.ship.x = 60
    g.movement(Direction.Right, true)
    g.pause()
    assert(!g.padPressed() && !g.ship.right)
    g.resume()
    g.step()
    assert(g.ship.x == 60)
    g.ship.lives = 0
    g.step()
    assert(g.screen == Screen.Result && !g.padPressed())
    g.confirm()
    g.confirm()
    g.step()
    assert(g.screen == Screen.Play && !g.padPressed() && !g.ship.right)
}

test "last pressed opposite direction wins until released" {
    var g = givenShipAt(9, 60, 100)
    g.ship.direction(Direction.Left, true)
    g.ship.direction(Direction.Right, true)
    g.ship.direction(Direction.Up, true)
    g.ship.direction(Direction.Down, true)
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 105)
    g.ship.direction(Direction.Right, false)
    g.ship.direction(Direction.Down, false)
    g.step()
    assert(g.ship.x == 60 && g.ship.y == 100)
}

test "reversed opposing keys choose the latest and restore the held key on release" {
    var g = givenShipAt(91, 60, 100)
    g.ship.phase = ShipPhase.Normal
    givenMeteorsAt(g, 400, 30)

    g.ship.direction(Direction.Right, true)
    g.ship.direction(Direction.Left, true)
    g.ship.direction(Direction.Down, true)
    g.ship.direction(Direction.Up, true)
    g.step()
    assert(g.ship.x == 55 && g.ship.y == 95 && !g.ship.rightFrame)

    g.ship.direction(Direction.Left, false)
    g.ship.direction(Direction.Up, false)
    g.step()
    assert(g.ship.x == 60 && g.ship.y == 100 && g.ship.rightFrame)
}

test "ship image follows horizontal direction and last opposing key" {
    var g = Game()
    g.start(63)
    assert(!g.ship.rightFrame)
    g.ship.phase = ShipPhase.Normal
    g.ship.direction(Direction.Right, true)
    g.step()
    assert(g.ship.rightFrame)
    g.ship.direction(Direction.Left, true)
    g.step()
    assert(!g.ship.rightFrame)
    g.ship.direction(Direction.Left, false)
    g.step()
    assert(g.ship.rightFrame)
    g.ship.direction(Direction.Right, false)
    g.step()
    assert(!g.ship.rightFrame)
    g.ship.direction(Direction.Up, true)
    g.step()
    assert(!g.ship.rightFrame)
    g.ship.direction(Direction.Left, true)
    g.step()
    assert(!g.ship.rightFrame)
}

test "independent pad arrows combine axes and release only their own direction" {
    var g = Game()
    g.start(77)
    g.ship.x = 60
    g.ship.y = 100
    givenMeteorsAtHeight(g, 30)

    g.movement(Direction.Right, true)
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 100)
    g.movement(Direction.Up, true)
    g.step()
    assert(g.ship.x == 70 && g.ship.y == 95, "two held arrows must combine axes")
    g.movement(Direction.Up, false)
    g.step()
    assert(g.ship.x == 75 && g.ship.y == 95)
    g.movement(Direction.Right, false)
    g.step()
    assert(g.ship.x == 75 && g.ship.y == 95)
}

test "duplicate pad events preserve opposite priority and ignore unheld releases" {
    var g = Game()
    g.start(77)
    g.ship.x = 60
    g.ship.phase = ShipPhase.Normal
    givenMeteorsAtHeight(g, 30)

    g.movement(Direction.Right, true)
    g.step()
    assert(g.ship.x == 65 && g.ship.rightFrame)
    g.movement(Direction.Left, true)
    g.movement(Direction.Right, true)
    g.step()
    assert(g.ship.x == 60 && !g.ship.rightFrame, "repeated press must not steal opposite priority")
    g.movement(Direction.Left, false)
    g.movement(Direction.Left, false)
    g.step()
    assert(g.ship.x == 65 && g.ship.rightFrame)
    g.movement(Direction.Right, false)
    g.keyboard(Direction.Up, true)
    g.movement(Direction.Up, false)
    g.movement(Direction.Right, false)
    g.step()
    assert(g.ship.x == 65 && g.ship.y == 95, "unheld pad release must not clear keyboard movement")
}

test "a diagonal pressed horizontal first keeps the vertical axis after the horizontal release and then stops" {
    var rightUp = givenNormalShipAtCenterWithMeteorsLowered(77)
    rightUp.movement(Direction.Right, true)
    rightUp.movement(Direction.Up, true)
    rightUp.step()
    assert(rightUp.ship.x == 65 && rightUp.ship.y == 95)
    assert(rightUp.ship.rightFrame)
    assert(releasingMovesShipTo(rightUp, Direction.Right, 65, 90))
    assert(!rightUp.ship.rightFrame)
    assert(releasingStopsShip(rightUp, Direction.Up))
    assert(!rightUp.padPressed() && !rightUp.ship.rightFrame)
    var rightDown = givenNormalShipAtCenterWithMeteorsLowered(77)
    rightDown.movement(Direction.Right, true)
    rightDown.movement(Direction.Down, true)
    rightDown.step()
    assert(rightDown.ship.x == 65 && rightDown.ship.y == 105)
    assert(rightDown.ship.rightFrame)
    assert(releasingMovesShipTo(rightDown, Direction.Right, 65, 110))
    assert(!rightDown.ship.rightFrame)
    assert(releasingStopsShip(rightDown, Direction.Down))
    assert(!rightDown.padPressed() && !rightDown.ship.rightFrame)
    var leftUp = givenNormalShipAtCenterWithMeteorsLowered(77)
    leftUp.movement(Direction.Left, true)
    leftUp.movement(Direction.Up, true)
    leftUp.step()
    assert(leftUp.ship.x == 55 && leftUp.ship.y == 95)
    assert(!leftUp.ship.rightFrame)
    assert(releasingMovesShipTo(leftUp, Direction.Left, 55, 90))
    assert(!leftUp.ship.rightFrame)
    assert(releasingStopsShip(leftUp, Direction.Up))
    assert(!leftUp.padPressed() && !leftUp.ship.rightFrame)
    var leftDown = givenNormalShipAtCenterWithMeteorsLowered(77)
    leftDown.movement(Direction.Left, true)
    leftDown.movement(Direction.Down, true)
    leftDown.step()
    assert(leftDown.ship.x == 55 && leftDown.ship.y == 105)
    assert(!leftDown.ship.rightFrame)
    assert(releasingMovesShipTo(leftDown, Direction.Left, 55, 110))
    assert(!leftDown.ship.rightFrame)
    assert(releasingStopsShip(leftDown, Direction.Down))
    assert(!leftDown.padPressed() && !leftDown.ship.rightFrame)
}

