test "subchief seeded destinations movement and three shot slots use normal step clocks" {
    var g = Game()
    g.start(921)
    var chief = g.subchief
    assert(chief.x >= 220)
    assert(chief.x <= 419)
    assert(chief.y >= 30)
    assert(chief.y <= 193)
    assert(chief.endX >= 88)
    assert(chief.endX <= 147)
    assert(chief.endY >= 30)
    assert(chief.endY <= 193)
    var x = chief.x
    var y = chief.y
    var endX = chief.endX
    var endY = chief.endY
    g.start(921)
    assert(chief.x == x)
    assert(chief.y == y)
    assert(chief.endX == endX)
    assert(chief.endY == endY)
    g.stageSteps = 829
    g.ship.lives = 100
    g.step()
    assert(chief.x == x - 1)
    assert(chief.lifeTime == 0)
    assert(chief.normalSteps == 1)
    advanceSteps(g, 10)
    assert(!chief.shots[0].active)
    g.step()
    assert(chief.shots[0].active)
    assert(!chief.shots[1].active)
    assert(chief.shots[0].x == chief.x - 7 - 4)
    assert(chief.shots[0].y == chief.y + 13)
    advanceSteps(g, 12)
    assert(chief.shots[1].active)
    assert(!chief.shots[2].active)
    advanceSteps(g, 12)
    assert(chief.shots[2].active)
    assert(chief.lifeTime == 1)
    assert(chief.normalSteps == 0)
    var shotX = chief.shots[2].x
    var firstShotX = chief.shots[0].x
    advanceSteps(g, 12)
    assert(chief.shots[2].x == shotX - 48)
    assert(chief.shots.size == 3)
    assert(chief.shots[0].x == firstShotX - 48)
    chief.shots[0].active = false
    advanceSteps(g, 12)
    assert(chief.shots[0].active)
    assert(chief.shots[0].x == chief.x - 11)
    g.pause()
    var normalSteps = chief.normalSteps
    var shotPosition = chief.shots[0].x
    g.step()
    assert(chief.normalSteps == normalSteps)
    assert(chief.shots[0].x == shotPosition)
    g.start(921)
    assert(chief.phase == SubchiefPhase.Inactive)
    assert(chief.lifeTime == 0)
    assert(chief.normalSteps == 0)
    assert(noSubchiefShotActive(g))
}

test "subchief laser and body damage precede meteor weapons and restart is invulnerable" {
    var g = Game()
    prepareSubchief(g)
    var laser = g.weapons.lasers.shots[0]
    laser.fire(0, 100)
    laser.x = 86
    g.meteors[0].x = 122
    g.meteors[0].y = 100

    g.step()
    assert(g.subchief.lives == 29 && laser.impact && laser.x == 120 && laser.y == 100)
    assert(!g.meteors[0].collided && g.score == 0)
    g.step()
    assert(g.subchief.lives == 29 && !laser.active)

    prepareSubchief(g)
    g.ship.x = 100
    g.step()
    assert(g.ship.phase == ShipPhase.Explosion && g.subchief.lives == 29)
    g.step()
    assert(g.subchief.lives == 29 && g.ship.explosionSteps == 1)

    prepareSubchief(g)
    g.ship.x = 100
    g.ship.phase = ShipPhase.Restart
    g.step()
    assert(g.ship.phase == ShipPhase.Restart && g.subchief.lives == 30)
}

test "subchief blaster spends its one remaining resistance before meteor contacts" {
    var g = Game()
    prepareSubchief(g)
    g.weapons.blaster.fire(g.ship)
    g.weapons.blaster.x = 60
    g.weapons.blaster.lives = 1
    g.meteors[0].x = 125
    g.meteors[0].y = 100
    g.step()
    assert(g.subchief.lives == 29 && g.weapons.blaster.lives == 0)
    assert(g.weapons.blaster.active && !g.meteors[0].collided && g.score == 0)
    g.step()
    assert(g.subchief.lives == 29)
}

test "subchief blaster spends its two remaining resistance before meteor contacts" {
    var g = Game()
    prepareSubchief(g)
    g.weapons.blaster.fire(g.ship)
    g.weapons.blaster.x = 60
    g.weapons.blaster.lives = 2
    g.meteors[0].x = 125
    g.meteors[0].y = 100
    g.step()
    assert(g.subchief.lives == 28 && g.weapons.blaster.lives == 0)
    assert(g.weapons.blaster.active && !g.meteors[0].collided && g.score == 0)
    g.step()
    assert(g.subchief.lives == 28)
}

test "special subchief markers reapply in color order and expire after six steps" {
    var g = Game()
    prepareSubchief(g)
    givenEveryBeamActiveAt(g, 0, 100)

    g.step()
    assert(g.subchief.lives == 29)
    assert(g.weapons.beams[0].lives == 9)
    assert(g.weapons.beams[1].lives == 10)
    assert(g.weapons.beams[2].lives == 10)
    g.step()
    assert(g.subchief.lives == 27)
    assert(g.weapons.beams[0].lives == 8)
    assert(g.weapons.beams[1].lives == 9)
    g.step()
    assert(g.subchief.lives == 24)
    assert(g.weapons.beams[0].lives == 7)
    assert(g.weapons.beams[1].lives == 8)
    assert(g.weapons.beams[2].lives == 9)
    advanceSteps(g, 3)
    assert(g.subchief.lives == 24)
    g.step()
    assert(g.subchief.lives == 21)
    assert(g.weapons.beams[0].lives == 6)

    prepareSubchief(g)
    var beam = g.weapons.beams[0]
    beam.active = true
    beam.x = 0
    beam.y = 100
    beam.lives = 1
    g.step()
    assert(g.subchief.lives == 29)
    assert(beam.lives == 0)
    assert(beam.active)
    advanceSteps(g, 5)
    assert(beam.active)
    assert(g.subchief.lives == 29)
    g.step()
    assert(!beam.active)
    assert(beam.contactSteps == 0)
    assert(g.subchief.lives == 29)

    prepareSubchief(g)
    beam.active = true
    beam.x = 176
    beam.y = 100
    beam.contactSteps = 5
    g.step()
    assert(!beam.active)
    assert(beam.contactSteps == 0)
    assert(g.subchief.lives == 30)
}

test "fatal subchief contact with the ship rewards once at lifetime boundaries and leaves recurring items in place" {
    var g = Game()
    givenLastSubchiefLifeAtLifetime(g, 30)
    prepareFatalContact(g, 0)
    g.step()
    assert(g.subchief.phase == SubchiefPhase.Explosion && g.score == 600)
    assert(subchiefRewardLeavesItemsWeaponsAndLivesAlone(g))
    assert(subchiefRewardHoldsUntilTrackResumes(g, 600))
    givenLastSubchiefLifeAtLifetime(g, 31)
    prepareFatalContact(g, 0)
    g.step()
    assert(g.subchief.phase == SubchiefPhase.Explosion && g.score == 300)
    assert(subchiefRewardLeavesItemsWeaponsAndLivesAlone(g))
    assert(subchiefRewardHoldsUntilTrackResumes(g, 300))
    givenLastSubchiefLifeAtLifetime(g, 60)
    prepareFatalContact(g, 0)
    g.step()
    assert(g.subchief.phase == SubchiefPhase.Explosion && g.score == 300)
    assert(subchiefRewardLeavesItemsWeaponsAndLivesAlone(g))
    assert(subchiefRewardHoldsUntilTrackResumes(g, 300))
    givenLastSubchiefLifeAtLifetime(g, 61)
    prepareFatalContact(g, 0)
    g.step()
    assert(g.subchief.phase == SubchiefPhase.Explosion && g.score == 150)
    assert(subchiefRewardLeavesItemsWeaponsAndLivesAlone(g))
    assert(subchiefRewardHoldsUntilTrackResumes(g, 150))
}

