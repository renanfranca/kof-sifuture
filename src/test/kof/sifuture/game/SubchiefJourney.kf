test "new enemy shot cannot collide before its historical first update" {
    var g = Game()
    prepareAudit(g)
    g.ship.x = 40
    g.subchief.x = 101
    g.subchief.endX = 101
    g.subchief.normalSteps = 11
    g.step()
    println("newShot shipNormal=" + (g.ship.phase == ShipPhase.Normal) + " shotActive=" + g.subchief.shots[0].active)
    assert(g.ship.phase == ShipPhase.Normal && g.subchief.shots[0].active && g.subchief.shots[0].x == 90, "historical enemy collisions precede fire and projectile movement")
    g.step()
    assert(g.ship.phase == ShipPhase.Explosion && !g.subchief.shots[0].active)
}

test "existing enemy shot outside ship cannot hit until next historical step" {
    var g = Game()
    prepareAudit(g)
    g.subchief.shots[0].active = true
    g.subchief.shots[0].x = 51
    g.subchief.shots[0].y = 113
    g.step()
    println("movingShot shipNormal=" + (g.ship.phase == ShipPhase.Normal) + " shotX=" + g.subchief.shots[0].x)
    assert(g.ship.phase == ShipPhase.Normal && g.subchief.shots[0].active && g.subchief.shots[0].x == 47, "historical enemy collisions use the pre-movement shot position")
    g.step()
    assert(g.ship.phase == ShipPhase.Explosion && !g.subchief.shots[0].active)
}

test "nonfatal contacts still move fire and increment the lifetime clock at thirty and sixty" {
    var g = Game()
    for (var lifetime in listOf(30, 60)) {
        for (var weapon = 0; weapon < 4; weapon++) {
            prepareAudit(g)
            g.subchief.endX = 147
            g.subchief.endY = 110
            g.subchief.lifeTime = lifetime
            g.subchief.normalSteps = 35
            prepareFatalContact(g, weapon)

            g.step()

            assert(g.score == 0 && g.subchief.phase == SubchiefPhase.Normal && g.subchief.lives < 30)
            assert(g.subchief.lifeTime == lifetime + 1 && g.subchief.normalSteps == 0)
            assert(g.subchief.x == 121 && g.subchief.y == 101)
            assert(g.subchief.shots[0].active && g.subchief.shots[0].x == 110)
        }
    }
}

test "enemy contact frees first slot for one update without colliding with its replacement" {
    var g = Game()
    prepareAudit(g)
    g.ship.x = 40
    g.subchief.x = 101
    g.subchief.endX = 101
    g.subchief.normalSteps = 11
    for (var shot in g.subchief.shots) { shot.active = true; shot.y = 113 }
    g.subchief.shots[0].x = 40
    g.subchief.shots[1].x = 150
    g.subchief.shots[2].x = 160

    g.step()

    assert(g.ship.phase == ShipPhase.Explosion && g.ship.explosionSteps == 0)
    assert(g.subchief.shots[0].active && g.subchief.shots[0].x == 90)
    assert(g.subchief.shots[1].x == 146 && g.subchief.shots[2].x == 156)
    g.ship.phase = ShipPhase.Normal
    g.step()
    assert(g.ship.phase == ShipPhase.Explosion && !g.subchief.shots[0].active)
}
