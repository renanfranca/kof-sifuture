    g.subchief.lives = lives
    g.ship.x = 100
    g.weapons.lasers.shots[0].active = true
    g.weapons.lasers.shots[0].x = 86
    g.weapons.lasers.shots[0].y = 100
    g.weapons.blaster.active = true
    g.weapons.blaster.x = 60
    g.weapons.blaster.y = 100
    givenEveryBeamActiveAt(g, 0, 100)
}

givenSubchiefAuditBeforeContact(Game g, Int lives, Int lifetime) {
    prepareAudit(g)
    g.subchief.endX = 147
    g.subchief.endY = 110
    g.subchief.lives = lives
    g.subchief.lifeTime = lifetime
    g.subchief.normalSteps = 35
}

givenSubchiefAboutToFireWithFirstShotOnShip(Game g) {
    prepareAudit(g)
    g.ship.x = 40
    g.subchief.x = 101
    g.subchief.endX = 101
    g.subchief.normalSteps = 11
    for (var shot in g.subchief.shots) { shot.active = true; shot.y = 113 }
    g.subchief.shots[0].x = 40
    g.subchief.shots[1].x = 150
    g.subchief.shots[2].x = 160
}

givenEnemyShotAt(Game g, Int x) {
    var shot = g.subchief.shots[0]
    shot.active = true
    shot.x = x
    shot.y = 100
}
