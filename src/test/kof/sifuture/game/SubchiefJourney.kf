test "fatal subchief contact with the special rewards once at lifetime boundaries and leaves recurring items in place" {
    var g = Game()
    givenLastSubchiefLifeAtLifetime(g, 30)
    prepareFatalContact(g, 3)
    g.weapons.beams[1].contactSteps = 5
    g.step()
    assert(g.subchief.phase == SubchiefPhase.Explosion && g.score == 600)
    assert(subchiefRewardLeavesItemsWeaponsAndLivesAlone(g))
    assert(g.weapons.beams[0].lives == 9 && g.weapons.beams[1].lives == 9)
    assert(subchiefRewardHoldsUntilTrackResumes(g, 600))
    givenLastSubchiefLifeAtLifetime(g, 31)
    prepareFatalContact(g, 3)
    g.weapons.beams[1].contactSteps = 5
    g.step()
    assert(g.subchief.phase == SubchiefPhase.Explosion && g.score == 300)
    assert(subchiefRewardLeavesItemsWeaponsAndLivesAlone(g))
    assert(g.weapons.beams[0].lives == 9 && g.weapons.beams[1].lives == 9)
    assert(subchiefRewardHoldsUntilTrackResumes(g, 300))
    givenLastSubchiefLifeAtLifetime(g, 60)
    prepareFatalContact(g, 3)
    g.weapons.beams[1].contactSteps = 5
    g.step()
    assert(g.subchief.phase == SubchiefPhase.Explosion && g.score == 300)
    assert(subchiefRewardLeavesItemsWeaponsAndLivesAlone(g))
    assert(g.weapons.beams[0].lives == 9 && g.weapons.beams[1].lives == 9)
    assert(subchiefRewardHoldsUntilTrackResumes(g, 300))
    givenLastSubchiefLifeAtLifetime(g, 61)
    prepareFatalContact(g, 3)
    g.weapons.beams[1].contactSteps = 5
    g.step()
    assert(g.subchief.phase == SubchiefPhase.Explosion && g.score == 150)
    assert(subchiefRewardLeavesItemsWeaponsAndLivesAlone(g))
    assert(g.weapons.beams[0].lives == 9 && g.weapons.beams[1].lives == 9)
    assert(subchiefRewardHoldsUntilTrackResumes(g, 150))
}

test "enemy shot historical corner geometry explodes normal ship and ignores restart" {
    var g = Game()
    prepareSubchief(g)
    g.subchief.x = 400
    g.subchief.endX = 400
    givenEnemyShotAt(g, 24)
    var shot = g.subchief.shots[0]
    g.step()
    assert(g.ship.phase == ShipPhase.Explosion && !shot.active && g.subchief.lives == 30 && g.score == 0)
    prepareSubchief(g)
    g.ship.phase = ShipPhase.Restart
    givenEnemyShotAt(g, 24)
    g.step()
    assert(g.ship.phase == ShipPhase.Restart && shot.active && shot.x == 20)
    prepareSubchief(g)
    givenEnemyShotAt(g, -1)
    g.step()
    assert(g.ship.phase == ShipPhase.Normal && shot.active && shot.x == -5)
    shot.x = -28
    g.step()
    assert(!shot.active)
}

test "subchief explosion freezes track for thirty steps with historical displacement and pause" {
    var g = Game()
    givenFatalLaserOnSubchiefWithVerticalPairLeaving(g)
    g.step()
    assert(g.subchief.explosionSteps == 0)
    assert(g.subchief.explosionX == 120)
    g.step()
    assert(!g.meteors[6].active)
    assert(!g.meteors[7].active)
    g.step()
    assert(g.subchief.explosionSteps == 2)
    assert(g.subchief.explosionX == 120)
    assert(!g.meteors[6].active)
    g.step()
    assert(g.subchief.explosionSteps == 3)
    assert(g.subchief.explosionX == 119)
    g.pause()
    var shotX = g.subchief.shots[0].x
    advanceSteps(g, 12)
    assert(g.subchief.explosionSteps == 3)
    assert(g.subchief.explosionX == 119)
    assert(g.stagePosition() == 89)
    assert(g.subchief.shots[0].x == shotX)
    assert(g.subchief.lifeTime == 0)
    g.resume()
    assert(g.subchief.explosionSteps == 3)
    assert(g.subchief.explosionX == 119)
    advanceSteps(g, 3)
    assert(g.subchief.explosionSteps == 6)
    assert(g.subchief.explosionX == 116)
    advanceSteps(g, 3)
    assert(g.subchief.explosionSteps == 9)
    assert(g.subchief.explosionX == 113)
    advanceSteps(g, 3)
    assert(g.subchief.explosionSteps == 12)
    assert(g.subchief.explosionX == 110)
    advanceSteps(g, 3)
    assert(g.subchief.explosionSteps == 15)
    assert(g.subchief.explosionX == 104)
    advanceSteps(g, 3)
    assert(g.subchief.explosionSteps == 18)
    assert(g.subchief.explosionX == 98)
    advanceSteps(g, 3)
    assert(g.subchief.explosionSteps == 21)
    assert(g.subchief.explosionX == 89)
    advanceSteps(g, 3)
    assert(g.subchief.explosionSteps == 24)
    assert(g.subchief.explosionX == 80)
    advanceSteps(g, 3)
    assert(g.subchief.explosionSteps == 27)
    assert(g.subchief.explosionX == 65)
    advanceSteps(g, 3)
    assert(g.subchief.phase == SubchiefPhase.Inactive)
    assert(g.stagePosition() == 89)
    assert(g.meteors[6].active)
    assert(g.meteors[7].active)
    advanceSteps(g, 10)
    assert(g.stagePosition() == 90)
    assert(g.score == 600)
}

test "defeat during subchief encounter animates without contacts rewards or life changes and restart clears it" {
    var g = Game()
    givenShipLosingLastLifeDuringSubchief(g)
    g.step()
    assert(g.screen == Screen.Result)
    assert(g.ship.lives == 0)
    assert(g.score == 17)
    var x = g.subchief.x
    var steps = g.steps
    advanceSteps(g, 20)
    assert(g.subchief.x != x)
    assert(g.subchief.shots[0].active)
    assert(g.subchief.lives == 1)
    assert(g.score == 17)
    assert(g.ship.lives == 0)
    assert(g.stagePosition() == 89)
    assert(g.steps == steps)
    assert(g.weapons.level == 3)
    assert(g.weapons.charges == 0)
    assert(g.displayedScore == 17)

    g.subchief.damage(1)
    var explosionX = g.subchief.explosionX
    advanceSteps(g, 6)
    assert(g.subchief.explosionSteps == 6)
    assert(g.subchief.explosionX < explosionX)
    assert(g.score == 17)
    assert(g.ship.lives == 0)
    assert(g.stagePosition() == 89)
    g.start(922)
    assert(g.subchief.phase == SubchiefPhase.Inactive)
    assert(g.subchief.lives == 30)
    assert(g.subchief.lifeTime == 0)
    assert(g.subchief.explosionSteps == 0)
    assert(g.stagePosition() == 5)
    assert(g.steps == 0)
    assert(noSubchiefShotActive(g))
    assert(g.score == 0)
    assert(g.ship.lives == 3)
    assert(g.weapons.level == 0)
}

test "subchief corner geometry retains inclusive edges and rejects mere rectangle overlap" {
    var g = Game()
    givenLaserAtSubchiefHeight(g, 84)
    g.step()
    assert(g.subchief.lives == 30)
    givenLaserAtSubchiefHeight(g, 85)
    g.step()
    assert(g.subchief.lives == 29)
    givenLaserAtSubchiefHeight(g, 113)
    g.step()
    assert(g.subchief.lives == 29)
    givenLaserAtSubchiefHeight(g, 114)
    g.step()
    assert(g.subchief.lives == 30)
    prepareSubchief(g)
    g.weapons.blaster.fire(g.ship)
    g.weapons.blaster.x = 60
    g.weapons.blaster.y = 102
    g.step()
    assert(g.subchief.lives == 30 && g.weapons.blaster.lives == 2)
    prepareSubchief(g)
    g.ship.x = 100
    g.subchief.y = 80
    g.subchief.endY = 80
    g.step()
    assert(g.ship.phase == ShipPhase.Explosion && g.subchief.lives == 29)
    prepareSubchief(g)
    g.ship.x = 100
    g.subchief.x = 80
    g.subchief.endX = 80
    g.step()
    assert(g.ship.phase == ShipPhase.Explosion && g.subchief.lives == 29)
}

test "marked exhausted special beam still reapplies when next color enters contact" {
    var g = Game()
    prepareSubchief(g)
    givenEveryBeamActiveAt(g, 0, 100)
    g.weapons.beams[0].lives = 1
    g.step()
    assert(g.subchief.lives == 29)
    assert(g.weapons.beams[0].lives == 0)
    g.step()
    assert(g.subchief.lives == 27)
    assert(g.weapons.beams[0].lives == -1)
    assert(g.weapons.beams[1].lives == 9)
    g.step()
    assert(g.subchief.lives == 24)
    assert(g.weapons.beams[0].lives == -2)
    assert(g.weapons.beams[2].lives == 9)
    assert(g.weapons.beams[0].deathSteps == 0, "each nonpositive hit restarts the historical death animation")
    advanceSteps(g, 4)
    assert(g.weapons.beams[0].active)
    assert(g.weapons.beams[0].contactSteps == 6)
    assert(g.weapons.beams[0].deathSteps == 4)
    g.step()
    assert(g.weapons.beams[0].lives == -3)
    assert(g.weapons.beams[0].deathSteps == 0)
    g.step()
    assert(g.weapons.beams[0].lives == -4)
    assert(g.weapons.beams[0].deathSteps == 0)
    g.subchief.phase = SubchiefPhase.Explosion
    advanceSteps(g, 5)
    assert(g.weapons.beams[0].active)
    assert(g.weapons.beams[0].deathSteps == 5)
    assert(g.weapons.beams[0].contactSteps == 6)
    g.step()
    assert(!g.weapons.beams[0].active)
    assert(g.weapons.beams[0].contactSteps == 0)
}

test "subchief moves one unit on both axes and arrival selects reproducible new destination" {
    var g = Game()
    prepareSubchief(g)
    g.subchief.x = 100
    g.subchief.y = 80
    g.subchief.endX = 101
    g.subchief.endY = 81
    rng.seed(71)
    g.step()
    assert(g.subchief.x == 101 && g.subchief.y == 81)
    var destinationX = g.subchief.endX
    var destinationY = g.subchief.endY
    assert(destinationX >= 88 && destinationX <= 147 && destinationY >= 30 && destinationY <= 193)
    prepareSubchief(g)
    g.subchief.x = 100
    g.subchief.y = 80
    g.subchief.endX = 101
    g.subchief.endY = 81
    rng.seed(71)
    g.step()
    assert(g.subchief.endX == destinationX && g.subchief.endY == destinationY)
}

