test "enemy contact frees first slot for one update without colliding with its replacement" {
    var g = Game()
    givenSubchiefAboutToFireWithFirstShotOnShip(g)

    g.step()

    assert(g.ship.phase == ShipPhase.Explosion && g.ship.explosionSteps == 0)
    assert(g.subchief.shots[0].active && g.subchief.shots[0].x == 90)
    assert(g.subchief.shots[1].x == 146 && g.subchief.shots[2].x == 156)
    g.ship.phase = ShipPhase.Normal
    g.step()
    assert(g.ship.phase == ShipPhase.Explosion && !g.subchief.shots[0].active)
}

givenLastSubchiefLifeAtLifetime(Game g, Int lifetime) {
    prepareSubchief(g)
    g.subchief.lifeTime = lifetime
    g.subchief.lives = 1
}

Bool subchiefRewardLeavesItemsWeaponsAndLivesAlone(Game g) {
    var items = g.items.size == 2 && g.items[0].x == 9999 && g.items[1].x == 9999
    return items && g.weapons.level == 0 && g.weapons.charges == 0 && g.ship.lives == 3
}

Bool subchiefRewardHoldsUntilTrackResumes(Game g, Int reward) {
    advanceSteps(g, 29)
    var exploding = g.score == reward && g.stagePosition() == 89 && g.subchief.phase == SubchiefPhase.Explosion
    g.step()
    var gone = g.score == reward && g.subchief.phase == SubchiefPhase.Inactive
    advanceSteps(g, 20)
    var resumed = g.stagePosition() == 91 && g.subchief.phase == SubchiefPhase.Inactive && g.score == reward
    return exploding && gone && resumed
}

givenFatalLaserOnSubchiefWithVerticalPairLeaving(Game g) {
    prepareSubchief(g)
    g.subchief.lives = 1
    g.weapons.lasers.shots[0].fire(0, 100)
    g.weapons.lasers.shots[0].x = 86
    g.meteors[6].active = true
    g.meteors[6].x = 10
    g.meteors[6].y = 219
    g.meteors[7].active = true
    g.meteors[7].x = 10
    g.meteors[7].y = 219
}

givenShipLosingLastLifeDuringSubchief(Game g) {
    prepareSubchief(g)
    g.subchief.lives = 1
    g.ship.lives = 1
    g.ship.explode()
    g.ship.explosionSteps = 29
    g.weapons.level = 3
    g.weapons.charges = 1
    g.score = 17
}

givenLaserAtSubchiefHeight(Game g, Int x) {
