test "fatal contact at historical lifetime thirty keeps six hundred reward before movement or fire" {
    var g = Game()
    givenSubchiefAuditBeforeContact(g, 1, 30)
    prepareFatalContact(g, 0)
    g.step()
    assert(g.score == 600)
    assert(g.subchief.lifeTime == 30)
    assert(g.subchief.normalSteps == 35)
    assert(g.subchief.x == 120)
