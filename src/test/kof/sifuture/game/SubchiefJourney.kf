    prepareFatalContact(g, 2)
    g.step()
    assert(g.score == 0)
    assert(g.subchief.phase == SubchiefPhase.Normal)
    assert(g.subchief.lives < 30)
    assert(g.subchief.lifeTime == 31)
    assert(g.subchief.normalSteps == 0)
    assert(g.subchief.x == 121)
    assert(g.subchief.y == 101)
    assert(g.subchief.shots[0].active)
    assert(g.subchief.shots[0].x == 110)
    givenSubchiefAuditBeforeContact(g, 30, 30)
    prepareFatalContact(g, 3)
    g.step()
    assert(g.score == 0)
    assert(g.subchief.phase == SubchiefPhase.Normal)
    assert(g.subchief.lives < 30)
    assert(g.subchief.lifeTime == 31)
    assert(g.subchief.normalSteps == 0)
    assert(g.subchief.x == 121)
    assert(g.subchief.y == 101)
    assert(g.subchief.shots[0].active)
    assert(g.subchief.shots[0].x == 110)
}

