test "finishing with right held restores normal ship while score counts and position freezes" {
    var g = Game()
    g.start(908)
    g.ship.phase = ShipPhase.Normal
    g.ship.x = 40
    g.ship.y = 150
    for (var m in g.meteors) { m.x = 10000; m.y = -100 }
    g.score = 17
    g.steps = 1708
    g.stageSteps = 1708
    g.keyboard(Direction.Right, true)
    g.step()
    assert(g.ship.rightFrame && g.ship.x == 45)

    g.step()
    assert(g.screen == Screen.Result && !g.ship.rightFrame)
    assert(!g.ship.right && g.ship.x == 50 && g.ship.y == 150)
    g.keyboard(Direction.Right, false)
    for (var i = 0; i < 4; i++) { g.step() }
    assert(!g.ship.rightFrame && g.ship.x == 50 && g.ship.y == 150)
    assert(g.displayedScore == 17 && g.score == 17 && g.steps == 1710)
}

test "all result boundaries select a message" {
    var g = Game()
    g.score = 1499
    assert(g.resultIndex() == 0)
    g.score = 1500
    assert(g.resultIndex() == 1)
    g.score = 2199
    assert(g.resultIndex() == 1)
    g.score = 2200
    assert(g.resultIndex() == 2)
    g.score = 3299
    assert(g.resultIndex() == 2)
    g.score = 3300
    assert(g.resultIndex() == 3)
}

test "result counts by five to exact total then confirms in two stages" {
    var g = Game()
    g.start(905)
    g.score = 17
    g.ship.lives = 0
    g.step()
    assert(g.screen == Screen.Result && g.displayedScore == 0 && !g.countComplete())
    g.step()
    assert(g.displayedScore == 5 && g.score == 17)
    g.step()
    g.step()
    assert(g.displayedScore == 15 && !g.countComplete())
    g.step()
    assert(g.displayedScore == 17 && g.countComplete())
    g.step()
    assert(g.displayedScore == 17 && g.screen == Screen.Result)
    g.confirm()
    assert(g.screen == Screen.Menu)
    g.start(905)
    g.score = 17
    g.ship.lives = 0
    g.step()
    g.confirm()
    assert(g.screen == Screen.Result && g.displayedScore == 17 && g.countComplete())
    g.confirm()
    assert(g.screen == Screen.Menu)
    g.start(905)
    g.ship.lives = 0
    g.step()
    assert(g.score == 0 && g.displayedScore == 0 && g.countComplete())
    g.confirm()
    assert(g.screen == Screen.Menu)
}

test "result keeps scenery and pending effects moving with frozen gameplay" {
    var g = Game()
    g.start(906)
    g.steps = 1709
    g.stageSteps = 1709
    g.ship.explode()
    g.ship.explosionSteps = 28
    g.ship.lives = 4
    g.weapons.level = 3
    g.weapons.charges = 2
    g.score = 37
    g.items[1].x = g.ship.x + 10
    g.items[1].y = g.ship.y - 16
    g.meteors[0].x = 80
    g.meteors[0].y = 100
    g.meteors[0].collide()
    g.step()
    assert(g.screen == Screen.Result && g.ship.explosionSteps == 29)
    var background = g.background.offset
    var meteorX = g.meteors[0].x
    var itemX = g.items[1].x
    g.keyboard(Direction.Right, true)
    g.movement(Direction.Right, true)
    assert(!g.trySpecial())
    g.step()
    assert(g.background.offset != background && g.meteors[0].x == meteorX - 1)
    assert(g.items[1].x == itemX - 1 && !g.items[1].collected)
    assert(g.ship.phase == ShipPhase.Hidden && g.ship.explosionSteps == 30)
    for (var i = 0; i < 15; i++) { g.step() }
    assert(g.weapons.lasers.shots[0].active)
    assert(g.ship.lives == 4 && g.ship.x == 0 && g.steps == 1710 && g.stagePosition() == 176)
    assert(g.score == 37 && g.displayedScore == 37 && g.weapons.level == 3 && g.weapons.charges == 2)
    assert(g.screen == Screen.Result && g.ship.explosionSteps == 30)
}

test "defeat ends explosion without new projectiles or another loss at every weapon level" {
    for (var level = 0; level < 4; level++) {
        var g = Game()
        g.start(910)
        g.ship.lives = 1
        g.ship.explode()
        g.ship.explosionSteps = 29
        g.weapons.level = level
        g.weapons.charges = 1
        g.weapons.fireSteps = 12
        g.weapons.laserAttempts = 6
        g.score = 5

        g.step()
        assert(g.screen == Screen.Result && g.ship.phase == ShipPhase.Hidden && g.ship.explosionSteps == 30)
        assert(g.ship.lives == 0 && g.weapons.charges == 0 && g.weapons.level == level)
        var steps = g.steps
        for (var i = 0; i < 100; i++) {
            for (var shot in g.weapons.lasers.shots) { assert(!shot.active) }
            assert(!g.weapons.blaster.active)
            for (var beam in g.weapons.beams) { assert(!beam.active) }
            g.step()
            for (var shot in g.weapons.lasers.shots) { assert(!shot.active) }
            assert(!g.weapons.blaster.active)
            for (var beam in g.weapons.beams) { assert(!beam.active) }
        }
        assert(g.ship.lives == 0 && g.ship.explosionSteps == 30 && g.steps == steps && g.score == 5)
        assert(g.weapons.level == level && g.displayedScore == 5 && g.screen == Screen.Result)
    }
}

test "projectiles launched before defeat keep moving until all finish and stay absent" {
    var g = Game()
    g.start(911)
    g.ship.phase = ShipPhase.Normal
    g.weapons.level = 3
    g.weapons.charges = 2
    g.weapons.fireSteps = 12
    g.weapons.laserAttempts = 6
    for (var shot in g.weapons.lasers.shots) { shot.fire(g.ship.x, g.ship.y) }
    g.weapons.blaster.fire(g.ship)
    assert(g.trySpecial())
    g.ship.lives = 1
    g.ship.explode()
    g.ship.explosionSteps = 29
    var laserX = g.weapons.lasers.shots[0].x
    var blasterX = g.weapons.blaster.x
    var upperX = g.weapons.beams[0].x
    var middleX = g.weapons.beams[1].x
    var lowerX = g.weapons.beams[2].x

    g.step()
    assert(g.screen == Screen.Result && g.ship.lives == 0)
    for (var shot in g.weapons.lasers.shots) { assert(shot.active && shot.x == laserX) }
    assert(g.weapons.blaster.active && g.weapons.blaster.x == blasterX)
    for (var beam in g.weapons.beams) { assert(beam.active) }
    assert(g.weapons.beams[0].x == upperX && g.weapons.beams[1].x == middleX && g.weapons.beams[2].x == lowerX)
    g.step()
    for (var shot in g.weapons.lasers.shots) { assert(shot.active && shot.x == laserX + 5) }
    assert(g.weapons.blaster.active && g.weapons.blaster.x == blasterX + 5)
    assert(g.weapons.beams[0].x == upperX + 5 && g.weapons.beams[1].x == middleX + 6 && g.weapons.beams[2].x == lowerX + 5)
    for (var i = 1; i < 170; i++) { g.step() }
    for (var i = 0; i < 52; i++) {
        for (var shot in g.weapons.lasers.shots) { assert(!shot.active) }
        assert(!g.weapons.blaster.active)
        for (var beam in g.weapons.beams) { assert(!beam.active) }
        g.step()
        for (var shot in g.weapons.lasers.shots) { assert(!shot.active) }
        assert(!g.weapons.blaster.active)
        for (var beam in g.weapons.beams) { assert(!beam.active) }
    }
}

test "laser blaster and special impacts finish after one four and six result steps" {
    var g = Game()
    g.start(912)
    g.weapons.level = 3
    g.weapons.charges = 1
    g.weapons.fireSteps = 12
    var shot = g.weapons.lasers.shots[0]
    shot.fire(g.ship.x, g.ship.y)
    shot.impactAt(g.meteors[0])
    var blaster = g.weapons.blaster
    blaster.fire(g.ship)
    blaster.hit()
    blaster.hit()
    var beam = g.weapons.beams[1]
    beam.fire(g.ship)
    for (var i = 0; i < 10; i++) { beam.hit() }
    g.ship.lives = 1
    g.ship.explode()
    g.ship.explosionSteps = 29

    g.step()
    assert(g.screen == Screen.Result && g.ship.lives == 0)
    assert(shot.active && shot.impact)
    assert(blaster.active && blaster.lives == 0 && blaster.impactSteps == 0)
    assert(beam.active && beam.lives == 0 && beam.deathSteps == 0 && beam.spriteFrame() == 1)
    for (var step = 1; step <= 6; step++) {
        g.step()
        assert(!shot.active && !shot.impact)
        if (step < 4) { assert(blaster.active && blaster.impactSteps == step) }
        else { assert(!blaster.active) }
        if (step < 6) {
            assert(beam.active && beam.deathSteps == step)
            if (step < 3) { assert(beam.spriteFrame() == 1) }
            else { assert(beam.spriteFrame() == 2) }
        } else { assert(!beam.active) }
    }
}
