test "finishing with right held restores normal ship while score counts and position freezes" {
    var g = givenNormalShipTwoStepsBeforeTheEnd(908)
    g.keyboard(Direction.Right, true)
    g.step()
    assert(g.ship.rightFrame && g.ship.x == 45)

    g.step()
    assert(g.screen == Screen.Result && !g.ship.rightFrame)
    assert(!g.ship.right && g.ship.x == 50 && g.ship.y == 150)
    g.keyboard(Direction.Right, false)
    advanceSteps(g, 4)
    assert(!g.ship.rightFrame && g.ship.x == 50 && g.ship.y == 150)
    assert(g.displayedScore == 17 && g.score == 17 && g.steps == 1710)
}

test "all result boundaries select a message" {
    var g = Game()
    g.score = 1499
    assert(g.resultIndex() == 0)
    g.score = 1500
    assert(g.resultIndex() == 1)
    g.score = 2199
    assert(g.resultIndex() == 1)
    g.score = 2200
    assert(g.resultIndex() == 2)
    g.score = 3299
    assert(g.resultIndex() == 2)
    g.score = 3300
    assert(g.resultIndex() == 3)
}

test "result counts by five to exact total then confirms in two stages" {
    var g = Game()
    g.start(905)
    g.score = 17
    g.ship.lives = 0
    g.step()
    assert(g.screen == Screen.Result)
    assert(g.displayedScore == 0)
    assert(!g.countComplete())
    g.step()
    assert(g.displayedScore == 5)
    assert(g.score == 17)
    g.step()
    g.step()
    assert(g.displayedScore == 15)
    assert(!g.countComplete())
    g.step()
    assert(g.displayedScore == 17)
    assert(g.countComplete())
    g.step()
    assert(g.displayedScore == 17)
    assert(g.screen == Screen.Result)
    g.confirm()
    assert(g.screen == Screen.Menu)
    g.start(905)
    g.score = 17
    g.ship.lives = 0
    g.step()
    g.confirm()
    assert(g.screen == Screen.Result)
    assert(g.displayedScore == 17)
    assert(g.countComplete())
    g.confirm()
    assert(g.screen == Screen.Menu)
    g.start(905)
    g.ship.lives = 0
    g.step()
    assert(g.score == 0)
    assert(g.displayedScore == 0)
    assert(g.countComplete())
    g.confirm()
    assert(g.screen == Screen.Menu)
}

test "result keeps scenery and pending effects moving with frozen gameplay" {
    var g = givenEvolvedShipExplodingOneStepBeforeTheEnd(906)
    g.step()
    assert(g.screen == Screen.Result)
    assert(g.ship.explosionSteps == 29)
    var background = g.background.offset
    var meteorX = g.meteors[0].x
    var itemX = g.items[1].x
    g.keyboard(Direction.Right, true)
    g.movement(Direction.Right, true)
    assert(!g.trySpecial())
    g.step()
    assert(g.background.offset != background)
    assert(g.meteors[0].x == meteorX - 1)
    assert(g.items[1].x == itemX - 1)
    assert(!g.items[1].collected)
    assert(g.ship.phase == ShipPhase.Hidden)
    assert(g.ship.explosionSteps == 30)
    advanceSteps(g, 15)
    assert(g.weapons.lasers.shots[0].active)
    assert(g.ship.lives == 4)
    assert(g.ship.x == 0)
    assert(g.steps == 1710)
    assert(g.stagePosition() == 176)
    assert(g.score == 37)
    assert(g.displayedScore == 37)
    assert(g.weapons.level == 3)
    assert(g.weapons.charges == 2)
    assert(g.screen == Screen.Result)
    assert(g.ship.explosionSteps == 30)
}

test "defeat at weapon level 0 ends explosion without new projectiles or another loss" {
    var g = givenLastLifeExplodingWithWeaponsReady(910, 0)
    g.step()
    assert(g.screen == Screen.Result)
    assert(g.ship.phase == ShipPhase.Hidden)
    assert(g.ship.explosionSteps == 30)
    assert(g.ship.lives == 0)
    assert(g.weapons.charges == 0)
    assert(g.weapons.level == 0)
    var steps = g.steps
    assert(noProjectileAppearsDuring(g, 100))
    assert(g.ship.lives == 0)
    assert(g.ship.explosionSteps == 30)
    assert(g.steps == steps)
    assert(g.score == 5)
    assert(g.weapons.level == 0)
    assert(g.displayedScore == 5)
    assert(g.screen == Screen.Result)
}

