test "stage moves on each tenth active step including restart and pause" {
    var g = Game()
    g.start(901)
    assert(g.stagePosition() == 5)
    advanceSteps(g, 9)
    assert(g.stagePosition() == 5)
    g.pause()
    advanceSteps(g, 20)
    assert(g.stagePosition() == 5 && g.steps == 9)
    g.resume()
    g.step()
    assert(g.stagePosition() == 6 && g.ship.phase == ShipPhase.Restart)
    g.ship.explode()
    advanceSteps(g, 10)
    assert(g.stagePosition() == 7 && g.ship.phase == ShipPhase.Explosion)
    g.start(901)
    assert(g.stagePosition() == 5 && g.steps == 0)
}

test "full stage completes both combat explosions and resumed track without second encounters" {
    var g = Game()
    g.start(902)
    g.ship.lives = 1000
    advanceSteps(g, 1710)
    assert(g.screen == Screen.Play && g.stagePosition() == 89)
    advanceWhilePlaying(g, 30000)
    assert(g.screen == Screen.Result && g.stagePosition() == 176 && g.steps > 1710)
    assert(g.subchief.phase == SubchiefPhase.Inactive)
    var score = g.score
    var lives = g.ship.lives
    var steps = g.steps
    advanceSteps(g, 50)
    assert(g.steps == steps && g.score == score && g.ship.lives == lives)
}

test "vertical pair unlocks above position thirty and falls one unit per step" {
    var g = Game()
    g.start(903)
    assert(g.meteors.size == 8)
    assert(g.meteors[0].motion == MeteorMotion.Horizontal && g.meteors[5].motion == MeteorMotion.Horizontal)
    assert(g.meteors[6].motion == MeteorMotion.Vertical)
    assert(!g.meteors[6].active && !g.meteors[7].active)
    g.steps = 258
    g.stageSteps = 258
    g.step()
    assert(g.stagePosition() == 30 && !g.meteors[6].active && !g.meteors[7].active)
    var x = g.meteors[6].x
    var y = g.meteors[6].y
    g.step()
    assert(g.stagePosition() == 31 && g.meteors[6].active && g.meteors[7].active)
    assert(g.meteors[6].x == x && g.meteors[6].y == y + 1)
    g.pause()
    g.step()
    assert(g.meteors[6].y == y + 1)
    g.resume()
    g.step()
    assert(g.meteors[6].y == y + 2)
    g.start(903)
    assert(g.meteors[6].x == x && g.meteors[6].y == y)
    assert(!g.meteors[6].active)
    assert(Meteor().motion == MeteorMotion.Horizontal)
}

test "vertical impact has three moving frames and pair relaunch waits for both inactive" {
    var g = givenVerticalPairInPlay(904)
    var first = g.meteors[6]
    var second = g.meteors[7]
    first.x = 80
    first.y = 50
    second.x = 120
    second.y = -100
    first.collide()
    assert(first.impactFrame() == 0)
    g.step()
    assert(first.active && first.y == 51 && first.impactFrame() == 1)
    g.step()
    assert(first.active && first.y == 52 && first.impactFrame() == 2)
    g.step()
    assert(!first.active && second.active)
    var waitingY = first.y
    g.step()
    assert(!first.active && first.y == waitingY)
    second.y = 220
    g.step()
    assert(!first.active && !second.active)
    g.step()
    assert(first.active && second.active)
    assert(first.y == waitingY + 1)
    assert(second.x >= 0 && second.x < 176)
    assert(second.y <= 1)
}

test "vertical contact with the ship explodes the ship before any weapon and rewards once" {
    var g = givenVerticalMeteorFacingArmedShip()
    assert(g.trySpecial())
    g.weapons.beams[1].x = 0
    g.step()
    assert(g.score == 5 && g.meteors[6].collided)
    assert(g.ship.phase == ShipPhase.Explosion && !g.weapons.lasers.shots[0].impact)
    advanceSteps(g, 3)
    assert(g.score == 5 && !g.meteors[6].active)
}

test "vertical contact away from the ship hits the laser before blaster and special and rewards once" {
    var g = givenVerticalMeteorFacingArmedShip()
    assert(g.trySpecial())
    g.weapons.beams[1].x = 0
    g.ship.y = 200
    g.step()
    assert(g.score == 5 && g.meteors[6].collided)
    assert(g.weapons.lasers.shots[0].impact && g.weapons.blaster.lives == 2)
    advanceSteps(g, 3)
    assert(g.score == 5 && !g.meteors[6].active)
}

test "vertical contact without ship or laser hits the blaster before special and rewards once" {
    var g = givenVerticalMeteorFacingArmedShip()
    assert(g.trySpecial())
    g.weapons.beams[1].x = 0
    g.ship.y = 200
    g.weapons.lasers.shots[0].active = false
    g.step()
    assert(g.score == 5 && g.meteors[6].collided)
    assert(g.weapons.blaster.lives == 1 && g.weapons.beams[1].lives == 10)
    advanceSteps(g, 3)
    assert(g.score == 5 && !g.meteors[6].active)
}

test "vertical contact with only the special hits the beam and rewards once" {
    var g = givenVerticalMeteorFacingArmedShip()
    assert(g.trySpecial())
    g.weapons.beams[1].x = 0
    g.ship.y = 200
    g.weapons.lasers.shots[0].active = false
    g.weapons.blaster.active = false
    g.step()
    assert(g.score == 5 && g.meteors[6].collided)
    assert(g.weapons.beams[1].lives == 9)
    advanceSteps(g, 3)
    assert(g.score == 5 && !g.meteors[6].active)
}

test "same seed replays entire stage including both bosses vertical relaunch and result" {
    var g = Game()
    g.start(909)
    g.ship.lives = 1000
    advanceWhilePlaying(g, 30000)
    var steps = g.steps
    assert(g.screen == Screen.Result && g.stagePosition() == 176)
    var positions = meteorPositions(g)
    var itemX = g.items[0].x
    var score = g.score
    var lives = g.ship.lives
    g.start(909)
    g.ship.lives = 1000
    advanceSteps(g, steps)
    assert(g.screen == Screen.Result && g.displayedScore == 0 && g.steps == steps)
    assert(meteorPositions(g) == positions)
    assert(g.items[0].x == itemX && g.score == score && g.ship.lives == lives)
}

test "midpoint enters once and freezes track while match and scenery continue" {
    var g = Game()
    g.start(920)
    g.ship.lives = 100
    advanceSteps(g, 829)
    assert(g.stagePosition() == 87 && g.subchief.phase == SubchiefPhase.Inactive)

    g.step()
    assert(g.stagePosition() == 89 && g.subchief.phase == SubchiefPhase.Normal)
    var background = g.background.offset
    var itemX = g.items[0].x
    advanceSteps(g, 10)
    assert(g.stagePosition() == 89 && g.steps == 840)
    assert(g.background.offset != background && g.items[0].x == itemX - 10)
    g.pause()
    g.step()
    assert(g.steps == 840 && g.stagePosition() == 89)
}

Game givenVerticalMeteorFacingArmedShip() {
    var g = Game()
    g.start(908)
    g.steps = 260
    g.stageSteps = 260
    g.ship.phase = ShipPhase.Normal
    for (var m in g.meteors) { m.x = 10000; m.y = -100 }
    g.weapons.lasers.shots[0].fire(0, 100)
    g.weapons.blaster.fire(g.ship)
    for (var i = 0; i < 4; i++) { g.weapons.evolve() }
    g.meteors[6].active = true
    g.meteors[6].x = 36
    g.meteors[6].y = 107
    return g
}

String meteorPositions(Game g) {
    var positions = ""
    for (var m in g.meteors) { positions = positions + m.x + "," + m.y + ";" }
    return positions
}
