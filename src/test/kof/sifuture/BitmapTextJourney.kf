package sifuture

import sifuture.BitmapFonts

test "bitmap measurement keeps complete credits within their native 130 pixel budget" {
    var credits = BitmapFonts.credits()
    assert(credits.measure("") == 0)
    assert(credits.measure("Copyright (c) 2006-2007") == 82)
    assert(credits.measure("Renan Meneses de Andrade Franca") == 123)
    assert(credits.measure("contact:") == 26)
    assert(credits.measure("renan.andradefranca@gmail.com") == 114)
    assert(credits.measure("Inc. All rights reserved.") == 80)
    assert(credits.measure("@.") == 10)
}

test "bitmap menu measurement follows proportional character advances" {
    var menu = BitmapFonts.menu()
    assert(menu.measure("Novo Jogo") == 63)
    assert(menu.measure("Controles") == 58)
    assert(menu.measure("Continuar") == 63)
    assert(menu.measure("Reiniciar") == 55)
    assert(menu.measure("Menu principal") == 94)
    assert(menu.measure("☃") == menu.measure("?"))
}
